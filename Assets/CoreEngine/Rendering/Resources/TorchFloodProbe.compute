// Task 158: the GPU == oracle probe. Samples TorchFlood.hlsl's FloodLevels at a
// list of voxels (the air cells in front of chosen pixels' hit faces) so the
// capture can compare them with TorchFloodPool.SampleLevels and the oracle.
#pragma kernel CSFloodProbe
#pragma kernel CSFloodScatter

#include "../TorchFlood.hlsl"

StructuredBuffer<int4> _ProbeIn;
RWStructuredBuffer<float4> _ProbeOut;
int _ProbeCount;

[numthreads(64, 1, 1)]
void CSFloodProbe(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _ProbeCount) return;
    int3 v = _ProbeIn[id.x].xyz;
    _ProbeOut[id.x] = float4(FloodLevels(v), dot(FloodLight(v, int3(0, 0, 0)), float3(0.2126, 0.7152, 0.0722)));
}

// Task 242: the scatter upload (TorchFloodPool.UploadScatter). One section of the staging buffer at _ScatBase holds
// _ScatN unit indices, then their _ScatN * 8 words; thread t writes word t & 7 of unit t >> 3 into _ScatDst (the
// flood tables or data buffer). Recorded in the same CommandBuffer as the staging write, so it runs after it.
// C# twin: TorchFloodPool.ScatterTwin.
StructuredBuffer<uint> _ScatSrc;
RWStructuredBuffer<uint> _ScatDst;
int _ScatBase;
int _ScatN;

[numthreads(64, 1, 1)]
void CSFloodScatter(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x >> 3;
    if (i >= (uint)_ScatN) return;
    uint b = (uint)_ScatBase;
    _ScatDst[(_ScatSrc[b + i] << 3) + (id.x & 7)] = _ScatSrc[b + (uint)_ScatN + id.x];
}

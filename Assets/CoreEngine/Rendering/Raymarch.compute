// <<< TG2 PALETTE

float3 MaterialAlbedo(uint mat)
{
    // The TerrainGen world's block (MaterialPalette's TG2 table, palette D).
    if (mat >= 128u && mat < 224u) return kTg2Palette[mat - 128u];
    if (mat == 2u)  return float3(0.440, 0.425, 0.400);  // Stone
    if (mat == 3u)  return float3(0.365, 0.470, 0.255);  // Grass
    if (mat == 4u)  return float3(0.735, 0.660, 0.495);  // Sand
    if (mat == 5u)  return float3(0.355, 0.410, 0.330);  // MossyStone
    if (mat == 6u)  return float3(0.150, 0.330, 0.420);  // Water
    if (mat == 7u)  return float3(0.715, 0.735, 0.760);  // Snow
    if (mat == 8u)  return float3(0.520, 0.415, 0.295);  // Sandstone (earth role)
    if (mat == 9u)  return float3(0.275, 0.410, 0.235);  // JungleGrass
    if (mat == 10u) return float3(0.255, 0.260, 0.285);  // Deepstone
    if (mat == 11u) return float3(0.720, 0.215, 0.070);  // Lava
    if (mat == 12u) return float3(0.680, 0.480, 0.130);  // Honey
    if (mat == 13u) return float3(0.095, 0.085, 0.125);  // Obsidian
    if (mat == 14u) return float3(0.760, 0.545, 0.285);  // Torch (Phase 7)
    if (mat == 15u) return float3(0.300, 0.480, 0.780);  // TorchBlue   (Stage G)
    if (mat == 16u) return float3(0.330, 0.720, 0.390);  // TorchGreen  (Stage G)
    if (mat == 17u) return float3(0.560, 0.340, 0.760);  // TorchPurple (Stage G)
    if (mat == 18u) return float3(0.110, 0.085, 0.060);  // Oil (§2.7)
    if (mat == 19u) return float3(0.520, 0.700, 0.160);  // Acid
    if (mat == 20u) return float3(0.300, 0.620, 0.180);  // Sludge
    if (mat == 21u) return float3(0.560, 0.470, 0.320);  // Quicksand
    if (mat == 22u) return float3(0.700, 0.720, 0.740);  // Steam
    return float3(0.90, 0.10, 0.80);                     // unauthored -> obvious magenta
}

// ===========================================================================
// LOOK 1 -- THE BRICKMAP LOOK (LightingConfig.look; 0 = C.9 exactly as before)
//
// Everything in this block is DISPLAY-space, because the engine it reproduces
// (VoxelTerraria_Brickmap) renders in Gamma colour space: its numbers go to the
// screen as-is. This project renders in Linear, so URP sRGB-encodes whatever
// the kernel writes -- which lifts and desaturates every value. That encode is
// the largest single reason this project read as washed out beside it. The
// look-1 path therefore shades in display space and calls LookToLinear() ONCE,
// on the final colour, so the encode lands back on the Brickmap's value.
//
// Presentation only: nothing here is read by traversal or by any shadow ray.
// All colours arrive precomputed for the time of day from SunCycle.Look*.
// ===========================================================================
int    _Look;
float4 _LookSkyZenith;
float4 _LookSkyHorizon;
float4 _LookSkyHalo;       // the sun's colour in the sky (x day factor)
float4 _LookSun;           // direct sun term colour (halo x lookSunScale)
float4 _LookAmbient;
float4 _LookMoon;
float  _LookShadowDarkness;
float  _LookHazeDensity;
float4 _LookGrade;         // CINEMATIC GRADE: x exposure (sun+ambient), y saturation, z shoulder knee, w amount
int    _EmissiveBleed;     // 1 = faces next to lava/torches get glow (default), 0 = off

float3 LookToLinear(float3 c) { return pow(saturate(c), 2.2); }

// The cinematic grade's highlight shoulder: identity below the knee, then an
// exponential roll-off that approaches 1 instead of clipping at it. Knee 1 is
// exactly the identity, which is what the grade passes whenever its amount is
// 0 (golden hour and below), so those frames are unchanged bit for bit.
float3 LookShoulder(float3 x, float knee)
{
    if (knee >= 0.999) return x;
    float span = 1.0 - knee;
    float3 over = max(x - knee, 0.0);
    return min(x, knee) + span * (1.0 - exp(-over / span));
}

// Saturation then shoulder. Neutral (1, 1) is the identity.
float3 LookGradeColour(float3 c, float saturation, float knee)
{
    float luma = dot(c, float3(0.2126, 0.7152, 0.0722));
    c = lerp(float3(luma, luma, luma), c, saturation);
    return LookShoulder(max(c, 0.0), knee);
}

// Sky gradient + sun halo for a view direction. Also the haze target, so
// distant terrain fades into exactly the sky behind it.
float3 LookAtmosphere(float3 dir)
{
    float3 baseSky = lerp(_LookSkyHorizon.rgb, _LookSkyZenith.rgb, saturate(dir.y * 0.5 + 0.5));
    float sunHighlight = pow(max(0.0, dot(dir, normalize(_SunDir))), 8.0);
    return lerp(baseSky, _LookSkyHalo.rgb, sunHighlight);
}

// MIRRORS MaterialPalette.OfLook in MaterialRules.cs (the authoritative
// table). PaletteSyncTests parses this function exactly as it does
// MaterialAlbedo. Change a colour in BOTH places.
float3 MaterialAlbedoLook(uint mat)
{
    if (mat >= 128u && mat < 224u) return kTg2PaletteLook[mat - 128u];
    if (mat == 2u)  return float3(0.480, 0.480, 0.500);  // Stone
    if (mat == 3u)  return float3(0.330, 0.550, 0.240);  // Grass
    if (mat == 4u)  return float3(0.830, 0.740, 0.510);  // Sand
    if (mat == 5u)  return float3(0.720, 0.600, 0.420);  // MossyStone
    if (mat == 6u)  return float3(0.120, 0.340, 0.620);  // Water
    if (mat == 7u)  return float3(0.930, 0.950, 0.970);  // Snow
    if (mat == 8u)  return float3(0.720, 0.600, 0.420);  // Sandstone
    if (mat == 9u)  return float3(0.200, 0.460, 0.180);  // JungleGrass
    if (mat == 10u) return float3(0.480, 0.480, 0.500);  // Deepstone
    if (mat == 11u) return float3(0.950, 0.350, 0.080);  // Lava
    if (mat == 12u) return float3(0.680, 0.480, 0.130);  // Honey
    if (mat == 13u) return float3(0.090, 0.070, 0.120);  // Obsidian
    if (mat == 14u) return float3(1.000, 0.700, 0.350);  // Torch
    if (mat == 15u) return float3(0.400, 0.600, 1.000);  // TorchBlue
    if (mat == 16u) return float3(0.450, 1.000, 0.500);  // TorchGreen
    if (mat == 17u) return float3(0.780, 0.450, 1.000);  // TorchPurple
    if (mat == 18u) return float3(0.160, 0.120, 0.080);  // Oil (§2.7)
    if (mat == 19u) return float3(0.620, 0.900, 0.180);  // Acid
    if (mat == 20u) return float3(0.400, 0.850, 0.220);  // Sludge
    if (mat == 21u) return float3(0.660, 0.560, 0.380);  // Quicksand
    if (mat == 22u) return float3(0.850, 0.870, 0.900);  // Steam
    return float3(0.90, 0.10, 0.80);                     // unauthored -> obvious magenta
}

// The Brickmap's "Lay of the Land" colour blend, ported with its constants:
// green materials drift between lush, olive and deep tones in blocky patches
// (hash of floor(pos * 0.1) and floor(pos * 0.5) there; >> 3 and >> 1 here,
// bitwise per this project's coordinate rule), plus +/-4% per voxel on all.
float3 LookAlbedo(uint mat, int3 voxel)
{
    float3 baseColor = MaterialAlbedoLook(mat);
    float noiseLarge  = VoxelHash(voxel >> 3);
    float noiseMedium = VoxelHash(voxel >> 1);
    float noiseDetail = (VoxelHash(voxel) - 0.5) * 0.08;
    if (baseColor.g > baseColor.r && baseColor.g > baseColor.b)
    {
        float3 colorLush  = baseColor * float3(1.1, 1.1, 0.8);
        float3 colorOlive = baseColor * float3(0.8, 0.9, 0.6);
        float3 colorDeep  = baseColor * float3(0.5, 0.7, 0.5);
        float3 mixColor = lerp(colorLush, colorOlive, smoothstep(0.2, 0.8, noiseLarge));
        baseColor = lerp(mixColor, colorDeep, smoothstep(0.3, 0.9, noiseMedium));
    }
    return baseColor + noiseDetail;
}

// Self-lit materials skip the darkening terms so they stay hot. This is a
// SHADING CHEAT, not a light source: nothing here illuminates anything else.
// Real emission is Phase 7 (§6.5).
bool MaterialIsSelfLit(uint mat) { return mat == 11u || mat == 20u; }   // Lava, Sludge

// ---- TASK 66b: THE VIEW FROM INSIDE A FLUID ----
// With the eye inside a fluid voxel the primary ray used to "hit" that voxel at
// t = 0 with normal (0,0,0); its shadow and sky rays started inside the fluid
// too (sunVis 0, skyVis 0), so the frame shaded to near-black. Now, when
// _UnderwaterView != 0 and the eye's voxel holds one of these fluids, the march
// passes through that fluid (passMat), stops on anything else -- the bed and
// walls are shaded as usual, AIR is the surface seen from below -- and the
// pixel is fogged by the distance travelled in the fluid. Lava stays as it was
// (the player is burning; the look is not worth a branch), steam is a gas.
// The eye NOT in a fluid takes exactly the old path: passMat is 0, every test
// below reduces to the old `mat != 0`.
int _UnderwaterView;   // 1 on (RaymarchFeature.UnderwaterView, PlaySettings.underwaterFog)
bool MaterialIsClearFluid(uint m) { return m == 6u || m == 12u || m == 18u || m == 19u || m == 20u || m == 21u; }

// Extinction per metre, r g b: transmittance over d metres is exp(-d * this).
// Water keeps blue-green longest (~6-8 m to the bed, "a few metres").
float3 FluidExtinction(uint m)
{
    if (m == 6u)  return float3(0.60, 0.30, 0.22);   // Water
    if (m == 12u) return float3(0.90, 1.40, 3.00);   // Honey: amber, ~1.5 m
    if (m == 18u) return float3(3.00, 3.20, 3.50);   // Oil: dark, ~1 m
    if (m == 19u) return float3(1.00, 0.35, 1.40);   // Acid: green
    if (m == 20u) return float3(1.50, 0.60, 1.80);   // Sludge: green
    return float3(6.0, 7.0, 9.0);                    // Quicksand: ~0.3 m
}

// ===========================================================================
// A.7's `emissive`, MIRRORED -- and why it is mirrored rather than uploaded.
//
// Stage 0 established that there is NO GraphicsBuffer<MaterialData> anywhere in
// this project: A.7's struct is declared in StructHeaders.cs/.hlsl and read by
// nothing, and FluidGpuSimulation uploads four separate flat uint arrays
// instead, deliberately, "restricted to what the CA reads". So Phase 7 had a
// choice: build the real §3.9 registry buffer and thread it through
// RaymarchFeature's render-graph pass, or mirror the two numbers it needs the
// way the palette beside it is already mirrored.
//
// It mirrors, for MaterialPalette's own stated reason: wiring a new registry
// buffer through render setup for a colour change is a §3.9 sync-contract
// addition, and Phase 7 already has one new untrusted thing (§0.1 invariant 5).
// The real A.7 buffer is CARRIED FORWARD, not silently skipped --
// PHASE_7_COMPLETION.md's CARRY-FORWARD section names it.
//
// PaletteSyncTests parses BOTH of these functions and fails if they drift from
// MaterialRules' tables, exactly as it already does for MaterialAlbedo.
// ===========================================================================
float MaterialEmissive(uint mat)
{
    if (mat == 14u) return 1.00;   // Torch
    if (mat == 11u) return 0.55;   // Lava
    if (mat == 15u) return 1.00;   // TorchBlue   (Stage G)
    if (mat == 16u) return 1.00;   // TorchGreen  (Stage G)
    if (mat == 17u) return 1.00;   // TorchPurple (Stage G)
    if (mat == 20u) return 0.35;   // Sludge (§2.7)
    return 0.0;
}

float3 MaterialEmissiveTint(uint mat)
{
    if (mat == 14u) return float3(1.00, 0.72, 0.38);   // Torch -- warm candle flame
    if (mat == 11u) return float3(1.00, 0.42, 0.14);   // Lava  -- hotter, redder
    if (mat == 15u) return float3(0.36, 0.58, 1.00);   // TorchBlue   (Stage G)
    if (mat == 16u) return float3(0.42, 1.00, 0.48);   // TorchGreen  (Stage G)
    if (mat == 17u) return float3(0.78, 0.42, 1.00);   // TorchPurple (Stage G)
    if (mat == 20u) return float3(0.55, 1.00, 0.30);   // Sludge -- toxic green
    return float3(0.0, 0.0, 0.0);
}



// CHUNK-MAJOR (Phase 4). Ring-masking the CHUNK coord rather than the brick
// coord is what makes a chunk's 4096 entries contiguous. Masking stays
// origin-independent: under a power-of-two mask, subtracting the origin only
// rotates the ring, so the origin is needed for the BOUNDS TEST (in CSMain,
// once per iteration) and not here.
uint ReadClipmap(int3 brickCoord, uint3 windowDimsBricks)
{
    int3 chunkCoord   = brickCoord >> 4;
    int3 wrappedChunk = chunkCoord & (int3)(_WindowDimsChunksPacked.xyz - 1);
    int  chunkSlot    = wrappedChunk.x
                      + (wrappedChunk.y * (int)_WindowDimsChunksPacked.x)
                      + (wrappedChunk.z * (int)_WindowDimsChunksPacked.x * (int)_WindowDimsChunksPacked.y);

    int3 localBrick = brickCoord & 15;
    int  local      = LocalBrickIndex(localBrick);   // C.1, CoordMath.hlsl

    return ClipmapBuffer[(chunkSlot * 4096) + local];
}

// ===========================================================================
// SHADOW ROOF SKIP -- a 2D max-height pyramid over the window (2026-09-24).
//
// The idea is the comparison engines' per-chunk height map ("the ray is above
// this chunk's roof and heading up, so nothing in it can occlude"), built as a
// PYRAMID so a sun ray that has climbed above a whole region's tallest point
// crosses that region in one step. That is exactly the golden-hour case: a
// grazing ray otherwise walks ~840 voxels of near-ground air before the
// content-ceiling exit, and the 3D air-mip cannot take big steps there because
// every large cube near the ground contains some terrain.
//
// EXACT BY CONSTRUCTION, not an approximation:
//  * level 0 is per brick column (8x8 voxels), the first air voxel Y above the
//    highest solid brick -- brick-granular, so it only ever OVER-states;
//  * it is DILATED by one column (3x3), so a skipped ray has no solid face
//    neighbour either -- C.10's clearance scan would have found nothing, so
//    the soft penumbra is unchanged too;
//  * it is rounded UP to 16 voxels, the tier-2 voxel size, and the cascade's
//    majority-rule downsample can never put a coarse voxel above that;
//  * it is used only when the ray is climbing (dir.y > 0), so a ray above a
//    column's roof can never come back down into it.
// Rebuilt every frame from the tier-0 clipmap (the GPU mirror of CPU state),
// so edits and fluid are never stale. The rebuild is inside the measured
// frame, not excluded from it.
// ===========================================================================
#define HEIGHT_LEVELS 6
RWStructuredBuffer<uint> HeightMip;
int   _ShadowRoofSkip;
int   _HeightLevel;
int4  _HeightOffsetsA;   // levels 0..3
int4  _HeightOffsetsB;   // levels 4, 5, then the raw (undilated) level-0 scratch

int HeightOffset(int L)
{
    if (L == 0) return _HeightOffsetsA.x;
    if (L == 1) return _HeightOffsetsA.y;
    if (L == 2) return _HeightOffsetsA.z;
    if (L == 3) return _HeightOffsetsA.w;
    if (L == 4) return _HeightOffsetsB.x;
    return _HeightOffsetsB.y;
}

// Top (first air voxel Y) of the level-L cell containing brick column (bx, bz),
// world brick coordinates. Ring-addressed, bitwise, like the clipmap itself.
uint ReadHeight(int L, int bx, int bz)
{
    int nx = (int)_WindowDimsBricksPacked.x >> L;
    int nz = (int)_WindowDimsBricksPacked.z >> L;
    int cx = (bx >> L) & (nx - 1);
    int cz = (bz >> L) & (nz - 1);
    return HeightMip[HeightOffset(L) + cx + cz * nx];
}

// ---- AO helpers live HERE, below ReadClipmap, because they call it.
// HLSL requires declaration before use; placing them up beside the palette
// produced 'undeclared identifier ReadClipmap' on Metal only, which the
// Editor-side shader check does not catch -- the build-log gate did.
/// Solid test for ambient occlusion. READ-ONLY, and deliberately a separate
/// function from anything the DDA uses -- it reuses ReadClipmap and
/// BrickDataBuffer exactly as the traversal reads them, but no traversal code
/// path calls this and it mutates nothing.
bool AoSolidAt(int3 voxel, uint3 windowDimsBricks)
{
    int3 rel = VoxelToBrick(voxel) - _WindowOriginBricksPacked.xyz;
    if (rel.x < 0 || rel.y < 0 || rel.z < 0 ||
        rel.x >= (int)windowDimsBricks.x ||
        rel.y >= (int)windowDimsBricks.y ||
        rel.z >= (int)windowDimsBricks.z) return false;

    uint handle = ReadClipmap(VoxelToBrick(voxel), windowDimsBricks);
    if ((handle & 0x80000000u) == 0u) return (handle & 0xFFu) != 0u;   // uniform brick
    uint poolIdx = handle & 0x3FFFFFFFu;
    uint vIdx = (uint)LocalVoxelIndex(LocalVoxelIndex3D(voxel));
    uint packed = BrickDataBuffer[(poolIdx * 128) + (vIdx >> 2)];
    return (((packed >> ((vIdx & 3u) * 8u)) & 0xFFu) != 0u);
}

/// Read material id at voxel. Tier-0 clipmap only.
uint VoxelMaterialAt(int3 voxel, uint3 windowDimsBricks)
{
    int3 rel = VoxelToBrick(voxel) - _WindowOriginBricksPacked.xyz;
    if (rel.x < 0 || rel.y < 0 || rel.z < 0 ||
        rel.x >= (int)windowDimsBricks.x ||
        rel.y >= (int)windowDimsBricks.y ||
        rel.z >= (int)windowDimsBricks.z) return 0u;

    uint handle = ReadClipmap(VoxelToBrick(voxel), windowDimsBricks);
    if ((handle & 0x80000000u) == 0u) return handle & 0xFFu;   // uniform brick
    uint poolIdx = handle & 0x3FFFFFFFu;
    uint vIdx = (uint)LocalVoxelIndex(LocalVoxelIndex3D(voxel));
    uint packed = BrickDataBuffer[(poolIdx * 128) + (vIdx >> 2)];
    return (packed >> ((vIdx & 3u) * 8u)) & 0xFFu;
}

/// Task 66b: the voxel Y of the plane where `fluid` ends straight above `eye`
/// (the surface, or a ceiling over a flooded cave). Whole uniform fluid bricks
/// are skipped; 48 reads at most (past that the eye is called that deep). Every
/// thread asks the same column, so the reads are coherent. Eye-in-fluid only.
int FluidTopAbove(int3 eye, uint fluid, uint3 windowDimsBricks)
{
    int y = eye.y;
    [loop]
    for (int i = 0; i < 48; i++)
    {
        int3 v = int3(eye.x, y, eye.z);
        int3 rel = VoxelToBrick(v) - _WindowOriginBricksPacked.xyz;
        if (rel.y >= (int)windowDimsBricks.y || y >= _ContentCeilingVoxelY) return y;
        uint handle = ReadClipmap(VoxelToBrick(v), windowDimsBricks);
        if ((handle & 0x80000000u) == 0u)
        {
            if ((handle & 0xFFu) != fluid) return y;
            y = ((y >> 3) + 1) << 3;   // the next brick up
            continue;
        }
        if (VoxelMaterialAt(v, windowDimsBricks) != fluid) return y;
        y++;
    }
    return y;
}

// ---- TASK 73 PROTOTYPE: RIVER LOOK (throwaway; _RiverLook 0 = this never runs) ----
// A shading-only check of what the renderer alone can do for generated rivers
// (RIVERS_WATERFALLS_PLAN.md). Look 1 path, water (mat 6) primary hits only:
//   * a SIDE face over a 1-voxel step down to more water is drawn as surface
//     (normal up), so a fine staircase reads as one sloped sheet;
//   * any other water side face is a white-water curtain (vertical streaks);
//   * a TOP face within 3 voxels of a drop (air beside it at its own height)
//     gets a foam lip.
// No animation (stills only), no flow field on the GPU, no far band.
int _RiverLook;
// Outside tier 0's window VoxelMaterialAt says AIR; here that must not read as a drop.
uint RiverMatAt(int3 v, uint3 windowDimsBricks)
{
    int3 rel = VoxelToBrick(v) - _WindowOriginBricksPacked.xyz;
    if (any(rel < 0) || any(rel >= (int3)windowDimsBricks)) return 255u;
    return VoxelMaterialAt(v, windowDimsBricks);
}
float3 RiverLookAlbedo(float3 baseColor, int3 voxel, inout int3 normal, uint3 windowDimsBricks)
{
    float3 foamC = float3(0.80, 0.86, 0.90);
    if (normal.y == 0)
    {
        int3 out1 = voxel + normal;   // the air cell this face looks into
        if (VoxelMaterialAt(out1 - int3(0, 1, 0), windowDimsBricks) == 6u)
        {
            normal = int3(0, 1, 0);   // a 1-voxel riser between water: part of the sheet
            return baseColor;
        }
        int3 a = abs(normal);
        int u = a.x != 0 ? voxel.z : voxel.x;   // the along-face column
        float streak = VoxelHash(int3(u, voxel.y >> 2, 7)) * 0.6 + VoxelHash(int3(u >> 1, voxel.y >> 3, 11)) * 0.4;
        return lerp(baseColor, foamC, 0.45 + 0.45 * streak);
    }
    if (normal.y > 0)
    {
        float foam = 0.0;
        [unroll] for (int s = 1; s <= 3; s++)
        {
            float w = 1.0 - (s - 1) * 0.3;
            if (RiverMatAt(voxel + int3(s, 0, 0), windowDimsBricks) == 0u) foam = max(foam, w);
            if (RiverMatAt(voxel - int3(s, 0, 0), windowDimsBricks) == 0u) foam = max(foam, w);
            if (RiverMatAt(voxel + int3(0, 0, s), windowDimsBricks) == 0u) foam = max(foam, w);
            if (RiverMatAt(voxel - int3(0, 0, s), windowDimsBricks) == 0u) foam = max(foam, w);
        }
        float rip = VoxelHash(int3(voxel.x >> 1, 3, voxel.z >> 1)) - 0.5;
        float3 c = baseColor * (1.0 + 0.10 * rip);
        return lerp(c, foamC, foam * (0.55 + 0.3 * VoxelHash(voxel)));
    }
    return baseColor;
}

/// SVO/Brickmap emissive color: an emitting material glows in its own look albedo.
float3 LookEmitColor(int3 voxel, uint3 windowDimsBricks)
{
    uint m = VoxelMaterialAt(voxel, windowDimsBricks);
    return MaterialEmissive(m) > 0.0 ? MaterialAlbedoLook(m) : float3(0.0, 0.0, 0.0);
}

/// Classic voxel corner-darkening. For each of the four corners of the hit
/// face, occlusion is a function of the two edge neighbours and the diagonal;
/// the four values are then bilinearly interpolated across the face using the
/// ray's actual hit position. This is the trick that makes voxel terrain read
/// as having depth without any light in the scene at all.
float FaceAO(int3 voxel, int3 normal, float3 hitVoxelPos, uint3 windowDimsBricks)
{
    // Face-plane tangents. Any consistent pair works; the bilinear weights
    // below are computed in the same basis, so the choice cannot skew the result.
    int3 n = normal;
    int3 u = (abs(n.x) == 1) ? int3(0, 1, 0) : int3(1, 0, 0);
    int3 v = (abs(n.z) == 1) ? int3(0, 1, 0) : int3(0, 0, 1);
    if (abs(n.y) == 1) { u = int3(1, 0, 0); v = int3(0, 0, 1); }

    int3 base = voxel + n;                    // the empty cell in front of the face
    float ao[4];
    [unroll]
    for (int c = 0; c < 4; c++)
    {
        int su = (c & 1) ? 1 : -1;
        int sv = (c & 2) ? 1 : -1;
        bool s1 = AoSolidAt(base + u * su, windowDimsBricks);
        bool s2 = AoSolidAt(base + v * sv, windowDimsBricks);
        bool cd = AoSolidAt(base + u * su + v * sv, windowDimsBricks);
        // Both edges occluded => fully dark corner, the diagonal cannot help.
        float occ = (s1 && s2) ? 3.0 : (float)((s1 ? 1 : 0) + (s2 ? 1 : 0) + (cd ? 1 : 0));
        ao[c] = 1.0 - occ * 0.25;             // 3 occluders -> 0.25, none -> 1.0
    }

    // Where in the face did the ray land? Project the hit position onto the
    // tangents and remap [-0.5,0.5] to [0,1].
    float fu = saturate(dot(hitVoxelPos, float3(u)) + 0.5);
    float fv = saturate(dot(hitVoxelPos, float3(v)) + 0.5);
    float a = lerp(ao[0], ao[1], fu);
    float b = lerp(ao[2], ao[3], fu);
    return lerp(a, b, fv);
}

// Generalized clipmap read for cascade tiers 1/2. tierCoarseBrickCoord is in
// THAT TIER's own coarse-brick coordinate space (i.e. already divided down
// to "brick index," not raw voxels) - same convention ReadClipmap uses for
// tier 0. Branches on tier to pick the buffer/dims; tier is derived from
// currentDist so it's coherent across most of a thread group's rays (same
// coherent-branch argument already used for the dense/uniform branch above).
// CHUNK-MAJOR, matching CascadeTierPool. A chunk contributes
// entriesPerChunk contiguous coarse-brick entries (512 at tier 1, 64 at
// tier 2), indexed chunkSlot*entriesPerChunk + local, local x-fastest.
uint ReadClipmapTier(int tier, int3 tierCoarseBrickCoord)
{
    uint4 info = (tier == 1) ? _CascadeTierInfo1 : _CascadeTierInfo2;
    int edge           = (int)info.x;   // coarse bricks per chunk edge
    int edgeShift      = (int)info.y;   // log2(edge)
    int entriesPerChunk= (int)info.z;

    int3 chunkCoord   = tierCoarseBrickCoord >> edgeShift;
    int3 wrappedChunk = chunkCoord & (int3)(_WindowDimsChunksPacked.xyz - 1);
    int  chunkSlot    = wrappedChunk.x
                      + (wrappedChunk.y * (int)_WindowDimsChunksPacked.x)
                      + (wrappedChunk.z * (int)_WindowDimsChunksPacked.x * (int)_WindowDimsChunksPacked.y);

    int3 localCoarse = tierCoarseBrickCoord & (edge - 1);
    int  local       = localCoarse.x + edge * (localCoarse.y + edge * localCoarse.z);

    int flatIndex = (chunkSlot * entriesPerChunk) + local;
    return (tier == 1) ? ClipmapBufferTier1[flatIndex] : ClipmapBufferTier2[flatIndex];
}

uint ReadBrickDataTier(int tier, uint poolIdx, uint wordIdx)
{
    if (tier == 1) return BrickDataBufferTier1[(poolIdx * 128) + wordIdx];
    return BrickDataBufferTier2[(poolIdx * 128) + wordIdx];
}

// Tier shift: log2(downsample factor). Tier 1 -> factor 2 -> shift 1.
// Tier 2 -> factor 4 -> shift 2. Matches LODConfig.DownsampleFactor exactly;
// if LODConfig's tier voxel sizes ever change, this must change with it -
// there is deliberately no runtime derivation here (would cost a log2 per
// iteration for a value that's only ever 1 or 2), so this is the one place
// a LODConfig edit requires a matching shader edit.
int TierShift(int tier)
{
    return (tier == 1) ? 1 : 2;
}

// ===========================================================================
// §6.5's 8.2 LOD RULE, EXTRACTED SO IT IS DEFINED ONCE (§0.1 invariant 8).
//
// This was four inline lines in CSMain. It is now a function for one reason,
// and the reason is a latent bug rather than tidiness:
//
//   §6.5: "the shadow ray selects LOD by CAMERA DISTANCE TO THE CURRENT SAMPLE
//   POINT, NOT by the shadow ray's own traveled distance. The 8.1 rule
//   (coarsen by traveled distance) was wrong: a short shadow ray to a mountain
//   the camera renders coarse would evaluate it at fine LOD, so the cast shadow
//   wouldn't match the on-screen silhouette -- detached, floating shadows."
//
// The inline version compared `currentDist`. For a PRIMARY ray that is correct,
// but only by accident of where the ray starts: a primary ray begins at the
// camera, so its travelled distance IS its camera distance. A shadow ray begins
// at a surface. Reusing `currentDist` there is EXACTLY the retracted 8.1 rule,
// and it would have looked like working code.
//
// Naming the parameter `cameraDistanceVoxels` forces each call site to say
// which distance it is passing. ShadowRayReference.SelectLODTier is the CPU
// sibling of this function and is unit-tested against these same boundaries.
// ===========================================================================
int SelectLODTier(float cameraDistanceVoxels)
{
    if (_UseLODCascade == 0) return 0;
    if (cameraDistanceVoxels >= _TierOuterRangeVoxels.y) return 2;
    if (cameraDistanceVoxels >= _TierOuterRangeVoxels.x) return 1;
    return 0;
}

/// See the note beside _ShadowTravelLOD's declaration.
int SelectShadowTier(float cameraDistanceVoxels, float travelVoxels)
{
    int camTier = SelectLODTier(cameraDistanceVoxels);
    if (_ShadowTravelLOD <= 0.0 || _UseLODCascade == 0) return camTier;

    float k = max(1.0e-4, _KSoft);
    float t1 = _ShadowTravelLOD * 2.0 / k;   // tier 1 voxels are 2 voxels wide
    float t2 = _ShadowTravelLOD * 4.0 / k;   // tier 2 voxels are 4 voxels wide
    int travelTier = travelVoxels >= t2 ? 2 : (travelVoxels >= t1 ? 1 : 0);
    return max(camTier, travelTier);
}

int AirMipFlatIndex(int3 cell, uint3 dims)
{
    int3 wrapped = cell & (int3)(dims - 1);
    return wrapped.x
         + wrapped.y * (int)dims.x
         + wrapped.z * (int)dims.x * (int)dims.y;
}

uint ReadAirMipLegacy(int level, int3 cell)
{
    if (level == 1) return AirMip1[AirMipFlatIndex(cell, _AirMipDims0.xyz)];
    if (level == 2) return AirMip2[AirMipFlatIndex(cell, _AirMipDims1.xyz)];
    if (level == 3) return AirMip3[AirMipFlatIndex(cell, _AirMipDims2.xyz)];
    return AirMip4[AirMipFlatIndex(cell, _AirMipDims3.xyz)];
}

// Packed + merged read. One indexed load from one buffer plus a shift/mask -
// no branch over which buffer to hit, and the whole pyramid is small enough
// to stay resident in cache.
uint ReadAirMipPacked(int level, int3 cell)
{
    float4 info = _MipInfo[level - 1];
    uint3 dims = uint3((uint)info.x, (uint)info.y, (uint)info.z);
    int3 wrapped = cell & (int3)(dims - 1);
    int flat = wrapped.x
             + wrapped.y * (int)dims.x
             + wrapped.z * (int)dims.x * (int)dims.y;
    uint wordIdx = (uint)info.w + ((uint)flat >> 5);
    return (AirMipPacked[wordIdx] >> ((uint)flat & 31u)) & 1u;
}

// Dispatches on a UNIFORM, so the branch is scalar and coherent across every
// thread in the dispatch - cheap on Apple GPUs. Note this means the A/B very
// slightly understates the packed path's true benefit, since a dedicated
// packed-only kernel would not carry the dead legacy code at all.
uint ReadAirMip(int level, int3 cell)
{
    if (_UsePackedMips != 0) return ReadAirMipPacked(level, cell);
    return ReadAirMipLegacy(level, cell);
}

// ---------------------------------------------------------------------------
//  mode 0 leap (unchanged)
// ---------------------------------------------------------------------------
void LeapSpan(inout int3 voxel, inout float3 tMax, inout float currentDist,
              float3 tDelta, int3 step, int3 spanMin, int spanVoxels, inout int3 normal,
              inout int exitIters, inout int nonExitIters)
{
    int3 exitCount = int3(
        step.x > 0 ? (spanMin.x + spanVoxels - voxel.x) : (voxel.x - (spanMin.x - 1)),
        step.y > 0 ? (spanMin.y + spanVoxels - voxel.y) : (voxel.y - (spanMin.y - 1)),
        step.z > 0 ? (spanMin.z + spanVoxels - voxel.z) : (voxel.z - (spanMin.z - 1)));

    precise float tExitX = tMax.x + (exitCount.x - 1) * tDelta.x;
    precise float tExitY = tMax.y + (exitCount.y - 1) * tDelta.y;
    precise float tExitZ = tMax.z + (exitCount.z - 1) * tDelta.z;

    int axis;
    if (tExitX <= tExitY) axis = (tExitX <= tExitZ) ? 0 : 2;
    else                  axis = (tExitY <= tExitZ) ? 1 : 2;

    float tHit = (axis == 0) ? tExitX : ((axis == 1) ? tExitY : tExitZ);

    const float eps = 1e-4;

    int guardX = min(exitCount.x, spanVoxels + 1);
    int guardY = min(exitCount.y, spanVoxels + 1);
    int guardZ = min(exitCount.z, spanVoxels + 1);

    if (axis == 0) { for (int kx = 0; kx < exitCount.x; kx++) { voxel.x += step.x; tMax.x += tDelta.x; exitIters++; } }
    if (axis == 1) { for (int ky = 0; ky < exitCount.y; ky++) { voxel.y += step.y; tMax.y += tDelta.y; exitIters++; } }
    if (axis == 2) { for (int kz = 0; kz < exitCount.z; kz++) { voxel.z += step.z; tMax.z += tDelta.z; exitIters++; } }

    if (axis != 0) { int g = 0; [loop] while (tMax.x <= tHit + eps && g < guardX) { voxel.x += step.x; tMax.x += tDelta.x; g++; nonExitIters++; } }
    if (axis != 1) { int g = 0; [loop] while (tMax.y <= tHit + eps && g < guardY) { voxel.y += step.y; tMax.y += tDelta.y; g++; nonExitIters++; } }
    if (axis != 2) { int g = 0; [loop] while (tMax.z <= tHit + eps && g < guardZ) { voxel.z += step.z; tMax.z += tDelta.z; g++; nonExitIters++; } }

    currentDist = tHit;
    normal = (axis == 0) ? int3(-step.x, 0, 0)
           : ((axis == 1) ? int3(0, -step.y, 0)
                          : int3(0, 0, -step.z));
}

float ReseedTMaxAxis(int voxelAxis, float rayStartAxis, float tDeltaAxis, int stepAxis)
{
    return (stepAxis > 0 ? (voxelAxis + 1.0 - rayStartAxis) : (rayStartAxis - voxelAxis)) * tDeltaAxis;
}

void LeapSpanReseed(inout int3 voxel, inout float3 tMax, inout float currentDist,
                     float3 tDelta, int3 step, float3 rayStart, int3 spanMin, int spanVoxels,
                     inout int3 normal, inout int exitLeaps, inout int nonExitIters)
{
    int3 exitCount = int3(
        step.x > 0 ? (spanMin.x + spanVoxels - voxel.x) : (voxel.x - (spanMin.x - 1)),
        step.y > 0 ? (spanMin.y + spanVoxels - voxel.y) : (voxel.y - (spanMin.y - 1)),
        step.z > 0 ? (spanMin.z + spanVoxels - voxel.z) : (voxel.z - (spanMin.z - 1)));

    precise float tExitX = tMax.x + (exitCount.x - 1) * tDelta.x;
    precise float tExitY = tMax.y + (exitCount.y - 1) * tDelta.y;
    precise float tExitZ = tMax.z + (exitCount.z - 1) * tDelta.z;

    int axis;
    if (tExitX <= tExitY) axis = (tExitX <= tExitZ) ? 0 : 2;
    else                  axis = (tExitY <= tExitZ) ? 1 : 2;

    float tHit = (axis == 0) ? tExitX : ((axis == 1) ? tExitY : tExitZ);

    const float eps = 1e-4;
    int nonExitGuard = spanVoxels + 1;
    int guardX = min(exitCount.x, nonExitGuard);
    int guardY = min(exitCount.y, nonExitGuard);
    int guardZ = min(exitCount.z, nonExitGuard);

    if (axis == 0)
    {
        voxel.x += step.x * exitCount.x;
        tMax.x = ReseedTMaxAxis(voxel.x, rayStart.x, tDelta.x, step.x);
    }
    if (axis == 1)
    {
        voxel.y += step.y * exitCount.y;
        tMax.y = ReseedTMaxAxis(voxel.y, rayStart.y, tDelta.y, step.y);
    }
    if (axis == 2)
    {
        voxel.z += step.z * exitCount.z;
        tMax.z = ReseedTMaxAxis(voxel.z, rayStart.z, tDelta.z, step.z);
    }
    exitLeaps++;

    if (axis != 0) { int g = 0; [loop] while (tMax.x <= tHit + eps && g < guardX) { voxel.x += step.x; tMax.x += tDelta.x; g++; nonExitIters++; } }
    if (axis != 1) { int g = 0; [loop] while (tMax.y <= tHit + eps && g < guardY) { voxel.y += step.y; tMax.y += tDelta.y; g++; nonExitIters++; } }
    if (axis != 2) { int g = 0; [loop] while (tMax.z <= tHit + eps && g < guardZ) { voxel.z += step.z; tMax.z += tDelta.z; g++; nonExitIters++; } }

    currentDist = tHit;
    normal = (axis == 0) ? int3(-step.x, 0, 0)
           : ((axis == 1) ? int3(0, -step.y, 0)
                          : int3(0, 0, -step.z));
}

void LeapSpanReseedClosedForm(inout int3 voxel, inout float3 tMax, inout float currentDist,
                     float3 tDelta, int3 step, float3 rayStart, int3 spanMin, int spanVoxels,
                     inout int3 normal, inout int exitLeaps, inout int nonExitIters)
{
    int3 exitCount = int3(
        step.x > 0 ? (spanMin.x + spanVoxels - voxel.x) : (voxel.x - (spanMin.x - 1)),
        step.y > 0 ? (spanMin.y + spanVoxels - voxel.y) : (voxel.y - (spanMin.y - 1)),
        step.z > 0 ? (spanMin.z + spanVoxels - voxel.z) : (voxel.z - (spanMin.z - 1)));

    precise float tExitX = tMax.x + (exitCount.x - 1) * tDelta.x;
    precise float tExitY = tMax.y + (exitCount.y - 1) * tDelta.y;
    precise float tExitZ = tMax.z + (exitCount.z - 1) * tDelta.z;

    int axis;
    if (tExitX <= tExitY) axis = (tExitX <= tExitZ) ? 0 : 2;
    else                  axis = (tExitY <= tExitZ) ? 1 : 2;

    float tHit = (axis == 0) ? tExitX : ((axis == 1) ? tExitY : tExitZ);

    const float eps = 1e-4;
    int nonExitGuard = spanVoxels + 1;
    int guardX = min(exitCount.x, nonExitGuard);
    int guardY = min(exitCount.y, nonExitGuard);
    int guardZ = min(exitCount.z, nonExitGuard);

    if (axis == 0) voxel.x += step.x * exitCount.x;
    if (axis == 1) voxel.y += step.y * exitCount.y;
    if (axis == 2) voxel.z += step.z * exitCount.z;
    exitLeaps++;

    if (axis != 0)
    {
        float absDirX = 1.0 / tDelta.x;
        int nx = (int)floor((tHit + eps - tMax.x) * absDirX) + 1;
        nx = clamp(nx, 0, guardX);
        voxel.x += step.x * nx;
        nonExitIters += nx;
    }
    if (axis != 1)
    {
        float absDirY = 1.0 / tDelta.y;
        int ny = (int)floor((tHit + eps - tMax.y) * absDirY) + 1;
        ny = clamp(ny, 0, guardY);
        voxel.y += step.y * ny;
        nonExitIters += ny;
    }
    if (axis != 2)
    {
        float absDirZ = 1.0 / tDelta.z;
        int nz = (int)floor((tHit + eps - tMax.z) * absDirZ) + 1;
        nz = clamp(nz, 0, guardZ);
        voxel.z += step.z * nz;
        nonExitIters += nz;
    }

    tMax.x = ReseedTMaxAxis(voxel.x, rayStart.x, tDelta.x, step.x);
    tMax.y = ReseedTMaxAxis(voxel.y, rayStart.y, tDelta.y, step.y);
    tMax.z = ReseedTMaxAxis(voxel.z, rayStart.z, tDelta.z, step.z);

    currentDist = tHit;
    normal = (axis == 0) ? int3(-step.x, 0, 0)
           : ((axis == 1) ? int3(0, -step.y, 0)
                          : int3(0, 0, -step.z));
}

// ===========================================================================
// THE FUSED SUN-SHADOW RAY (§6.5, C.10)
//
// §6.5: "in the SAME raymarch kernel, immediately after a pixel's primary ray
// resolves a hit, the thread fires ONE secondary DDA ray from the hit voxel
// toward the sun THROUGH THE SAME CLIPMAP/LOD DATA."
//
// "the same data" is the load-bearing phrase and it is why this function reads
// ReadClipmap / ReadClipmapTier / ReadAirMip and nothing else. There is no
// shadow-specific buffer, no shadow map, no cascade to re-render and nothing to
// invalidate -- which is also why "bomb a cave roof at noon and sunlight
// reaches the floor the SAME frame" and "pour water off a ledge and get a
// moving shadow" are consequences of §3.10's authoritative-byte rule rather
// than features anyone implements.
//
// STRUCTURALLY THIS IS THE PRIMARY LOOP WITH FOUR DIFFERENCES, and §13's own
// "if stuck" note says so: "the shadow ray is the Phase-2 DDA with a new origin
// + early-out." The four:
//   1. the origin is one cell off the hit face, not the camera (§6.5)
//   2. the tier comes from CAMERA distance to the sample, not from travel (8.2)
//   3. the first hit ends the ray -- occlusion only, material never recorded
//   4. it tracks C.10's minimum clearance ratio on the way
// Everything else -- the leap primitives, the bounds guard, the content-ceiling
// early exit -- is the same already-proven code, called with different numbers.
// ===========================================================================

/// The temporal-shadow history key: the shadow ray's origin cell (TraceShadowRay
/// reads nothing else of the pixel). x and z keep 11 bits, y 9 (204.8 m and
/// 51.2 m periods, far beyond any one-frame reprojection); bit 31 stays clear so
/// no key equals the 0xFFFFFFFF "none".
uint ShadowOriginKey(int3 c)
{
    return ((uint)c.x & 0x7FFu) | (((uint)c.y & 0x1FFu) << 11) | (((uint)c.z & 0x7FFu) << 20);
}

struct ShadowHit
{
    float sunVis;   // C.9's sunVis: 0 fully occluded .. 1 fully lit
    int   steps;    // outer iterations, for the §10.3 heat view and §10.4 dump
};

/// Solid test at a tier, for C.10's near-miss scan.
///
/// Out of the window means NO DATA, and no data must read as air -- returning
/// "solid" there would paint a penumbra against the window edge that moves with
/// the player. Same rule the traversal itself uses: leaving the window
/// terminates a ray, it never aliases back in (PHASE_3_COMPLETION.md §6.2).
bool ShadowSolidAt(int3 v, int tier, uint3 windowDimsBricks)
{
    int3 rel = VoxelToBrick(v) - _WindowOriginBricksPacked.xyz;
    if (rel.x < 0 || rel.y < 0 || rel.z < 0 ||
        rel.x >= (int)windowDimsBricks.x ||
        rel.y >= (int)windowDimsBricks.y ||
        rel.z >= (int)windowDimsBricks.z) return false;

    if (tier == 0)
    {
        uint handle = ReadClipmap(VoxelToBrick(v), windowDimsBricks);
        if ((handle & 0x80000000u) == 0u) return (handle & 0xFFu) != 0u;
        uint poolIdx = handle & 0x3FFFFFFFu;
        uint vIdx = (uint)LocalVoxelIndex(LocalVoxelIndex3D(v));
        uint packed = BrickDataBuffer[(poolIdx * 128) + (vIdx >> 2)];
        return (((packed >> ((vIdx & 3u) * 8u)) & 0xFFu) != 0u);
    }

    int tierShift = TierShift(tier);
    int3 tv = v >> tierShift;
    uint h = ReadClipmapTier(tier, tv >> 3);
    if ((h & 0x80000000u) == 0u) return (h & 0xFFu) != 0u;
    uint pi = h & 0x3FFFFFFFu;
    uint vi = (uint)LocalVoxelIndex(tv & 7);
    uint pk = ReadBrickDataTier(tier, pi, vi >> 2);
    return (((pk >> ((vi & 3u) * 8u)) & 0xFFu) != 0u);
}

/// C.10's `clearance`, in voxel units: the perpendicular distance from the
/// ray's current position to the nearest solid face neighbour that lies AHEAD
/// of the ray. 3.0e30 when nothing ahead is solid.
///
/// THE `dir` TEST IS NOT AN OPTIMISATION -- IT IS WHY LIT PIXELS ARE LIT.
/// A shadow ray starts one cell off the surface it is shading, so that surface
/// is ALWAYS a face neighbour of the origin cell and is always solid. Scanned
/// as a near-miss it gives clearance ~0 at t ~ 0, C.10's m collapses to 0, and
/// every sunlit surface in the world reports full shadow. Skipping neighbours
/// strictly behind the advancing ray removes it BY CONSTRUCTION: the receiver
/// sits at -hitNormal, and any pixel the sun lights has dot(dir, hitNormal) > 0
/// (that is C.9's max(0, N.L) being positive), so dot(dir, -hitNormal) < 0
/// always. No epsilon, nothing to tune. Full derivation and the failing test
/// that found it are in ShadowRayReference.NearestSolidFaceClearance.
float ShadowClearance(int3 voxel, float3 posVox, float3 dir, int tier, uint3 windowDimsBricks)
{
    float best = 3.0e30;
    if (dir.x >= 0.0 && ShadowSolidAt(voxel + int3(1, 0, 0), tier, windowDimsBricks))
        best = min(best, max(0.0, (voxel.x + 1.0) - posVox.x));
    if (dir.x <= 0.0 && ShadowSolidAt(voxel - int3(1, 0, 0), tier, windowDimsBricks))
        best = min(best, max(0.0, posVox.x - voxel.x));
    if (dir.y >= 0.0 && ShadowSolidAt(voxel + int3(0, 1, 0), tier, windowDimsBricks))
        best = min(best, max(0.0, (voxel.y + 1.0) - posVox.y));
    if (dir.y <= 0.0 && ShadowSolidAt(voxel - int3(0, 1, 0), tier, windowDimsBricks))
        best = min(best, max(0.0, posVox.y - voxel.y));
    if (dir.z >= 0.0 && ShadowSolidAt(voxel + int3(0, 0, 1), tier, windowDimsBricks))
        best = min(best, max(0.0, (voxel.z + 1.0) - posVox.z));
    if (dir.z <= 0.0 && ShadowSolidAt(voxel - int3(0, 0, 1), tier, windowDimsBricks))
        best = min(best, max(0.0, posVox.z - voxel.z));
    return best;
}

// §10.4's ring buffer for the shadow path. DebugOut is 128 floats; slots 0-19
// are the pre-Phase-7 raymarcher dump and are NOT touched. 20-33 are the shadow
// ray's scalars, 34-43 are the last 10 clipmap indices it traversed.
#define SHADOW_DUMP_BASE 34
#define SHADOW_DUMP_RING 10

/// The flat clipmap index a shadow ray is about to read, recorded verbatim so a
/// dump can be checked against the CPU store by index rather than by
/// re-deriving addressing from a coordinate (re-deriving it is how an
/// addressing bug hides from its own diagnostic).
int ShadowClipmapFlatIndex(int3 voxel, uint3 windowDimsBricks)
{
    int3 brickCoord = VoxelToBrick(voxel);
    int3 chunkCoord = brickCoord >> 4;
    int3 wrappedChunk = chunkCoord & (int3)(_WindowDimsChunksPacked.xyz - 1);
    int chunkSlot = wrappedChunk.x
                  + (wrappedChunk.y * (int)_WindowDimsChunksPacked.x)
                  + (wrappedChunk.z * (int)_WindowDimsChunksPacked.x * (int)_WindowDimsChunksPacked.y);
    return (chunkSlot * 4096) + LocalBrickIndex(brickCoord & 15);
}

/// Fires one shadow ray. `softEnabled` turns C.10's near-miss tracking on;
/// with it off this is pure binary occlusion, which is §6.5's rung 2.
ShadowHit TraceShadowRay(int3 hitVoxel, int3 hitNormal, float3 sunDir,
                         uint3 windowDimsBricks, bool softEnabled, bool dbg)
{
    ShadowHit r;
    r.sunVis = 1.0;
    r.steps = 0;

    // ---- §6.5's ORIGIN RULE. One cell off the hit face, at its centre. ----
    // There is no bias term here and there must never be one: §13's failure
    // signature for acne and Peter-Panning is "shadow-ray origin isn't starting
    // one cell off the hit face; FIX THE ORIGIN, DON'T ADD A BIAS HACK."
    int3 voxel = hitVoxel + hitNormal;
    float3 rayStart = (float3)voxel + 0.5;

    float3 dir = normalize(sunDir);
    dir.x = abs(dir.x) < 1e-6 ? (dir.x >= 0 ? 1e-6 : -1e-6) : dir.x;
    dir.y = abs(dir.y) < 1e-6 ? (dir.y >= 0 ? 1e-6 : -1e-6) : dir.y;
    dir.z = abs(dir.z) < 1e-6 ? (dir.z >= 0 ? 1e-6 : -1e-6) : dir.z;

    int3 step = int3(sign(dir.x), sign(dir.y), sign(dir.z));
    float3 tDelta = abs(1.0 / dir);
    float3 tMax = float3(
        step.x > 0 ? (voxel.x + 1.0 - rayStart.x) : (rayStart.x - voxel.x),
        step.y > 0 ? (voxel.y + 1.0 - rayStart.y) : (rayStart.y - voxel.y),
        step.z > 0 ? (voxel.z + 1.0 - rayStart.z) : (rayStart.z - voxel.z)
    ) * tDelta;

    float currentDist = 0.0;

    // §6.5: "clamps at max distance (island diagonal)". The SAME clamp the
    // primary ray uses, which under the cascade is tier 2's outer bound. That
    // is the effective island diagonal in this build: the renderer draws 290 m,
    // the resident window is 409.6 m across, and nothing exists past it -- so a
    // literal ~2,700 m island diagonal would only buy thousands of voxels of
    // guaranteed-nothing before the window guard stopped the ray anyway. This
    // is NOT an implementation of Amendment 8.11 (DRAFT, NOT ADOPTED); it
    // follows _MaxRayDistance, so if render range ever grows this follows.
    float maxDist = (_MaxRayDistance > 0.0) ? _MaxRayDistance : 1280.0;
    // Stage F: an independent, shorter shadow clamp when one is configured.
    if (_ShadowMaxDistVoxels > 0.0) maxDist = min(maxDist, _ShadowMaxDistVoxels);

    float m = 3.0e30;                 // C.10's minimum clearance/travel ratio
    float3 camVox = _CameraPos * 10.0;

    int3 nrm = int3(0, 0, 0);         // the leap helpers want these; unused here
    int exitIters = 0, nonExitIters = 0;

    [loop]
    while (currentDist < maxDist && r.steps < _MaxShadowSteps)
    {
        // Content-ceiling early exit. Same structural fact the primary ray
        // uses: above the highest chunk layer generation can produce, and
        // moving further away, every remaining voxel is guaranteed unloaded.
        // For a shadow ray aimed at the sun this fires almost immediately on
        // open ground, which is most of why an unshadowed pixel is cheap.
        if ((voxel.y >= _ContentCeilingVoxelY && step.y > 0) || (voxel.y < _ContentFloorVoxelY && step.y < 0)) break;

        {
            int3 rel = VoxelToBrick(voxel) - _WindowOriginBricksPacked.xyz;
            if (rel.x < 0 || rel.y < 0 || rel.z < 0 ||
                rel.x >= (int)windowDimsBricks.x ||
                rel.y >= (int)windowDimsBricks.y ||
                rel.z >= (int)windowDimsBricks.z) break;
        }

        r.steps++;

        // ---- SHADOW ROOF SKIP (see the HeightMip block) ----
        // Largest pyramid cell whose tallest point is at or below this voxel.
        // Found -> cross that cell's XZ footprint in one step and continue.
        if (_ShadowRoofSkip != 0 && step.y > 0)
        {
            int bx = voxel.x >> 3, bz = voxel.z >> 3;
            int lv = -1;
            [loop]
            for (int L = HEIGHT_LEVELS - 1; L >= 0; L--)
            {
                if (voxel.y >= (int)ReadHeight(L, bx, bz)) { lv = L; break; }
            }
            if (lv >= 0)
            {
                int sh = 3 + lv;
                int span = 1 << sh;
                int cx0 = (voxel.x >> sh) << sh;
                int cz0 = (voxel.z >> sh) << sh;
                float tx = ((step.x > 0 ? (float)(cx0 + span) : (float)cx0) - rayStart.x) / dir.x;
                float tz = ((step.z > 0 ? (float)(cz0 + span) : (float)cz0) - rayStart.z) / dir.z;
                float tExit = min(tx, tz);
                if (tExit > currentDist)
                {
                    float3 p = rayStart + dir * tExit;
                    int3 nv = int3(floor(p));
                    if (tx <= tz) nv.x = step.x > 0 ? cx0 + span : cx0 - 1;
                    else          nv.z = step.z > 0 ? cz0 + span : cz0 - 1;
                    nv.y = max(nv.y, voxel.y);          // climbing: never step down
                    voxel = nv;
                    currentDist = tExit;
                    tMax = float3(
                        ((step.x > 0 ? voxel.x + 1.0 : (float)voxel.x) - rayStart.x) / dir.x,
                        ((step.y > 0 ? voxel.y + 1.0 : (float)voxel.y) - rayStart.y) / dir.y,
                        ((step.z > 0 ? voxel.z + 1.0 : (float)voxel.z) - rayStart.z) / dir.z);
                    continue;
                }
            }
        }

        // ---- §10.4 PER-SUBSYSTEM DIAGNOSTIC DUMP ----
        // "Raymarcher: if a single ray's step count exceeds a threshold (e.g.
        //  >1000), log its origin, direction, and LAST ~10 CLIPMAP INDICES
        //  TRAVERSED." This is the shadow ray's form of that, the same shape as
        //  the existing raymarcher dump: a ring buffer in DebugOut that
        //  ShadowRayDump reads back and writes to a file when the threshold is
        //  crossed.
        //
        // COST, STATED RATHER THAN HIDDEN. `dbg` is uniform per thread and true
        // for exactly one thread in the dispatch, so 2,073,599 of 2,073,600
        // pixels pay one predicated compare per outer iteration and no store.
        // That is the same class of diagnostic branch Amendment 8.10 §5.3
        // measured (all diagnostics together, ~12%) and explicitly recommended
        // continuing to pay -- and Stage 6 measures the SHIPPED binary with it
        // compiled in, so the reported number includes it rather than excluding
        // it and being quietly optimistic.
        if (dbg)
        {
            int slot = (r.steps - 1) % SHADOW_DUMP_RING;
            DebugOut[SHADOW_DUMP_BASE + slot] = (float)ShadowClipmapFlatIndex(voxel, windowDimsBricks);
        }

        // ---- §6.5's 8.2 LOD RULE ----
        // By CAMERA distance to THIS sample point. Passing `currentDist` here
        // would be the retracted 8.1 rule and would produce detached shadows;
        // SelectLODTier's parameter is named so this line has to say which
        // distance it means.
        float3 sampleVox = (float3)voxel + 0.5;
        int tier = SelectShadowTier(length(sampleVox - camVox), currentDist);

        if (tier == 0)
        {
            // Air-mip leaps, exactly as the primary tier-0 path does them.
            // PHASE_3_COMPLETION.md §5 measured the air-mip as the highest-value
            // structure in the traversal (disabling it costs 44% at one pose,
            // 3.5x at another), and a sun-facing shadow ray is mostly empty sky,
            // which is precisely what it accelerates.
            bool leapt = false;
            [loop]
            for (int k = (int)_AirMipLevelCount; k >= 1; k--)
            {
                int shift = 3 + k;
                int3 cell = voxel >> shift;
                if (ReadAirMip(k, cell) == 0u)
                {
                    LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart,
                                             cell << shift, 8 << k, nrm, exitIters, nonExitIters);
                    leapt = true;
                    break;
                }
            }
            if (leapt) continue;

            int3 brickCoord = VoxelToBrick(voxel);
            uint handle = ReadClipmap(brickCoord, windowDimsBricks);

            if ((handle & 0x80000000) != 0)
            {
                uint poolIdx = handle & 0x3FFFFFFF;
                uint vIdx = (uint)LocalVoxelIndex(LocalVoxelIndex3D(voxel));
                uint packed = BrickDataBuffer[(poolIdx * 128) + (vIdx >> 2)];
                uint mat = (packed >> ((vIdx & 3u) * 8u)) & 0xFF;

                // OCCLUSION ONLY. §6.5: "first hit = done." The material is
                // deliberately not recorded -- nothing downstream may branch on
                // WHAT cast a shadow, only that something did.
                if (mat != 0) { r.sunVis = 0.0; return r; }

                // ---- C.10, tracked on the DENSE path only ----
                // A BOUNDED, STATED APPROXIMATION, not an oversight. Scanning
                // six neighbours at every outer iteration would pay for it on
                // air-brick leaps too, where by definition there is no solid
                // within the brick being leapt. Restricting it to dense bricks
                // puts the cost exactly where near-misses can occur and keeps
                // the reads inside the 512-byte body the step just touched.
                // WHAT IT MISSES: a ray skimming a wall built of UNIFORM-solid
                // bricks while travelling through uniform-air bricks gets a hard
                // edge rather than a penumbra, because neither brick is ever
                // micro-stepped. ShadowRayReference (the CPU oracle) scans every
                // cell and is the reference definition; the two agree exactly on
                // OCCLUSION, which is the binary the oracle property is about,
                // and the shader's sunVis is an approximation of the oracle's.
                // Recorded in PHASE_7_COMPLETION.md rather than left implicit.
                if (softEnabled)
                {
                    float3 posVox = rayStart + dir * currentDist;
                    float c = ShadowClearance(voxel, posVox, dir, tier, windowDimsBricks);
                    if (c < 3.0e30) m = min(m, c / max(1.0, currentDist));
                }

                if (tMax.x < tMax.y)
                {
                    if (tMax.x < tMax.z) { voxel.x += step.x; currentDist = tMax.x; tMax.x += tDelta.x; }
                    else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; }
                }
                else
                {
                    if (tMax.y < tMax.z) { voxel.y += step.y; currentDist = tMax.y; tMax.y += tDelta.y; }
                    else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; }
                }
                continue;
            }

            uint umat = handle & 0xFF;
            if (umat != 0) { r.sunVis = 0.0; return r; }

            LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart,
                                     brickCoord * 8, 8, nrm, exitIters, nonExitIters);
        }
        else
        {
            // Tiers 1/2, mirroring the primary coarse path. NOTE, and it is a
            // real gap rather than a claim: this branch has NO CPU oracle, for
            // shadow rays exactly as for primary rays (Amendment 8.10 §5.7,
            // PHASE_2_COMPLETION.md §6.2). Every statement about it is "this
            // reuses an already-proven primitive with different arguments",
            // which is real evidence and categorically weaker than a fuzz proof.
            int tierShift = TierShift(tier);
            int3 tierVoxel = voxel >> tierShift;
            int3 tierBrick = tierVoxel >> 3;

            uint handle = ReadClipmapTier(tier, tierBrick);
            if ((handle & 0x80000000) != 0)
            {
                uint poolIdx = handle & 0x3FFFFFFF;
                uint vIdx = (uint)LocalVoxelIndex(tierVoxel & 7);
                uint packed = ReadBrickDataTier(tier, poolIdx, vIdx >> 2);
                uint mat = (packed >> ((vIdx & 3u) * 8u)) & 0xFF;
                if (mat != 0) { r.sunVis = 0.0; return r; }

                LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart,
                                         tierVoxel << tierShift, 1 << tierShift,
                                         nrm, exitIters, nonExitIters);
                continue;
            }

            uint umat = handle & 0xFF;
            if (umat != 0) { r.sunVis = 0.0; return r; }

            LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart,
                                     (tierBrick * 8) << tierShift, 8 << tierShift,
                                     nrm, exitIters, nonExitIters);
        }
    }

    // Missed. C.10: sunVis = smoothstep(0, k_soft, m) on a miss.
    // k_soft <= 0 is §6.5's hard-shadow toggle and is a BRANCH, not a limit --
    // smoothstep with a zero-width edge is undefined and a NaN here would black
    // out every lit pixel in the frame.
    if (softEnabled && _KSoft > 0.0 && m < 3.0e30) r.sunVis = smoothstep(0.0, _KSoft, m);
    else                                           r.sunVis = 1.0;

    if (dbg)
    {
        DebugOut[21] = (float)voxel.x;      // where the ray ended up
        DebugOut[22] = (float)voxel.y;
        DebugOut[23] = (float)voxel.z;
        DebugOut[32] = (m < 3.0e30) ? m : -1.0;   // C.10's m, -1 = no near miss
    }
    return r;
}

// ===========================================================================
// C.11 -- POINT LIGHTS
//
// §6.5: "On a surface hit the raymarcher sums attenuated contributions from
// lights within range (atten = 1/(1 + d^2 k), C.11). No propagation, no BFS, no
// per-brick storage -- LIGHT DOES NOT BEND AROUND CORNERS IN v1 (a torch behind
// a wall does not light the far side)."
//
// IMPLEMENTED LITERALLY, INCLUDING THE CONSEQUENCE. There is no occlusion ray
// per light here, because §3.8's whole cost model (2M pixels x N lights)
// assumes there is not one. With no occlusion test, a torch behind a wall
// LIGHTS THE FAR SIDE -- which is leaking, not bending, and is in tension with
// §13's acceptance wording. The literal reading is what ships; the consequence
// is screenshotted; the ambiguity and the cost of the alternative are flagged
// in PHASE_7_COMPLETION.md for the owner. No per-light shadow rays were added.
//
// TASK 46 (owner Q5 (a)): that leak is now fixed by SumPointLightsShadowed
// below -- capped per-pixel occlusion rays. This function stays as the
// _TorchShadowRays == 0 path (and for tier >= 1 hits), unchanged.
//
// The loop is bounded by _ActiveLightCount, which the CPU caps at
// MAX_ACTIVE_LIGHTS -- that cap is the entire defence against §3.8's
// "per-pixel light death spiral", so the bound is load-bearing, not hygiene.
// ===========================================================================
float3 SumPointLights(float3 posM, float3 nrmF)
{
    float3 sum = float3(0.0, 0.0, 0.0);
    [loop]
    for (uint i = 0u; i < _ActiveLightCount; i++)
    {
        LightSource L = LightBuffer[i];
        float3 d = float3(L.x, L.y, L.z) - posM;
        float dist2 = dot(d, d);

        // The hard cutoff at `range` is what keeps the per-pixel cost bounded
        // in a way the 1/(1+d^2 k) falloff alone would not -- attenuation never
        // reaches zero, so without it every light would touch every pixel.
        if (dist2 > L.range * L.range) continue;

        float atten = 1.0 / (1.0 + dist2 * L.k);

        // C.9 attaches max(0, N.L) to the SUN term only and leaves pointLights
        // bare, so the literal default is 0. See the FLAG: the literal reading
        // lights faces pointing away from a torch, which reads flat.
        if (_PointLightNdotL != 0)
            atten *= max(0.0, dot(nrmF, normalize(d + 1e-6)));

        sum += float3(L.r, L.g, L.b) * atten;
    }
    return sum;
}

// ===========================================================================
// ONE COLOUR PER VOXEL (owner, 2026-09-26: "a single voxel's faces seem to be
// multicolored ... each voxel should have all the faces be the same color").
// The cause was the lighting, not the albedo (albedo was already per voxel):
// a face's light was warm sun x how much THAT face saw the sun, plus a cool
// ambient, so a sunlit side read pink and the top of the same block blue.
// With _UniformFaceHue on, a face keeps its own BRIGHTNESS but takes the
// voxel's single light HUE -- the scene's light colours (sun, moon, ambient)
// plus point lights measured at the voxel centre WITHOUT a per-face N.L. Faces
// then differ in value only, as block games shade them. -facehue 0 restores
// the old per-face colour for A/B.
// ===========================================================================
int _UniformFaceHue;

float3 SumPointLightsOmni(float3 posM)
{
    float3 sum = float3(0.0, 0.0, 0.0);
    [loop]
    for (uint i = 0u; i < _ActiveLightCount; i++)
    {
        LightSource L = LightBuffer[i];
        float3 d = float3(L.x, L.y, L.z) - posM;
        float dist2 = dot(d, d);
        if (dist2 > L.range * L.range) continue;
        sum += float3(L.r, L.g, L.b) / (1.0 + dist2 * L.k);
    }
    return sum;
}

/// faceLight's luminance, in hueSource's colour. Identity when off.
float3 UniformFaceHue(float3 faceLight, float3 hueSource)
{
    if (_UniformFaceHue == 0) return faceLight;
    const float3 W = float3(0.2126, 0.7152, 0.0722);
    float h = dot(hueSource, W);
    if (h <= 1e-5) return faceLight;
    return hueSource * (dot(faceLight, W) / h);
}

// ===========================================================================
// TORCH SHADOW RAYS (task 46, owner Q5 (a); fixes "torches shine through walls")
//
// §6.5 says "a torch behind a wall does not light the far side", but C.11 as
// first shipped had no occlusion test, so it did (the FLAG in
// PHASE_7_COMPLETION.md). This is the SVO build's capped form: each lit tier-0
// pixel traces one occlusion ray to each of its _TorchShadowRays NEAREST
// in-range lights; every other in-range light is scaled by the traced share
// (seen / traced). That keeps §3.8's bound -- the ray count per pixel is capped
// by _TorchShadowRays, not by _ActiveLightCount. 0 = no rays, the old leak.
//
// The ray is the sun shadow ray's tier-0 walk (air-mip leaps, uniform-brick
// leaps, dense micro-steps) from §6.5's origin -- the air cell in front of the
// hit face, at its centre, no bias -- to the light. It ends, VISIBLE, on
// entering the light's own voxel (a torch is solid) or passing the light; any
// solid voxel before that occludes. Leaving the tier-0 window or the step cap
// also counts as visible: the pre-task behaviour, never a black pixel.
// ===========================================================================
int _TorchShadowRays;
#define TORCH_SHADOW_MAX   8      // LightingConfig.MaxTorchShadowRays
#define TORCH_SHADOW_STEPS 256    // outer iterations; 8 m range = 80 voxels/axis

bool TorchRayBlocked(int3 fromCell, float3 lightVox, uint3 windowDimsBricks)
{
    int3 target = int3(floor(lightVox));
    int3 voxel = fromCell;
    if (all(voxel == target)) return false;

    float3 rayStart = (float3)voxel + 0.5;
    float3 toL = lightVox - rayStart;
    float tEnd = length(toL);
    float3 dir = toL / max(tEnd, 1e-6);
    dir.x = abs(dir.x) < 1e-6 ? (dir.x >= 0 ? 1e-6 : -1e-6) : dir.x;
    dir.y = abs(dir.y) < 1e-6 ? (dir.y >= 0 ? 1e-6 : -1e-6) : dir.y;
    dir.z = abs(dir.z) < 1e-6 ? (dir.z >= 0 ? 1e-6 : -1e-6) : dir.z;

    int3 step = int3(sign(dir.x), sign(dir.y), sign(dir.z));
    float3 tDelta = abs(1.0 / dir);
    float3 tMax = 0.5 * tDelta;                 // the ray starts at the cell centre
    float currentDist = 0.0;

    int3 nrm = int3(0, 0, 0);                   // the leap helpers want these; unused here
    int exitIters = 0, nonExitIters = 0;

    [loop]
    for (int it = 0; it < TORCH_SHADOW_STEPS && currentDist < tEnd; it++)
    {
        if (all(voxel == target)) return false;

        int3 brickCoord = VoxelToBrick(voxel);
        int3 rel = brickCoord - _WindowOriginBricksPacked.xyz;
        if (rel.x < 0 || rel.y < 0 || rel.z < 0 ||
            rel.x >= (int)windowDimsBricks.x ||
            rel.y >= (int)windowDimsBricks.y ||
            rel.z >= (int)windowDimsBricks.z) return false;

        bool leapt = false;
        [loop]
        for (int k = (int)_AirMipLevelCount; k >= 1; k--)
        {
            int shift = 3 + k;
            int3 cell = voxel >> shift;
            if (ReadAirMip(k, cell) == 0u)
            {
                LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart,
                                         cell << shift, 8 << k, nrm, exitIters, nonExitIters);
                leapt = true;
                break;
            }
        }
        if (leapt) continue;

        uint handle = ReadClipmap(brickCoord, windowDimsBricks);
        if ((handle & 0x80000000u) != 0u)
        {
            uint poolIdx = handle & 0x3FFFFFFFu;
            uint vIdx = (uint)LocalVoxelIndex(LocalVoxelIndex3D(voxel));
            uint packed = BrickDataBuffer[(poolIdx * 128) + (vIdx >> 2)];
            if (((packed >> ((vIdx & 3u) * 8u)) & 0xFFu) != 0u) return true;

            if (tMax.x < tMax.y)
            {
                if (tMax.x < tMax.z) { voxel.x += step.x; currentDist = tMax.x; tMax.x += tDelta.x; }
                else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; }
            }
            else
            {
                if (tMax.y < tMax.z) { voxel.y += step.y; currentDist = tMax.y; tMax.y += tDelta.y; }
                else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; }
            }
            continue;
        }

        if ((handle & 0xFFu) != 0u) return true;   // uniform solid brick

        LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart,
                                 brickCoord * 8, 8, nrm, exitIters, nonExitIters);
    }
    return false;
}

/// SumPointLights with torch shadow rays. `airCell` is the air voxel in front of
/// the hit face; `omni` returns SumPointLightsOmni(omniPosM) under the SAME
/// per-light visibility, so a hidden torch cannot tint a face's hue either.
float3 SumPointLightsShadowed(float3 posM, float3 nrmF, int3 airCell, float3 omniPosM,
                              uint3 windowDimsBricks, out float3 omni)
{
    int n = min(_TorchShadowRays, TORCH_SHADOW_MAX);
    float nearD2[TORCH_SHADOW_MAX];
    uint  nearIdx[TORCH_SHADOW_MAX];
    [unroll]
    for (int s0 = 0; s0 < TORCH_SHADOW_MAX; s0++) { nearD2[s0] = 3.0e38; nearIdx[s0] = 0xFFFFFFFFu; }

    // Pass 1: every light's unshadowed contribution, and the n nearest lights
    // that contribute anything (insertion into a sorted list of n).
    float3 total = float3(0.0, 0.0, 0.0);
    float3 omniTotal = float3(0.0, 0.0, 0.0);
    [loop]
    for (uint i = 0u; i < _ActiveLightCount; i++)
    {
        LightSource L = LightBuffer[i];
        float3 lp = float3(L.x, L.y, L.z);
        float3 lc = float3(L.r, L.g, L.b);
        float r2 = L.range * L.range;

        float3 dO = lp - omniPosM;
        float dO2 = dot(dO, dO);
        if (dO2 <= r2) omniTotal += lc / (1.0 + dO2 * L.k);

        float3 d = lp - posM;
        float dist2 = dot(d, d);
        if (dist2 > r2) continue;
        float atten = 1.0 / (1.0 + dist2 * L.k);
        if (_PointLightNdotL != 0)
            atten *= max(0.0, dot(nrmF, normalize(d + 1e-6)));
        if (atten <= 0.0) continue;
        total += lc * atten;

        float cd = dist2;
        uint ci = i;
        [unroll]
        for (int s = 0; s < TORCH_SHADOW_MAX; s++)
        {
            if (s < n && cd < nearD2[s])
            {
                float td = nearD2[s]; nearD2[s] = cd; cd = td;
                uint ti = nearIdx[s]; nearIdx[s] = ci; ci = ti;
            }
        }
    }

    // Pass 2: trace the n nearest.
    float3 vis = float3(0.0, 0.0, 0.0), tracedSum = float3(0.0, 0.0, 0.0);
    float3 omniVis = float3(0.0, 0.0, 0.0), omniTraced = float3(0.0, 0.0, 0.0);
    int traced = 0, seen = 0;
    [loop]
    for (int t = 0; t < n; t++)
    {
        uint li = nearIdx[t];
        if (li == 0xFFFFFFFFu) break;
        LightSource L = LightBuffer[li];
        float3 lp = float3(L.x, L.y, L.z);
        float3 lc = float3(L.r, L.g, L.b);

        float3 d = lp - posM;
        float atten = 1.0 / (1.0 + dot(d, d) * L.k);
        if (_PointLightNdotL != 0)
            atten *= max(0.0, dot(nrmF, normalize(d + 1e-6)));
        float3 dO = lp - omniPosM;
        float dO2 = dot(dO, dO);
        float3 oc = (dO2 <= L.range * L.range) ? lc / (1.0 + dO2 * L.k) : float3(0.0, 0.0, 0.0);

        traced++;
        tracedSum += lc * atten;
        omniTraced += oc;
        if (!TorchRayBlocked(airCell, lp * 10.0, windowDimsBricks))
        {
            seen++;
            vis += lc * atten;
            omniVis += oc;
        }
    }

    float share = traced > 0 ? (float)seen / (float)traced : 1.0;
    omni = omniVis + max(omniTotal - omniTraced, 0.0) * share;
    return vis + max(total - tracedSum, 0.0) * share;
}


// ===========================================================================
// FAR BAND -- DESIGN_LARGE_WORLD_AND_TERRAIN_OVERHAUL.md §4.2 / §2.3, STEP 1
// PROTOTYPE. A ray that leaves the voxel window without a hit no longer draws
// sky: it HANDS OFF to a heightfield march through FarField's nested toroidal
// rings (FarField.cs documents the data). Terrain is drawn as STEPPED,
// FLAT-TOPPED COLUMNS with face normals (§2.3: the far band stays blocky).
//
// With _FarEnabled == 0 nothing below runs and CSMain's behaviour is the
// shipped one: every addition in CSMain is behind that uniform.
// ===========================================================================
StructuredBuffer<uint>   FarTexels;
StructuredBuffer<uint>   FarMips;
RWStructuredBuffer<uint> FarTexelsRW;
RWStructuredBuffer<uint> FarMipsRW;
StructuredBuffer<uint>   FarStaging;
StructuredBuffer<uint>   FarResident;     // 1 bit per window chunk column (FarField.UpdateResidency)
int    _FarEnabled;       // 0 off, 1 far band, 2 far band ONLY (tg2 preview)
int    _FarShadow;
float4 _FarOrigin[5];     // .xy ring min corner (texels), unused otherwise
float4 _FarParams;        // x max top height (voxels), y haze range (voxels), z primary step cap, w shadow step cap
float  _FarPixelAngle;    // radians per pixel at screen centre; 0 = footprint level selection off (-farfootprint 0)
// TASK 24 (opt-in, -detailspeed 1; DetailRadius.cs): half-width (voxels) of the
// camera-centred XZ square inside which voxels own a ray. 0 = no square: the
// hand-over is the first non-resident chunk column, exactly as before.
#ifdef VE_DETAIL_SPEED
float  _DetailRadiusVoxels;
#define FAR_VOXEL_END_PARAM , float tVoxelEnd
#define FAR_VOXEL_END_TEST && t < tVoxelEnd
#define FAR_VOXEL_END_ARG(x) , x
#else
#define FAR_VOXEL_END_PARAM
#define FAR_VOXEL_END_TEST
#define FAR_VOXEL_END_ARG(x)
#endif
int4   _FarScatter;       // x0, z0, w, h  (texel coords of the strip)
int    _FarScatterLevel;
int    _FarMipLevel;
int    _FarMipK;

#define FAR_LEVELS 5
#define FAR_EDGE 1024
#define FAR_MASK 1023
#define FAR_LEVEL_TEXELS 1048576
#define FAR_MIPS_PER_LEVEL 349184
#define FAR_USE_RADIUS 440
#define FAR_TOP_MIP 5

int FarMipOffset(int k)
{
    if (k == 1) return 0;
    if (k == 2) return 262144;
    if (k == 3) return 327680;
    if (k == 4) return 344064;
    return 348160;
}

uint FarTexelAt(int L, int2 t)
{
    return FarTexels[L * FAR_LEVEL_TEXELS + ((t.y & FAR_MASK) << 10) + (t.x & FAR_MASK)];
}

// Max top height of cell c at mip k of level L (k == 0: the texel itself).
uint FarHeightAt(int L, int k, int2 c)
{
    if (k == 0) return FarTexelAt(L, c) & 0xFFFFu;
    int n = FAR_EDGE >> k;
    return FarMips[L * FAR_MIPS_PER_LEVEL + FarMipOffset(k) + (c.y & (n - 1)) * n + (c.x & (n - 1))];
}

float3 FarSafeDir(float3 d)
{
    d.x = abs(d.x) < 1e-6 ? (d.x >= 0 ? 1e-6 : -1e-6) : d.x;
    d.y = abs(d.y) < 1e-6 ? (d.y >= 0 ? 1e-6 : -1e-6) : d.y;
    d.z = abs(d.z) < 1e-6 ? (d.z >= 0 ? 1e-6 : -1e-6) : d.z;
    return d;
}

// Is this window-relative chunk column resident (so the voxel march owns it)?
bool FarChunkResident(int2 rc)
{
    int dx = (int)_WindowDimsChunksPacked.x, dz = (int)_WindowDimsChunksPacked.z;
    if (rc.x < 0 || rc.y < 0 || rc.x >= dx || rc.y >= dz) return false;
    uint i = (uint)(rc.y * dx + rc.x);
    return ((FarResident[i >> 5] >> (i & 31u)) & 1u) != 0u;
}

// Where the far band must take over a ray the voxel march missed: the first
// point, before tLimit, at which the ray enters a NON-resident chunk column of
// the window (the voxel march saw such columns as air). 2D DDA over chunk
// columns, at most ~64 cells for a 32x32 window. Returns tLimit if none.
// The cell is stepped as an INTEGER (Amanatides-Woo), never re-derived from a
// float point: at x ~ 40000 a float step (0.0039) is wider than a fixed t
// nudge moves the point, so floor() returned the same chunk after a -x/-z
// face and the walk stalled to its cap (task 19, the coast black bar).
float FarStartT(float3 O, float3 D, float tLimit)
{
    D = FarSafeDir(D);
    int2 oc = _WindowOriginBricksPacked.xz >> 4;
    int2 dims = int2(_WindowDimsChunksPacked.xz);
    float2 wmin = float2(oc * 128);
    float2 wmax = wmin + float2(dims * 128);
    float2 invD = 1.0 / D.xz;
    float2 ta = (wmin - O.xz) * invD, tb = (wmax - O.xz) * invD;
    float2 tlo = min(ta, tb), thi = max(ta, tb);
    float t0 = max(max(tlo.x, tlo.y), 0.0);
    float t1 = min(min(thi.x, thi.y), tLimit);
    if (t0 >= t1) return tLimit;
    int2 rc = clamp(int2(floor((O.xz + D.xz * t0) / 128.0)) - oc, int2(0, 0), dims - 1);
    int2 s = int2(D.x > 0.0 ? 1 : -1, D.z > 0.0 ? 1 : -1);
    float tEnter = t0;
    [loop]
    for (int i = 0; i < 96; i++)
    {
        if (!FarChunkResident(rc)) return tEnter;
        float2 bmin = float2((rc + oc) * 128);
        float2 bmax = bmin + 128.0;
        float2 tE = (float2(s.x > 0 ? bmax.x : bmin.x, s.y > 0 ? bmax.y : bmin.y) - O.xz) * invD;
        if (tE.x < tE.y) { tEnter = tE.x; rc.x += s.x; }
        else             { tEnter = tE.y; rc.y += s.y; }
        // Leaving the window is not entering a non-resident column of it.
        if (tEnter >= t1 || any(rc < 0) || any(rc >= dims)) return tLimit;
    }
    return tLimit;
}

// FAR WALL ROCK (2026-10-01): a far column stores ONE surface material, so a
// side face more than FAR_WALL_LIP voxels below the top would be drawn in the
// surface's colour (grass/snow streaks down cliffs). Below the soil every
// biome's rock is its layer-0 STONE (DetailField.BiomeRock(biome, 0)), so map
// the surface material to that. Engine ids = TG2_BASE (128) + GenMat; a
// material that is not a soil/cover keeps itself.
#define FAR_WALL_LIP 15.0
uint FarWallMaterial(uint fm)
{
    switch (fm)
    {
        case 138u: case 148u: return 161u;   // Grass, Loam            -> Granite
        case 140u: case 149u: return 170u;   // Sand, PackedSand       -> OrangeSandstone
        case 141u: case 150u: return 182u;   // Snow, PackedIce        -> SilverSchist
        case 139u: case 151u: return 188u;   // JungleGrass, Mud       -> KarstLimestone
    }
    return fm;
}

struct FarHit
{
    bool  hit;
    float t;
    int3  normal;
    uint  texel;
    int   level;
    int2  cell;
    int   steps;
};

// Hierarchical 2D DDA over the max-height mips. Level chosen per step by the
// point's Chebyshev distance from the CAMERA (the rings are camera-centred), so
// a shadow ray uses the same data a primary ray would at that place.
// skipWindow: ignore columns inside the voxel window's XZ footprint -- the voxel
// march already owns them (window edges are chunk-aligned, so a texel of any
// level is wholly in or wholly out).
// fpBase: the camera distance (voxels) of the ray's ORIGIN -- 0 for a primary
// ray, the hit's distance for a far shadow ray -- so the footprint level
// follows the camera distance of every sample, as the near cascade's 8.2 rule.
// tVoxelEnd (task 24, VE_DETAIL_SPEED only): the voxel march owns a resident
// column only at t below this (the detail square's exit); 3.0e38 = everywhere.
FarHit FarMarch(float3 O, float3 D, float tStart, int stepCap, bool skipWindow, float fpBase FAR_VOXEL_END_PARAM)
{
    FarHit r;
    r.hit = false; r.t = 0.0; r.normal = int3(0, 1, 0); r.texel = 0u; r.level = 0; r.cell = int2(0, 0); r.steps = 0;

    float2 camV = _CameraPos.xz * 10.0;
    int3 wMin = _WindowOriginBricksPacked.xyz * 8;
    int3 wMax = wMin + int3(_WindowDimsBricksPacked.xyz) * 8;
    float maxH = _FarParams.x;
    float2 invD = 1.0 / D.xz;
    float t = max(tStart, 0.0);
    int L = 0;
    int k = FAR_TOP_MIP;

    [loop]
    while (r.steps < stepCap)
    {
        float3 p = O + D * t;
        if (D.y >= 0.0 && p.y >= maxH) break;                       // above everything, climbing
        float cheb = max(abs(p.x - camV.x), abs(p.z - camV.y));
        [loop] while (L < FAR_LEVELS - 1 && cheb >= (float)(FAR_USE_RADIUS * (8 << L))) L++;
        if (cheb >= (float)(FAR_USE_RADIUS * (8 << L))) break;     // past the outermost ring
        // PIXEL FOOTPRINT (2026-09-25): never use a level whose texel is smaller
        // than one pixel at this camera distance. Choosing by horizontal
        // distance alone drew 0.8 m texels straight below a 1 km camera, where a
        // pixel spans ~2 m: point-sampled sub-pixel texels, i.e. shimmer. A
        // coarser ring always contains the finer ring's footprint, so raising L
        // is always legal. k (mip) is kept; it is capped per level anyway.
        if (_FarPixelAngle > 0.0)
        {
            float fp = (fpBase + t) * _FarPixelAngle;
            [loop] while (L < FAR_LEVELS - 1 && (float)(8 << L) < fp) L++;
        }

        int tv = 8 << L;
        int cs = tv << k;
        int2 c = int2(floor(p.xz / (float)cs));
        float2 bmin = float2(c * cs);
        float2 bmax = bmin + (float)cs;
        float2 tEx = (float2(D.x > 0.0 ? bmax.x : bmin.x, D.z > 0.0 ? bmax.y : bmin.y) - O.xz) * invD;
        float tExit = max(min(tEx.x, tEx.y), t);
        float y0 = O.y + D.y * t;
        float y1 = O.y + D.y * tExit;
        float H = (float)FarHeightAt(L, k, c);
        r.steps++;

        if (min(y0, y1) >= H)
        {
            // Clear: step into the next cell; climb one mip when leaving the parent.
            float tn = tExit + 1e-3 * (float)cs;
            int2 cn = int2(floor((O.xz + D.xz * tn) / (float)cs));
            if (k < FAR_TOP_MIP && any((cn >> 1) != (c >> 1))) k++;
            t = tn;
            continue;
        }
        if (k > 0) { k--; continue; }

        // V2: the voxel march owns a resident column only INSIDE the loaded
        // band [_ContentFloorVoxelY, _ContentCeilingVoxelY). A surface above or
        // below the band (a valley floor under a summit, a cliff over a
        // canyon) is the far band's. Flat worlds: the band is [0, 128), which
        // holds every surface, so this is the old rule exactly.
        float hitY = (y0 <= H) ? y0 : H;
        if (skipWindow && hitY >= (float)_ContentFloorVoxelY && hitY < (float)_ContentCeilingVoxelY
                       && c.x * tv >= wMin.x && (c.x + 1) * tv <= wMax.x
                       && c.y * tv >= wMin.z && (c.y + 1) * tv <= wMax.z
                       && FarChunkResident(((c * tv) >> 7) - (wMin.xz >> 7))
                       FAR_VOXEL_END_TEST)
        {
            t = tExit + 1e-3 * (float)cs;
            continue;
        }

        r.hit = true; r.level = L; r.cell = c; r.texel = FarTexelAt(L, c);
        if (y0 <= H)
        {
            // Entered through a side face: the axis whose slab was crossed last.
            float2 tEn = (float2(D.x > 0.0 ? bmin.x : bmax.x, D.z > 0.0 ? bmin.y : bmax.y) - O.xz) * invD;
            r.t = t;
            r.normal = (tEn.x > tEn.y) ? int3(D.x > 0.0 ? -1 : 1, 0, 0) : int3(0, 0, D.z > 0.0 ? -1 : 1);
        }
        else
        {
            r.t = t + (y0 - H) / (-D.y);
            r.normal = int3(0, 1, 0);
        }
        break;
    }
    return r;
}

// Distance haze, one curve for both bands when the far band is on (the old
// (d/290m)^2 curve saturates at the window edge, which is exactly the cutoff the
// far band exists to remove). Off: the shipped curve, unchanged.
// With the far band on, the haze is EXPONENTIAL-HEIGHT fog integrated along the
// ray (scale height FAR_HAZE_SCALE_HEIGHT above sea), so a view down from 3 km
// through thin air stays clear while a grazing view along the ground hazes as
// before. y0/y1 are the segment's end heights in voxels.
#define FAR_HAZE_SCALE_HEIGHT 3500.0
float HazeAmount(float distVoxels, float y0, float y1)
{
    if (_FarEnabled != 0)
    {
        float a = max(y0 - 23.0, 0.0) / FAR_HAZE_SCALE_HEIGHT;
        float b = max(y1 - 23.0, 0.0) / FAR_HAZE_SCALE_HEIGHT;
        float avg = (abs(b - a) < 1e-3) ? exp(-a) : (exp(-a) - exp(-b)) / (b - a);
        return saturate(1.0 - exp(-distVoxels * avg * _LookHazeDensity / max(1.0, _FarParams.y)));
    }
    float range = (_MaxRayDistance > 0.0) ? _MaxRayDistance : 1280.0;
    float d = saturate(distVoxels / range);
    return saturate(d * d * _LookHazeDensity);
}

void CSMainBody(uint3 tid, uint3 gtid, bool checker)
{
    // The pixel this thread traces. Without the checkerboard it IS the thread id.
    uint3 id = tid;
    if (checker) id.x = tid.x * 2u + ((tid.y + _TaaCheckerParity) & 1u);
    uint3 _WindowDimsBricks = _WindowDimsBricksPacked.xyz;
    int _DebugMode = _DebugModePacked.x;

    uint width, height;
    ResultTexture.GetDimensions(width, height);

    // NO EARLY RETURN. This was `if (id.x >= width || id.y >= height) return;`
    // and it cannot stay: the §6.5 8.4 group guard below uses
    // GroupMemoryBarrierWithGroupSync, which is undefined unless EVERY thread in
    // the group reaches it. A returned thread never does.
    //
    // Out-of-bounds threads now traverse and simply do not write. The waste is
    // bounded and small: the dispatch is ceil(w/8) x ceil(h/8), so at the
    // shipped 960x540 gate it is 4 rows of 960 threads out of 2,073,600
    // (0.185%), and at 1920x1080 both dimensions divide by 8 exactly (0.000%).
    bool inBounds = (id.x < width && id.y < height);
    uint lane = gtid.y * 8u + gtid.x;

    bool isDebugPixel = (id.x == _DebugPixel.x && id.y == _DebugPixel.y);

    float2 uv = float2((id.x + 0.5) / width, (id.y + 0.5) / height) * 2.0 - 1.0;
    if (_TaaEnabled != 0) uv = float2((id.x + 0.5 + _TaaJitter.x) / width, (id.y + 0.5 + _TaaJitter.y) / height) * 2.0 - 1.0;
    float4 target = mul(_CameraInverseProjection, float4(uv.x, uv.y, 1, 1));
    float3 rayDir = mul(_CameraInverseView, float4(normalize(target.xyz / target.w), 0)).xyz;

    rayDir.x = abs(rayDir.x) < 1e-6 ? (rayDir.x >= 0 ? 1e-6 : -1e-6) : rayDir.x;
    rayDir.y = abs(rayDir.y) < 1e-6 ? (rayDir.y >= 0 ? 1e-6 : -1e-6) : rayDir.y;
    rayDir.z = abs(rayDir.z) < 1e-6 ? (rayDir.z >= 0 ? 1e-6 : -1e-6) : rayDir.z;

    float3 rayStart = _CameraPos * 10.0;

    int3 step = int3(sign(rayDir.x), sign(rayDir.y), sign(rayDir.z));
    float3 tDelta = abs(1.0 / rayDir);

    int3 voxel = WorldToVoxel(_CameraPos);

    float3 tMax = float3(
        step.x > 0 ? (voxel.x + 1.0 - rayStart.x) : (rayStart.x - voxel.x),
        step.y > 0 ? (voxel.y + 1.0 - rayStart.y) : (rayStart.y - voxel.y),
        step.z > 0 ? (voxel.z + 1.0 - rayStart.z) : (rayStart.z - voxel.z)
    ) * tDelta;

    float currentDist = 0;
    int steps = 0;
    bool hit = false;
    uint mat = 0;
    int3 normal = 0;
    bool lastWasDense = false;
    int tierAtHit = 0;

    int exitIters = 0;
    int nonExitIters = 0;
    int chainLeapsTotal = 0;
    int denseMicroSteps = 0;
    int mipProbeCalls = 0;

    if (isDebugPixel)
    {
        DebugOut[0] = rayDir.x; DebugOut[1] = rayDir.y; DebugOut[2] = rayDir.z;
        DebugOut[3] = tDelta.x; DebugOut[4] = tDelta.y; DebugOut[5] = tDelta.z;
    }

    // With cascade OFF (default), _TierOuterRangeVoxels is irrelevant and
    // maxDist behaves exactly as before. With cascade ON, RaymarchFeature
    // sets _MaxRayDistance to _TierOuterRangeVoxels.z itself (the tier-2
    // outer bound), so this line doesn't need its own branch - it already
    // picks up the cascade's true travel limit via the same field.
    float maxDist = (_MaxRayDistance > 0.0) ? _MaxRayDistance : 1280.0;
    int _iterCap = (_MaxOuterIterations > 0) ? _MaxOuterIterations : 400;

    // TASK 66b: the material this ray passes through -- air (0) as always, or
    // the fluid the eye is in. Past the distance where the fluid has absorbed
    // 98% of every channel nothing can show, so the march stops there (water
    // 17.8 m): the eye-in-fluid path never leaves tier 0's near range.
    uint passMat = 0u;
    float fluidTopY = 0.0;   // voxels: where the fluid above the eye ends (the light comes down from there)
    if (_UnderwaterView != 0)
    {
        uint eyeMat = VoxelMaterialAt(voxel, _WindowDimsBricks);
        if (MaterialIsClearFluid(eyeMat))
        {
            passMat = eyeMat;
            fluidTopY = (float)FluidTopAbove(voxel, eyeMat, _WindowDimsBricks);
            float3 ext = FluidExtinction(eyeMat);
            maxDist = min(maxDist, 39.12 / min(ext.x, min(ext.y, ext.z)));   // ln(50) m x 10 voxels/m
        }
    }

    // ---- FAR BAND: a camera OUTSIDE the voxel window (above its 51.2 m
    // ceiling, say) used to lose every ray at the bounds guard on iteration 1:
    // a black/sky screen. With the far band on, advance the ray to the window's
    // entry face instead (§4.3's named fix), or skip the voxel march entirely
    // when the ray never enters the window -- the far march then owns it.
    // _FarEnabled == 2 is the -farsource tg2 PREVIEW: the rings hold the new
    // generator's island while the voxel window still holds today's world, so
    // the far band draws everything and the voxel march is skipped.
    bool skipVoxel = (_FarEnabled == 2);
    if (_FarEnabled == 1)
    {
        float3 wMinF = float3(_WindowOriginBricksPacked.xyz * 8);
        float3 wMaxF = wMinF + float3(_WindowDimsBricks * 8u);
        bool camInside = all(rayStart >= wMinF) && all(rayStart < wMaxF);
        if (!camInside)
        {
            float3 invR = 1.0 / rayDir;
            float3 ta = (wMinF - rayStart) * invR;
            float3 tb = (wMaxF - rayStart) * invR;
            float3 tlo = min(ta, tb);
            float3 thi = max(ta, tb);
            float tEnter = max(max(tlo.x, tlo.y), tlo.z);
            float tLeave = min(min(thi.x, thi.y), thi.z);
            if (tLeave <= max(tEnter, 0.0)) skipVoxel = true;
            else
            {
                float te = max(tEnter, 0.0) + 1e-3;
                float3 pe = rayStart + rayDir * te;
                voxel = clamp(int3(floor(pe)), int3(wMinF), int3(wMaxF) - 1);
                tMax = float3(ReseedTMaxAxis(voxel.x, rayStart.x, tDelta.x, step.x),
                              ReseedTMaxAxis(voxel.y, rayStart.y, tDelta.y, step.y),
                              ReseedTMaxAxis(voxel.z, rayStart.z, tDelta.z, step.z));
                currentDist = te;
                normal = (tlo.x >= tlo.y && tlo.x >= tlo.z) ? int3(-step.x, 0, 0)
                       : (tlo.y >= tlo.z ? int3(0, -step.y, 0) : int3(0, 0, -step.z));
                maxDist += te;
            }
        }
    }

#ifdef VE_DETAIL_SPEED
    // TASK 24: with the detail square on, the voxel march ends where the ray
    // leaves it (the camera is its centre, so t = R / max|D.xz|), and the far
    // band owns everything beyond. 0: tDetail is unbounded, nothing changes.
    float tDetail = 3.0e38;
    if (_FarEnabled == 1 && _DetailRadiusVoxels > 0.0)
    {
        tDetail = _DetailRadiusVoxels / max(abs(rayDir.x), abs(rayDir.z));
        maxDist = min(maxDist, tDetail);
    }
#endif

    while (!skipVoxel && currentDist < maxDist && steps < _iterCap)
    {
        // EARLY-EXIT (new, added after real diagnostic data - see chat).
        // Phase2Bootstrapper only EVER generates chunks at cy=0 (world Y in
        // [0, 12.8m) = raw voxel Y in [0, 128)). If the ray is already
        // outside that range and moving FURTHER away (not toward it), every
        // remaining voxel it could ever reach is guaranteed unloaded -
        // ChunkStore.GetVoxel treats a null chunk as air unconditionally.
        // This is not a probabilistic/height-derived bound (which would risk
        // being wrong the way guessed constants have been elsewhere this
        // session) - it's the hard, structural fact of what chunks could
        // possibly exist, so this can never skip a real hit, only a
        // guaranteed miss. StepHeat/LODTierView/UniformDenseView at
        // GroundHorizon showed the cascade's actual dominant added cost is
        // exactly this case: no-hit sky rays now walking to the tier-2 outer
        // bound (290m) instead of the old 128m constant, with nothing to
        // make that walk cheap. This fixes the ROOT case, tier-independent -
        // it fires before tier selection even runs, so it benefits cascade
        // on AND off alike (proportionally far more when cascade is on,
        // given the much longer old maxDist).
        // ASSUMPTION, FLAGGED: breaks if Phase2Bootstrapper ever generates
        // more than cy=0 - the 128 below would need to become the true
        // loaded ceiling instead of this one hardcoded layer's height.
                // ---- CONTENT-CEILING EARLY EXIT (Phase 3, now config-driven) ----
        // Unchanged in behaviour; the hardcoded 128 is now _ContentCeilingVoxelY,
        // set from (MAX_GENERATED_CHUNK_Y+1)*128. Its own Phase 3 comment
        // flagged the constant as an assumption that breaks the moment anything
        // outside cy=0 generates. It stays SEPARATE from, and tighter than, the
        // window bounds test below -- see _ContentCeilingVoxelY's declaration.
        if ((voxel.y >= _ContentCeilingVoxelY && step.y > 0) || (voxel.y < _ContentFloorVoxelY && step.y < 0))
        {
            hit = false;
            break;
        }

        // ---- RESIDENT WINDOW BOUNDS (Phase 4: origin-relative, 3 axes) ----
        // ReadClipmap/ReadClipmapTier mask toroidally with no bounds check, so
        // anything outside the window aliases silently back inside -- the
        // phantom-terrain bug of PHASE_3_COMPLETION.md §6.2. Leaving the window
        // means "no data", which must TERMINATE the ray, never alias into it.
        //
        // ONE guard covers all three tiers. Tiers 1 and 2 cover the same
        // spatial volume as tier 0, sampled coarser, so a voxel inside the
        // tier-0 window is inside theirs by construction. No per-tier origin
        // uniforms are needed and there is deliberately only one bounds site.
        //
        // Placement matters: this must stay the FIRST thing in the loop body,
        // ahead of every clipmap and air-mip read. The tier-1/2 chain loop
        // further down re-reads ReadClipmapTier up to MAX_CHAIN_LEAPS times
        // without re-testing bounds; that is safe ONLY because every exit from
        // that loop returns here before anything is drawn, and because the loop
        // breaks on both dense and uniform-solid handles without setting `hit`.
        {
            int3 rel = VoxelToBrick(voxel) - _WindowOriginBricksPacked.xyz;
            if (rel.x < 0 || rel.y < 0 || rel.z < 0 ||
                rel.x >= (int)_WindowDimsBricks.x ||
                rel.y >= (int)_WindowDimsBricks.y ||
                rel.z >= (int)_WindowDimsBricks.z)
            {
                hit = false;
                break;
            }
        }

        steps++;
        mipProbeCalls++;

        // Tier selection: 0 unless cascade is on AND currentDist has passed
        // that tier's own outer bound. Forced to 0 whenever _UseLODCascade==0,
        // so every line inside "if (tier == 0)" below is reached exactly as
        // it always was - this is the one and only new branch point tier-0
        // rays pass through, and it's a single cheap comparison.
        // NOTE THE ARGUMENT. For a PRIMARY ray, `currentDist` IS the distance
        // from the camera -- the ray started there. That equality is why the
        // old inline form was correct here and is NOT correct for a shadow ray,
        // which starts at a surface; see SelectLODTier's header. Behaviour at
        // this call site is unchanged, byte for byte.
        int tier = (passMat != 0u) ? 0 : SelectLODTier(currentDist);   // 66b: 0 when passMat == 0u is unchanged

        if (tier == 0)
        {
            // ===================================================================
            // TIER 0 PATH - UNCHANGED from the pre-cascade file. Nothing in this
            // block was touched; it's reproduced verbatim so tier-0-only rays
            // (or any ray when _UseLODCascade==0) get byte-identical behavior.
            // ===================================================================
            bool leapt = false;
            // 66b: inside a fluid an all-air cell is a STOP (the surface), never a leap.
            [loop]
            for (int k = (passMat == 0u) ? (int)_AirMipLevelCount : 0; k >= 1; k--)
            {
                int shift = 3 + k;
                int3 cell = voxel >> shift;
                if (ReadAirMip(k, cell) == 0u)
                {
                    int spanVoxels = 8 << k;
                    int3 spanMin = cell << shift;

                    if (_TraversalMode == 0)
                        LeapSpan(voxel, tMax, currentDist, tDelta, step, spanMin, spanVoxels, normal, exitIters, nonExitIters);
                    else if (_TraversalMode == 3 || _TraversalMode == 4)
                        LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart, spanMin, spanVoxels, normal, exitIters, nonExitIters);
                    else
                        LeapSpanReseed(voxel, tMax, currentDist, tDelta, step, rayStart, spanMin, spanVoxels, normal, exitIters, nonExitIters);

                    if (_TraversalMode == 2)
                    {
                        int chainCount = 0;
                        [loop]
                        while (chainCount < MAX_CHAIN_LEAPS)
                        {
                            int3 newCell = voxel >> shift;
                            if (ReadAirMip(k, newCell) != 0u) break;

                            int3 newSpanMin = newCell << shift;
                            LeapSpanReseed(voxel, tMax, currentDist, tDelta, step, rayStart, newSpanMin, spanVoxels, normal, exitIters, nonExitIters);
                            chainCount++;
                            chainLeapsTotal++;
                        }
                    }

                    leapt = true;
                    break;
                }
            }
            if (leapt) continue;

            int3 brickCoord = VoxelToBrick(voxel);
            uint handle = ReadClipmap(brickCoord, _WindowDimsBricks);
            bool isDense = (handle & 0x80000000) != 0;

            if (isDense)
            {
                uint poolIdx = handle & 0x3FFFFFFF;

                if (_TraversalMode == 4)
                {
                    [loop]
                    while (currentDist < maxDist && steps < _iterCap)
                    {
                        int3 localVoxel = LocalVoxelIndex3D(voxel);
                        uint vIdx = (uint)LocalVoxelIndex(localVoxel);
                        uint packedData = BrickDataBuffer[(poolIdx * 128) + (vIdx >> 2)];
                        uint pShift = (vIdx & 3) * 8;
                        mat = (packedData >> pShift) & 0xFF;

                        if (mat != passMat) { hit = true; lastWasDense = true; break; }

                        denseMicroSteps++;
                        steps++;

                        if (tMax.x < tMax.y)
                        {
                            if (tMax.x < tMax.z) { voxel.x += step.x; currentDist = tMax.x; tMax.x += tDelta.x; normal = int3(-step.x, 0, 0); }
                            else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; normal = int3(0, 0, -step.z); }
                        }
                        else
                        {
                            if (tMax.y < tMax.z) { voxel.y += step.y; currentDist = tMax.y; tMax.y += tDelta.y; normal = int3(0, -step.y, 0); }
                            else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; normal = int3(0, 0, -step.z); }
                        }

                        if (!all(VoxelToBrick(voxel) == brickCoord)) break;
                    }
                    if (hit) { tierAtHit = 0; break; }
                    continue;
                }

                int3 localVoxel2 = LocalVoxelIndex3D(voxel);
                uint vIdx2 = (uint)LocalVoxelIndex(localVoxel2);
                uint packedData2 = BrickDataBuffer[(poolIdx * 128) + (vIdx2 >> 2)];
                uint shift2 = (vIdx2 & 3) * 8;
                mat = (packedData2 >> shift2) & 0xFF;

                if (mat != passMat) { hit = true; lastWasDense = true; tierAtHit = 0; break; }

                denseMicroSteps++;
                if (tMax.x < tMax.y)
                {
                    if (tMax.x < tMax.z) { voxel.x += step.x; currentDist = tMax.x; tMax.x += tDelta.x; normal = int3(-step.x, 0, 0); }
                    else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; normal = int3(0, 0, -step.z); }
                }
                else
                {
                    if (tMax.y < tMax.z) { voxel.y += step.y; currentDist = tMax.y; tMax.y += tDelta.y; normal = int3(0, -step.y, 0); }
                    else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; normal = int3(0, 0, -step.z); }
                }
                continue;
            }

            mat = handle & 0xFF;
            if (mat != passMat) { hit = true; lastWasDense = false; tierAtHit = 0; break; }

            {
                int3 bMin = brickCoord * 8;
                if (_TraversalMode == 0)
                    LeapSpan(voxel, tMax, currentDist, tDelta, step, bMin, 8, normal, exitIters, nonExitIters);
                else if (_TraversalMode == 3 || _TraversalMode == 4)
                    LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart, bMin, 8, normal, exitIters, nonExitIters);
                else
                    LeapSpanReseed(voxel, tMax, currentDist, tDelta, step, rayStart, bMin, 8, normal, exitIters, nonExitIters);
            }
        }
        else
        {
            // ===================================================================
            // TIER 1 / TIER 2 PATH - new. Only reached when _UseLODCascade!=0
            // AND currentDist has already passed tier 0's (and possibly tier
            // 1's) outer bound. No air-mip pyramid exists for these tiers yet
            // (deliberate scope cut for this pass - flagged in the file header
            // and in chat) - empty coarse bricks are skipped one brick at a
            // time via LeapSpanReseedClosedForm instead, same as tier 0's own
            // non-air-mip brick-skip fallback below.
            // ===================================================================
            int tierShift = TierShift(tier); // 1 for tier1, 2 for tier2

            int3 tierVoxel = voxel >> tierShift;
            int3 tierBrickCoord = tierVoxel >> 3;

            uint handle = ReadClipmapTier(tier, tierBrickCoord);
            bool isDense = (handle & 0x80000000) != 0;

            if (isDense)
            {
                uint poolIdx = handle & 0x3FFFFFFF;
                int3 localTierVoxel = tierVoxel & 7;
                uint vIdx = (uint)LocalVoxelIndex(localTierVoxel);
                uint packedData = ReadBrickDataTier(tier, poolIdx, vIdx >> 2);
                uint pShift = (vIdx & 3) * 8;
                mat = (packedData >> pShift) & 0xFF;

                if (mat != passMat) { hit = true; lastWasDense = true; tierAtHit = tier; break; }

                // FIX (measured, not guessed): this used to single-step one RAW
                // voxel at a time even though a coarse voxel here spans `factor`
                // (1<<tierShift) raw voxels, all sharing this SAME sampled byte -
                // exactly the "up to 4 iterations, not 1" cost the file header
                // already predicted, now confirmed by a real benchmark (cascade
                // ON measured ~83% SLOWER than cascade OFF at the same pose -
                // see chat). Since every raw voxel within this one coarse voxel
                // is provably the same material (that's what "dense body, one
                // byte per coarse voxel" means), an air coarse voxel (mat==0,
                // this branch) can be leapt in full using the SAME proven
                // LeapSpanReseedClosedForm the empty-brick case below already
                // uses - just with a span of ONE coarse voxel (`factor` raw
                // voxels) instead of one whole brick (8 coarse voxels). No new
                // math, same reused primitive, smaller span.
                {
                    int3 coarseVoxelMinRaw = tierVoxel << tierShift;
                    int coarseVoxelSpanRaw = 1 << tierShift; // = factor: 2 (tier1) or 4 (tier2)
                    LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart, coarseVoxelMinRaw, coarseVoxelSpanRaw, normal, exitIters, nonExitIters);
                    denseMicroSteps++;
                }
                continue;
            }

            mat = handle & 0xFF;
            if (mat != passMat) { hit = true; lastWasDense = false; tierAtHit = tier; break; }

            // Empty coarse brick: leap its full span using the SAME, UNCHANGED
            // LeapSpanReseedClosedForm tier-0 already uses - just with the span
            // converted back to raw voxel units (8 coarse voxels * factor raw
            // voxels each).
            {
                int3 bMinRaw = (tierBrickCoord * 8) << tierShift;
                int spanVoxelsRaw = 8 << tierShift;
                LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart, bMinRaw, spanVoxelsRaw, normal, exitIters, nonExitIters);

                // FIX (measured, not guessed - see chat): the prior fix to the
                // dense-voxel-stepping cost barely moved the cascade's overall
                // slowdown (+82.7% -> +77.9%), which means it wasn't the
                // dominant cost at this pose. This is: tiers 1/2 still have no
                // air-mip-equivalent pyramid, so a long empty run gets crossed
                // one brick at a time, each requiring the outer loop to fully
                // re-derive `tier` and re-probe from scratch. Chains ADDITIONAL
                // same-tier empty-brick leaps within this one outer iteration
                // instead - the exact same pattern tier 0's own _TraversalMode
                // == 2 chaining already uses above (MAX_CHAIN_LEAPS), applied
                // here for the first time. Every chained leap re-reads and
                // re-verifies the next brick's handle before leaping it - this
                // is not assuming consecutive bricks are empty, it's confirming
                // each one exactly as the single-leap path already did, just
                // without returning to the outer while loop between them.
                int tierChainCount = 0;
                [loop]
                while (tierChainCount < MAX_CHAIN_LEAPS)
                {
                    // Stop chaining the moment the ray leaves THIS tier's own
                    // distance range - let the outer loop's tier-selection
                    // logic run fresh rather than reading this tier's buffers
                    // past where they're valid.
                    bool stillInThisTier = (tier == 1)
                        ? (currentDist < _TierOuterRangeVoxels.y)
                        : (currentDist < _TierOuterRangeVoxels.z);
                    if (!stillInThisTier) break;

                    int3 nextTierVoxel = voxel >> tierShift;
                    int3 nextTierBrickCoord = nextTierVoxel >> 3;
                    uint nextHandle = ReadClipmapTier(tier, nextTierBrickCoord);

                    if ((nextHandle & 0x80000000) != 0) break; // dense - let the outer loop handle it
                    if ((nextHandle & 0xFF) != 0) break;        // uniform solid - let the outer loop resolve the hit

                    int3 nextBMinRaw = (nextTierBrickCoord * 8) << tierShift;
                    LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart, nextBMinRaw, spanVoxelsRaw, normal, exitIters, nonExitIters);
                    tierChainCount++;
                    chainLeapsTotal++;
                }
            }
        }
    }

    if (isDebugPixel)
    {
        DebugOut[7] = (float)steps;
        DebugOut[8] = (float)(exitIters + nonExitIters);
        DebugOut[9] = (float)exitIters;
        DebugOut[10] = (float)nonExitIters;
        DebugOut[11] = (float)_TraversalMode;
        DebugOut[12] = (float)chainLeapsTotal;
        DebugOut[13] = (float)denseMicroSteps;
        DebugOut[14] = (float)mipProbeCalls;
        DebugOut[15] = (float)_UsePackedMips;
        DebugOut[16] = maxDist;
        DebugOut[17] = (float)tierAtHit;
        DebugOut[18] = (float)_UseLODCascade;
        // NEW: currentDist at the point the loop exited (hit or maxDist),
        // in RAW VOXEL units (meters * 10) - same units as maxDist/tier
        // boundaries elsewhere in this file. Added specifically to answer
        // "how far away is the pixel that spiked in the diagnostic scan" -
        // see chat - without it, distance had to be estimated from camera
        // geometry instead of measured directly.
        DebugOut[19] = currentDist;
    }

    // ---- FAR BAND HAND-OFF (see the FAR BAND block above CSMain) ----
    FarHit fh;
    fh.hit = false; fh.t = 0.0; fh.normal = int3(0, 1, 0); fh.texel = 0u; fh.level = 0; fh.cell = int2(0, 0); fh.steps = 0;
    bool farHit = false;
    float farSunVis = 1.0;
    int farShadowSteps = 0;
    float tFarDbg = -1.0;   // task 19 probe only
#ifdef VE_DETAIL_SPEED
    // TASK 24: a leap or brick step can overshoot maxDist by a little; a voxel
    // hit entered past the detail square is the far band's.
    if (hit && currentDist > tDetail) hit = false;
    float tVoxelLimit = min(currentDist, tDetail);
#else
    float tVoxelLimit = currentDist;
#endif
    if (_FarEnabled != 0 && !hit && passMat == 0u)   // 66b: under a fluid the far band is fogged out anyway
    {
        float tFar = (_FarEnabled == 2) ? 0.0 : FarStartT(rayStart, rayDir, skipVoxel ? 0.0 : tVoxelLimit);
        if (skipVoxel && _FarEnabled == 1) tFar = 0.0;
        tFarDbg = tFar;
        fh = FarMarch(rayStart, rayDir, tFar, (int)_FarParams.z, _FarEnabled == 1, 0.0 FAR_VOXEL_END_ARG(tDetail));
        farHit = fh.hit;
        if (farHit && _SunDir.y > 0.0 && _FarShadow != 0 && _ShadowQualityLevel < 3)
        {
            float3 hp = rayStart + rayDir * fh.t + float3(fh.normal) * 0.05;
            FarHit fs = FarMarch(hp, FarSafeDir(normalize(_SunDir)), 0.0, (int)_FarParams.w, false, fh.t FAR_VOXEL_END_ARG(3.0e38));
            farSunVis = fs.hit ? 0.0 : 1.0;
            farShadowSteps = fs.steps;
        }
        if (_CollectShadowStats != 0)
        {
            InterlockedAdd(ShadowStats[5], 1u);
            InterlockedAdd(ShadowStats[6], (uint)(fh.steps + farShadowSteps));
            if (farHit) InterlockedAdd(ShadowStats[7], 1u);
        }
    }
    // TASK 19 (2026-10-04, DIAGNOSTIC ONLY): the far hand-off at the ONE debug
    // pixel (the coast black bar). Writes DebugOut 46-87 and nothing else; no
    // other pixel's state or shading is touched. Read by -coastprobe.
    if (isDebugPixel)
    {
        DebugOut[46] = currentDist;
        DebugOut[47] = (float)steps;
        DebugOut[48] = maxDist;
        DebugOut[49] = tFarDbg;                     // FarStartT's result as used (-1: far not run)
        DebugOut[50] = fh.t;
        DebugOut[51] = (float)fh.normal.x; DebugOut[52] = (float)fh.normal.y; DebugOut[53] = (float)fh.normal.z;
        DebugOut[54] = (float)fh.level;
        DebugOut[55] = fh.hit ? 1.0 : 0.0;
        DebugOut[56] = (float)fh.steps;
        DebugOut[57] = hit ? 1.0 : 0.0;
        DebugOut[58] = skipVoxel ? 1.0 : 0.0;
        DebugOut[59] = (float)_FarEnabled;
        DebugOut[60] = rayStart.y + rayDir.y * max(tFarDbg, 0.0);   // ray height at the far start
        DebugOut[61] = (float)(fh.texel & 0xFFFFu);                 // hit texel's top
        DebugOut[62] = (float)fh.cell.x; DebugOut[63] = (float)fh.cell.y;
        // The strip column this ray crosses, 3 chunk rows in from the window's
        // far edge along the view (+z: row dims.z-3 = z chunk 44 at the coast pose).
        int2 ocD = _WindowOriginBricksPacked.xz >> 4;
        int dzD = (int)_WindowDimsChunksPacked.z;
        int rowD = (rayDir.z > 0.0) ? dzD - 3 : 2;
        float zMidD = (float)((ocD.y + rowD) * 128 + 64);
        float tzD = (zMidD - rayStart.z) / rayDir.z;
        int cxD = (int)floor((rayStart.x + rayDir.x * tzD) / 128.0) - ocD.x;
        DebugOut[64] = tzD;
        DebugOut[65] = (float)rowD;
        DebugOut[66] = (float)cxD;
        DebugOut[67] = FarChunkResident(int2(cxD, rowD)) ? 1.0 : 0.0;
        [unroll] for (int wD = 0; wD < 5; wD++)
        {
            uint wordD = FarResident[(uint)(dzD - 5 + wD)];   // rows dims.z-5 .. dims.z-1, one 32-bit word each
            DebugOut[68 + 2 * wD] = (float)(wordD & 0xFFFFu);
            DebugOut[69 + 2 * wD] = (float)(wordD >> 16);
        }
        DebugOut[78] = (float)_WindowOriginBricksPacked.x; DebugOut[79] = (float)_WindowOriginBricksPacked.y; DebugOut[80] = (float)_WindowOriginBricksPacked.z;
        DebugOut[81] = (float)_WindowDimsChunksPacked.x; DebugOut[82] = (float)_WindowDimsChunksPacked.y; DebugOut[83] = (float)_WindowDimsChunksPacked.z;
        DebugOut[84] = (float)_ContentFloorVoxelY; DebugOut[85] = (float)_ContentCeilingVoxelY;
        // FarStartT with no limit: where the strip entry WOULD be.
        DebugOut[86] = FarStartT(rayStart, rayDir, 1.0e9);
        DebugOut[87] = _FarParams.x;
    }

    // =======================================================================
    // PHASE 7 -- THE FUSED SHADOW RAY, FIRED HERE (§6.5)
    //
    // §6.5: "in the same raymarch kernel, IMMEDIATELY AFTER a pixel's primary
    // ray resolves a hit, the thread fires one secondary DDA ray from the hit
    // voxel toward the sun." This is that point: traversal is done, `hit`,
    // `voxel` and `normal` are resolved, and no debug view has returned yet --
    // so the two new debug views below can show the shadow ray's own state.
    // =======================================================================

    float sunVis = 0.0;
    float skyVis = 1.0;
    int shadowSteps = 0;

    // §6.5's night rule and rung 3, evaluated once and shared by every branch
    // below so they cannot disagree. _SunColor is EXACTLY zero below the
    // horizon, which is the other half of the same guarantee.
    bool sunIsUp = (_SunDir.y > 0.0);
    bool shadowsOn = (_ShadowQualityLevel < 3);
    bool softShadows = (_ShadowQualityLevel <= 1) && (_KSoft > 0.0);

    // §6.5: "skips sky pixels (no primary hit => no shadow ray)".
    // 66b: not from inside a fluid -- every sun ray would start in it and stop on it.
    bool needsShadowRay = hit && sunIsUp && shadowsOn && passMat == 0u;

    // -----------------------------------------------------------------------
    // §6.5's 8.4 WAVE-UNIFORM BRANCH GUARD -- built in from the start.
    //
    // "GPU threads execute in lockstep groups (waves/warps); if even one lane
    //  in a wave needs a shadow ray, the whole wave pays for entering that
    //  divergent branch, even though only the needing lanes are unmasked. Guard
    //  the shadow branch with WaveActiveAnyTrue(hasPrimaryHit) so a wave that is
    //  ENTIRELY sky skips instantiating the shadow-ray code path altogether...
    //  worth building into Raymarch.compute FROM THE START rather than
    //  retrofitting after a Phase 7 budget miss."
    //
    // This is the literal instruction, taken literally. At the horizon poses
    // that dominate this project's cost (Amendment 8.9: GroundHorizon is the
    // most expensive pose in every config) a large fraction of waves are pure
    // sky, and those waves now skip the entire block rather than each of their
    // 32 lanes paying branch-entry cost for nothing.
    // -----------------------------------------------------------------------
    // ---- §6.5's 8.4 guard, group-uniform ----
    // The write is a PLAIN-WRITE RACE and is deliberately not an atomic: every
    // thread that writes, writes the same value (1), so the result is the same
    // whatever order they land in. That is exactly the pattern §7.3/8.4 already
    // established for the fluid CA's claims -- "claims resolve via a safe
    // plain-write race (8.4, no atomics)" -- reused here rather than reaching
    // for InterlockedOr, which would serialise 64 lanes to compute a boolean.
    if (lane == 0u) gsAnyShadowNeeded = 0u;
    GroupMemoryBarrierWithGroupSync();
    if (needsShadowRay) gsAnyShadowNeeded = 1u;
    GroupMemoryBarrierWithGroupSync();

    // gsAnyShadowNeeded is now GROUP-UNIFORM, so this branch is scalar: a group
    // that is entirely sky skips instantiating the shadow path altogether,
    // which is the behaviour §6.5 asks for.
    if (gsAnyShadowNeeded != 0u)
    {
        // §6.5 rung 1: "shadow rays beyond LOD1 drop to half resolution with
        // NEIGHBOUR REUSE (near shadows, the ones by the player, untouched)."
        //
        // Implemented as 2x2 quad reuse: one lane of each quad traces and the
        // other three read its result. QuadReadLaneAt is the primitive designed
        // for exactly this, and quads in a 2D compute dispatch are the 2x2
        // block of threads, so quad lane 0 is the even/even thread.
        //
        // THAT LANE MAPPING IS AN ASSUMPTION OF THE SM6.0 COMPUTE QUAD RULES
        // AND IS FLAGGED, NOT ASSERTED. If it is wrong on this driver the
        // symptom is distant shadows taking their value from the wrong
        // neighbour -- visible in the rig's own screenshots, not silent. It
        // affects rung 1 ONLY; rungs 0, 2 and 3 never execute this path.
        //
        // `quadComplete` keeps the quad ops away from partially-out-of-bounds
        // quads, where lanes have already returned and cross-lane reads are
        // undefined. Both shipped gate resolutions are even in both axes, so
        // every quad is entirely in or entirely out, but the guard costs two
        // comparisons and removes the question.
        float rung1Threshold = (_Rung1DistVoxels > 0.0) ? _Rung1DistVoxels : _TierOuterRangeVoxels.y;
        bool distant = hit && (currentDist >= rung1Threshold);
        bool reuse = (_ShadowQualityLevel == 1) && distant;
        bool isQuadLead = ((gtid.x & 1u) == 0u) && ((gtid.y & 1u) == 0u);
        uint leadLane = (gtid.y & ~1u) * 8u + (gtid.x & ~1u);

        // Task 61: half-res at all distances, edge-aware (_ShadowHalfRes note).
        // _ShadowHalfRes is a constant, so the barrier is group-uniform.
        if (_ShadowHalfRes > 0.0)
        {
            int3 org = voxel + normal;
            gsShadowOrg[lane] = needsShadowRay ? int4(org, NormalCode(normal)) : int4(0, 0, 0, -1);
            GroupMemoryBarrierWithGroupSync();
            int4 lo = gsShadowOrg[leadLane];
            bool similar = false;
            if (needsShadowRay && lo.w >= 0)
            {
                int3 d = org - lo.xyz;
                int3 dd = abs(d);
                float tol = 2.0 + 2.0 * currentDist * _ShadowHalfRes;
                bool nearLead = (float)max(dd.x, max(dd.y, dd.z)) <= tol;
                bool coplanar = (lo.w == NormalCode(normal)) && (abs(normal.x * d.x + normal.y * d.y + normal.z * d.z) <= 1);
                similar = nearLead || coplanar;
            }
            reuse = similar || isQuadLead;
        }

        // Temporal reuse: is last frame's value for this shadow origin usable?
        bool histHit = false;
        float histVis = 1.0;
        uint shadowKey = ShadowOriginKey(voxel + normal);
        if (_TemporalShadows != 0 && needsShadowRay && _ShadowHistValid != 0)
        {
            // The rotation is per 8x8 THREAD GROUP, not per pixel: a group runs
            // in lockstep, so a per-pixel 1-in-4 pattern still had 16 lanes of
            // every group tracing each frame and the group waited for its
            // slowest ray (measured 2026-09-26: 74% fewer rays, only -9 ms). A
            // whole tile now traces on its frame and skips the branch on the
            // other three, apart from newly revealed pixels.
            // Checkerboard: the tile is the THREAD group's (it covers 16x8
            // pixels), and the turn advances every second frame -- a pixel is
            // traced on alternate frames, so with the plain frame counter half
            // the tiles would never get their turn on the frames their pixels
            // are traced.
            uint2 tile = tid.xy >> 3u;
            uint sFrame = checker ? (_ShadowFrame >> 1u) : _ShadowFrame;
            bool myTurn = (((tile.x & 1u) | ((tile.y & 1u) << 1u)) == (sFrame & 3u));
            if (!myTurn)
            {
                // This pixel's own surface point, where it was last frame. The
                // nearest pixel first, then its neighbours toward the point (a
                // face only a few pixels wide often lands one over); the key
                // decides, so trying more can only find the exact value or none.
                // Checkerboard: last frame wrote only ITS half of the pixels (the
                // other half of that buffer holds the never-matching fill), so
                // the neighbours are what find it there.
                float3 hp = rayStart + rayDir * currentDist;
                float4 pc = mul(_PrevViewProj, float4(hp * 0.1, 1.0));
                if (pc.w > 1e-4)
                {
                    float2 ppf = (pc.xy / pc.w * 0.5 + 0.5) * float2(width, height);
                    int2 p0 = int2(floor(ppf));
                    int2 dn = int2(ppf.x - p0.x >= 0.5 ? 1 : -1, ppf.y - p0.y >= 0.5 ? 1 : -1);
                    int2 probes[4] = { p0, int2(p0.x + dn.x, p0.y), int2(p0.x, p0.y + dn.y), p0 + dn };
                    [unroll]
                    for (int q = 0; q < 4; q++)
                    {
                        int2 pp = probes[q];
                        if (!histHit && pp.x >= 0 && pp.y >= 0 && pp.x < (int)width && pp.y < (int)height)
                        {
                            uint2 hv = ShadowHistR[(uint)pp.y * width + (uint)pp.x];
                            if (hv.y == shadowKey) { histHit = true; histVis = asfloat(hv.x); }
                        }
                    }
                }
            }
        }

        // Every lane evaluates the trace condition the same way so the quad
        // read below is reached uniformly.
        bool traceMine = needsShadowRay && !histHit && (!reuse || isQuadLead);

        ShadowHit sh;
        sh.sunVis = 1.0;
        sh.steps = 0;
        if (traceMine) sh = TraceShadowRay(voxel, normal, _SunDir, _WindowDimsBricks, softShadows, isDebugPixel);

        // The 2x2 block's lead lane, by EXACT INDEX rather than by assuming a
        // quad-lane mapping. Every lane publishes and every lane reads, so the
        // barrier is reached uniformly inside this already-uniform branch.
        float mineVis = histHit ? histVis : sh.sunVis;
        gsSunVis[lane] = mineVis;
        GroupMemoryBarrierWithGroupSync();
        float leadVis = gsSunVis[leadLane];

        sunVis = needsShadowRay ? (reuse ? leadVis : mineVis) : 0.0;
        shadowSteps = sh.steps;

        if (_CollectShadowStats != 0)
        {
            if (hit)      InterlockedAdd(ShadowStats[0], 1u);
            if (distant)  InterlockedAdd(ShadowStats[1], 1u);
            if (traceMine) InterlockedAdd(ShadowStats[2], 1u);
            if (needsShadowRay && reuse && !isQuadLead) InterlockedAdd(ShadowStats[3], 1u);
            // [4] TOTAL SHADOW STEPS. The decisive counter for the travel-LOD
            // experiment: if steps do not fall when the rule is enabled, the
            // mechanism is not engaging and no amount of frame-time staring will
            // say so. Same instrument-before-guessing that settled rung 1 (§F.1).
            if (traceMine) InterlockedAdd(ShadowStats[4], (uint)sh.steps);
        }
    }

    // When shadows are OFF (rung 3), §6.5 says "sun becomes a flat N.L term
    // with ambient" -- i.e. full sun visibility everywhere, with the N.L in the
    // combine doing the shaping. Handled here rather than inside the guard so a
    // wave that skipped the block entirely still lands on the right value.
    if (hit && sunIsUp && !shadowsOn) sunVis = 1.0;
    // 66b: from inside a fluid the bed and walls take the sun, dimmed for the fluid
    // above them; the fog below does the rest. No terrain shadows under water.
    if (hit && sunIsUp && passMat != 0u) sunVis = 0.8;

    // Temporal reuse: every pixel records what it used, for the next frame.
    if (_TemporalShadows != 0 && inBounds)
        ShadowHistW[id.y * width + id.x] = needsShadowRay
            ? uint2(asuint(sunVis), ShadowOriginKey(voxel + normal))
            : uint2(0u, 0xFFFFFFFFu);

    // -----------------------------------------------------------------------
    // AMBIENT SKY VISIBILITY (§6.5's "underground reads near-zero ambient")
    //
    // FLAGGED, NOT DECIDED. §6.5 asks ambient to be three things at once: a
    // CHEAP HEMISPHERE TERM, the stand-in for BOUNCE INTO CAVE MOUTHS, and
    // near-zero DEEP UNDERGROUND. A plain normal-based hemisphere term cannot
    // be the third -- it lights a sealed cave ceiling exactly as brightly as
    // open sky, and "deep cave genuinely dark" is a §13 acceptance bullet.
    //
    // The cheapest thing that satisfies all three is a straight-up occlusion
    // probe, and it is deliberately THE SAME FUNCTION with its direction fixed
    // to +Y rather than a second traversal: it inherits the air-mip, the
    // content-ceiling exit and the window guard, and it has the same CPU oracle
    // (ShadowRayReference.Trace with dir = (0,1,0)). A vertical ray is also the
    // cheapest possible one -- axis-aligned, so every air-mip leap is maximal
    // and it exits at the content ceiling in a handful of iterations.
    //
    // IT IS STILL A SECOND RAY AND IS NOT CLAIMED TO BE FREE. It is behind its
    // own flag so Stage 6 measures it as its own arm, and the decision is the
    // owner's. See PHASE_7_COMPLETION.md's FLAG list.
    // -----------------------------------------------------------------------
    if (hit && _UseSkyProbeAmbient != 0 && passMat == 0u)   // 66b: from a fluid it would stop in the fluid
    {
        // No second group guard here: `hit` is already the per-thread condition
        // and a group with no hits at all has nothing to probe, so the outer
        // test does the same work the guard would. Adding a second pair of
        // barriers to restate it would cost two syncs to save nothing.
        //
        // `dbg` false: the sky probe must not overwrite the SUN ray's §10.4
        // ring buffer, or the dump would describe the wrong ray.
        ShadowHit sky = TraceShadowRay(voxel, normal, float3(0.0, 1.0, 0.0),
                                       _WindowDimsBricks, false, false);
        skyVis = sky.sunVis;
    }

    // §10.4's scalar record for the shadow path, alongside the ring buffer the
    // trace filled. Written unconditionally for the debug pixel so a dump
    // describes a LIT ray as readily as an occluded one -- "why is this pixel
    // lit when it should be shadowed" is the question this answers most often.
    if (isDebugPixel)
    {
        DebugOut[20] = (float)shadowSteps;
        DebugOut[24] = _SunDir.x;        // direction the shadow ray travelled
        DebugOut[25] = _SunDir.y;
        DebugOut[26] = _SunDir.z;
        DebugOut[27] = (float)(voxel.x + normal.x);   // §6.5's origin, one cell off
        DebugOut[28] = (float)(voxel.y + normal.y);
        DebugOut[29] = (float)(voxel.z + normal.z);
        DebugOut[30] = sunVis;
        DebugOut[31] = skyVis;
        DebugOut[33] = (float)_ShadowQualityLevel;
        DebugOut[44] = (float)_ActiveLightCount;
        DebugOut[45] = hit ? 1.0 : 0.0;
    }

    if (_DebugMode == 9)
    {
        // FAR BAND VIEW: which band drew each pixel. Voxel window blue; far
        // levels F0..F4 green, yellow, orange, red, magenta; sky near-black.
        float4 c9 = float4(0.02, 0.02, 0.03, 1.0);
        if (hit) c9 = float4(0.15, 0.35, 0.90, 1.0);
        else if (farHit)
        {
            if (fh.level == 0) c9 = float4(0.15, 0.80, 0.25, 1.0);
            else if (fh.level == 1) c9 = float4(0.90, 0.90, 0.15, 1.0);
            else if (fh.level == 2) c9 = float4(0.95, 0.55, 0.10, 1.0);
            else if (fh.level == 3) c9 = float4(0.90, 0.15, 0.15, 1.0);
            else c9 = float4(0.85, 0.20, 0.85, 1.0);
        }
        if (inBounds) ResultTexture[id.xy] = c9;
        return;
    }
    if (_DebugMode == 10)
    {
        // FAR STEP HEAT: far-march iterations for pixels the voxel march missed.
        float4 c10 = hit ? float4(0.0, 0.0, 0.0, 1.0) : StepHeatColor(fh.steps + farShadowSteps);
        if (inBounds) ResultTexture[id.xy] = c10;
        return;
    }
    if (_DebugMode == 11)
    {
        // VOXEL-STOP VIEW (diagnostic, item 1 of the 2026-09-25 brief): WHY the
        // voxel march ended. A march cut short by its distance or iteration cap
        // while still over a RESIDENT column hands the far march a ray whose
        // remaining resident columns it then skips (skipWindow) -- a hole.
        //   blue hit | green far hit after a legitimate hand-off | grey sky
        //   red: capped over resident terrain, far drew nothing (sky hole)
        //   magenta: capped over resident terrain, far drew terrain further on
        float4 c11 = float4(0.25, 0.25, 0.27, 1.0);
        if (hit) c11 = float4(0.15, 0.35, 0.90, 1.0);
        else
        {
            bool capped = !skipVoxel && (steps >= _iterCap || currentDist >= maxDist);
            bool overResident = false;
            if (capped)
            {
                float3 ps = rayStart + rayDir * currentDist;
                int3 wMin11 = _WindowOriginBricksPacked.xyz * 8;
                overResident = FarChunkResident((int2(floor(ps.xz)) >> 7) - (wMin11.xz >> 7));
            }
            if (capped && overResident) c11 = farHit ? float4(0.85, 0.20, 0.85, 1.0) : float4(0.95, 0.10, 0.10, 1.0);
            else if (farHit) c11 = float4(0.15, 0.80, 0.25, 1.0);
        }
        if (inBounds) ResultTexture[id.xy] = c11;
        return;
    }
    if (_DebugMode == 1) { if (inBounds) ResultTexture[id.xy] = StepHeatColor(steps); return; }
    if (_DebugMode == 2)
    {
        if (!hit) { if (inBounds) ResultTexture[id.xy] = float4(0.05, 0.05, 0.1, 1.0); return; }
        if (inBounds) ResultTexture[id.xy] = lastWasDense ? float4(0.9, 0.9, 0.2, 1.0) : float4(0.2, 0.2, 0.3, 1.0);
        return;
    }
    if (_DebugMode == 3)
    {
        if (!hit) { if (inBounds) ResultTexture[id.xy] = float4(0.0, 0.0, 0.0, 1.0); return; }
        float3 n = (float3(normal) * 0.5) + 0.5;
        if (inBounds) ResultTexture[id.xy] = float4(n, 1.0);
        return;
    }
    if (_DebugMode == 4) { if (inBounds) ResultTexture[id.xy] = StepHeatColor(nonExitIters >> 3); return; }
    if (_DebugMode == 5)
    {
        if (!hit) { if (inBounds) ResultTexture[id.xy] = float4(0.2, 0.4, 0.8, 1.0); return; }
        float ndotlV = max(0.25, dot(float3(normal), normalize(float3(0.5, 1.0, 0.2))));
        float baseV = (mat == 2) ? 0.60 : 0.50;
        float variation = (VoxelHash(voxel) - 0.5) * 0.28;
        float shadeV = saturate(baseV + variation) * ndotlV;
        if (inBounds) ResultTexture[id.xy] = float4(shadeV, shadeV, shadeV, 1.0);
        return;
    }
    if (_DebugMode == 7)
    {
        // §10.3 item 6: SUN-VISIBILITY VIEW. Greyscale sunVis on hits; sky
        // pixels a flat dark blue so "no primary hit" is distinguishable from
        // "fully shadowed", which a plain greyscale ramp would conflate -- and
        // telling those two apart is exactly what you need this view for.
        if (!hit) { if (inBounds) ResultTexture[id.xy] = float4(0.05, 0.08, 0.16, 1.0); return; }
        if (!sunIsUp) { if (inBounds) ResultTexture[id.xy] = float4(0.10, 0.02, 0.16, 1.0); return; }  // night: violet
        if (inBounds) ResultTexture[id.xy] = float4(sunVis, sunVis, sunVis, 1.0);
        return;
    }
    if (_DebugMode == 8)
    {
        // §10.3 item 6: SHADOW-RAY STEP-COUNT HEAT. Same StepHeatColor ramp the
        // primary heat view uses, so the two are directly comparable by eye --
        // the question this view exists to answer is "does a shadow ray cost
        // the same as the primary ray that spawned it", and two different
        // colour ramps would make that unanswerable.
        if (!hit) { if (inBounds) ResultTexture[id.xy] = float4(0.02, 0.02, 0.04, 1.0); return; }
        if (inBounds) ResultTexture[id.xy] = StepHeatColor(shadowSteps);
        return;
    }
    if (_DebugMode == 6)
    {
        // LOD tier visualization: NEW. Not hit -> background. Tier 0 -> blue,
        // tier 1 -> green, tier 2 -> red. Purely diagnostic - lets a human
        // eyeball whether tier boundaries land where expected and whether the
        // 0->1->2 transitions are visually reasonable, BEFORE trusting this
        // path for a benchmark run. This is the capture to send back first.
        if (!hit) { if (inBounds) ResultTexture[id.xy] = float4(0.05, 0.05, 0.05, 1.0); return; }
        float4 tierColor = float4(0.1, 0.3, 0.9, 1.0); // tier 0 = blue
        if (tierAtHit == 1) tierColor = float4(0.15, 0.85, 0.2, 1.0); // tier 1 = green
        if (tierAtHit == 2) tierColor = float4(0.9, 0.15, 0.15, 1.0); // tier 2 = red
        if (inBounds) ResultTexture[id.xy] = tierColor;
        return;
    }

    float4 color = _SkyColor;
    if (_Look == 1 && _UseDevColors != 0) color = float4(LookToLinear(LookShoulder(LookAtmosphere(rayDir), _LookGrade.z)), 1.0);
    // 66b: a fluid-mode stop on AIR is the surface from below, coloured after this chain.
    bool fluidSurface = (passMat != 0u) && hit && (mat == 0u);
    if (hit && !fluidSurface)
    {
        float ndotl = max(0.2, dot(float3(normal), normalize(float3(0.5, 1.0, 0.2))));
        if (_UseDevColors != 0 && _Look == 1)
        {
            // ---- LOOK 1: the Brickmap's shading, term for term (see the
            // block above MaterialAlbedoLook). Shares sunVis / skyVis / the
            // light buffer / FaceAO with C.9 below; only the combine differs.
            uint lm = mat;
            bool selfLit = MaterialIsSelfLit(lm);
            float3 baseColor = LookAlbedo(lm, voxel);
            if (_RiverLook != 0 && lm == 6u && passMat == 0u) baseColor = RiverLookAlbedo(baseColor, voxel, normal, _WindowDimsBricks);   // task 73 prototype
            float3 nF = float3(normal);
            float3 sd = normalize(_SunDir);

            // Face shade: tops bright, sides distinct (the Brickmap's constants).
            float3 ln = normalize(nF + float3(0.0, 0.65, 0.0));
            float faceShade = saturate(ln.y) * 0.6 + saturate(abs(ln.x)) * 0.2 + 0.2;
            float softened = lerp(0.4, 1.0, faceShade);

            // Floored sun term -- a face turned from the sun keeps 20%, a
            // shadowed face keeps (1 - darkness). This is what removes the black
            // terrace contours. skyOpen keeps sealed caves dark: with no sky
            // visibility the shadow floor collapses to the underground floor.
            float sunLight = saturate(dot(nF, sd) * 0.8 + 0.2);
            float skyOpen = lerp(_UndergroundAmbientFloor, 1.0, skyVis);
            float sunExposure = lerp((1.0 - _LookShadowDarkness) * skyOpen, 1.0, sunVis);
            float3 direct = _LookSun.rgb * sunLight * sunExposure * softened;
            float moonLight = saturate(dot(nF, -sd) * 0.8 + 0.2);
            direct += _LookMoon.rgb * moonLight * softened * skyOpen;

            float3 hitP = rayStart + rayDir * currentDist;

            // VAO on the ambient term only, with the Brickmap's remap.
            float vao = 1.0;
            if (_ShadeAO != 0 && !selfLit && passMat == 0u)   // 66b: fluid neighbours are not occluders
            {
                float3 inVoxel = hitP - (float3(voxel) + 0.5);
                vao = FaceAO(voxel, normal, inVoxel, _WindowDimsBricks);
                vao = lerp(0.15, 1.0, pow(smoothstep(0.0, 1.0, vao), 1.2));
            }
            float3 ambient = _LookAmbient.rgb * skyOpen * vao;

            float3 hitPosM = hitP * 0.1;
            float3 pointTerm, omniTerm = float3(0.0, 0.0, 0.0);
            if (_TorchShadowRays > 0 && tierAtHit == 0 && !selfLit)
                pointTerm = SumPointLightsShadowed(hitPosM, nF, voxel + normal, (float3(voxel) + 0.5) * 0.1,
                                                   _WindowDimsBricks, omniTerm);
            else
            {
                pointTerm = SumPointLights(hitPosM, nF);
                if (_UniformFaceHue != 0) omniTerm = SumPointLightsOmni((float3(voxel) + 0.5) * 0.1);
            }

            float3 faceLight = (direct + ambient) * _LookGrade.x + pointTerm;
            if (_UniformFaceHue != 0)
                faceLight = UniformFaceHue(faceLight, (_LookSun.rgb * 0.6 + _LookMoon.rgb * 0.6 + _LookAmbient.rgb) * _LookGrade.x
                                                      + omniTerm);

            // LAVA (owner 2026-10-09): the SVO build's emissive form,
            // baseColor * light + albedo * emission * 2, which keeps lava deep
            // orange. The old self-lit cheat, saturate(base * 1.35 + 0.06) + tint
            // * 0.55, clipped red at 1 and let green climb to ~0.76: pale gold.
            // Per-voxel hot/cool: +/-0.05 red, +/-0.025 green around the albedo.
            // Lava is self-lit and must ignore point light (owner 2026-10-09, Q34 3a).
            // Every other material keeps the previous combine, unchanged.
            float3 lit;
            if (lm == 11u)
            {
                float hot = VoxelHash(voxel) - 0.5;
                float3 albedo = MaterialAlbedoLook(lm) + float3(hot * 0.10, hot * 0.05, -hot * 0.02);
                lit = baseColor * ((direct + ambient) * _LookGrade.x) + albedo * (MaterialEmissive(lm) * 2.0);
            }
            else
            {
                lit = selfLit ? saturate(baseColor * 1.35 + 0.06)
                              : baseColor * faceLight;
                lit += MaterialEmissiveTint(lm) * MaterialEmissive(lm);
            }

            // EMISSIVE BLEED (_EmissiveBleed, ON by default since task 46, owner
            // Q5 (a); -emissivebleed 0 turns it off): a non-emitting
            // tier-0 face picks up the look albedo of an emitter on one of the
            // four edge neighbours of its air cell, fading across the face --
            // the SVO RayTracer.compute's bleed, term for term. Four extra
            // window reads per pixel; engine plan step 7 measures the cost.
            if (_EmissiveBleed != 0 && tierAtHit == 0 && MaterialEmissive(lm) <= 0.0)
            {
                int3 fa = voxel + normal;
                int3 e1, e2;
                float3 lh = saturate(hitP - float3(voxel));
                float2 uv;
                if (normal.x != 0)      { e1 = int3(0, 1, 0); e2 = int3(0, 0, 1); uv = lh.yz; }
                else if (normal.y != 0) { e1 = int3(1, 0, 0); e2 = int3(0, 0, 1); uv = lh.xz; }
                else                    { e1 = int3(1, 0, 0); e2 = int3(0, 1, 0); uv = lh.xy; }
                float3 bleed = max(max(LookEmitColor(fa - e1, _WindowDimsBricks) * (1.0 - uv.x),
                                       LookEmitColor(fa + e1, _WindowDimsBricks) * uv.x),
                                   max(LookEmitColor(fa - e2, _WindowDimsBricks) * (1.0 - uv.y),
                                       LookEmitColor(fa + e2, _WindowDimsBricks) * uv.y));
                lit += bleed * 2.0;
            }

            // Squared distance haze into the sky behind the pixel.
            if (_ShadeFog != 0)
            {
                lit = lerp(lit, LookAtmosphere(rayDir), HazeAmount(currentDist, rayStart.y, rayStart.y + rayDir.y * currentDist));
            }
            if (_LookGrade.w > 0.0) lit = LookGradeColour(lit, _LookGrade.y, _LookGrade.z);
            color = float4(LookToLinear(lit), 1.0);
        }
        else if (_UseDevColors != 0)
        {
            // NEW: developer material colors + per-voxel grain. Not final art -
            // a cheap, explicitly-flagged debug palette so individual voxels
            // are distinguishable at 960x540, which flat single-shade gray
            // wasn't. Reuses VoxelHash (already existed, was previously only
            // wired into DebugMode 5/VoxelGrain) as the per-voxel noise source -
            // same idea the person asked for ("take the voxel position, apply
            // noise, shift the color slightly"), just extended from grayscale-
            // only to also picking a base hue per material id.
            // ---- AUTHORED PALETTE + CHEAP FAKE SHADING (presentation only) ----
            // Runs after traversal has resolved `voxel`, `normal` and
            // `currentDist`. Reads nothing the DDA writes and writes nothing the
            // DDA reads.
            float3 baseColor = MaterialAlbedo(mat);
            bool selfLit = MaterialIsSelfLit(mat);

            // Per-voxel grain, kept from the dev shading: without it, large flat
            // faces of one material read as untextured plastic. Halved from the
            // old +/-17.5%, because a real palette needs far less help than the
            // modulo one did.
            // The original white-noise grain is KEPT and simply scaled down when
            // the low-frequency variation is on -- the two do different jobs
            // (this one breaks up a single face up close, that one varies the
            // ground across metres) and removing it makes near surfaces plastic.
            float grainAmt = _MaterialVariation != 0 ? 0.09 : 0.18;
            float grain = (VoxelHash(voxel) - 0.5) * grainAmt;
            float3 shaded = saturate(ApplyMaterialVariation(voxel, baseColor) * (1.0 + grain));

            // Hemisphere tint: up-facing faces catch the sky, down-facing faces
            // fall toward ground shadow. This single term does most of the work
            // that other voxel engines get from real lighting -- it is what makes
            // a horizontal surface read as horizontal.
            if (_ShadeHemi != 0 && !selfLit)
            {
                float upness = float(normal.y) * 0.5 + 0.5;      // 0 down, 0.5 side, 1 up
                float hemi = lerp(0.62, 1.12, upness);
                shaded *= hemi;
                // The sky tint shifts HUE by face (up faces bluer); with one
                // colour per voxel it is applied as brightness only.
                float3 skyTint = 0.85 + 0.35 * _SkyColor.rgb;
                if (_UniformFaceHue != 0) skyTint = dot(skyTint, float3(0.2126, 0.7152, 0.0722));
                shaded = lerp(shaded, shaded * skyTint, upness * 0.35);
            }

            // Ambient occlusion from neighbour occupancy.
            if (_ShadeAO != 0 && !selfLit && passMat == 0u)   // 66b: fluid neighbours are not occluders
            {
                float3 hitP = rayStart + rayDir * currentDist;
                float3 inVoxel = hitP - (float3(voxel) + 0.5);   // [-0.5, 0.5] per axis
                float ao = FaceAO(voxel, normal, inVoxel, _WindowDimsBricks);
                shaded *= lerp(0.55, 1.0, ao);
            }

            // ===============================================================
            // C.9 -- THE FINAL COMBINE
            //
            //   color = albedo x (sunColor . sunVis . max(0, N.L)
            //                     + pointLights + ambientSky) + emissive,
            //   then VAO.
            //
            // Written in that order, term for term, so it is checkable against
            // the spec line rather than merely "a lighting model".
            //
            // WHERE VAO IS. C.9 says "then VAO", and the VAO term is the
            // FaceAO() corner-darkening already applied above. Stage 0 recorded
            // its provenance honestly: the literal token "VAO" appears nowhere
            // in this project, and FaceAO arrived in a later presentation pass
            // rather than as §13 Phase 2's file-4 build step, which
            // PHASE_2_COMPLETION.md never ticked. It IS voxel ambient occlusion
            // -- four corners, two edge neighbours and a diagonal each,
            // bilinearly interpolated across the face -- so it is used as C.9's
            // VAO rather than a new one being invented. Flagged, not assumed.
            //
            // WHAT THE OLD SHADING TERMS BECOME. The hemisphere tint and the
            // softened lerp(0.80, 1.0, ndotl) above were a stand-in for
            // lighting that did not exist yet, and RaymarchFeature's own
            // comment says the flags exist "precisely so Phase 7's real
            // lighting (§6.5) can disable any of them without unpicking
            // anything". They are now DEMOTED, not deleted: _ShadeHemi still
            // gates the hemisphere tint (it is C.9's ambientSky given a
            // direction, which is what makes a horizontal surface read as
            // horizontal), and the fake directional term is replaced outright
            // by the real sun term below. Turning the new lighting off restores
            // the old look exactly, which is what makes the A/B in Stage 6
            // meaningful.
            // ===============================================================
            float ndl = max(0.0, dot(float3(normal), normalize(_SunDir)));
            float3 sunTerm = _SunColor * sunVis * ndl;

            float3 hitPosM = (rayStart + rayDir * currentDist) * 0.1;
            float3 pointTerm, omniTerm = float3(0.0, 0.0, 0.0);
            if (_TorchShadowRays > 0 && tierAtHit == 0 && !selfLit)
                pointTerm = SumPointLightsShadowed(hitPosM, float3(normal), voxel + normal, (float3(voxel) + 0.5) * 0.1,
                                                   _WindowDimsBricks, omniTerm);
            else
            {
                pointTerm = SumPointLights(hitPosM, float3(normal));
                if (_UniformFaceHue != 0) omniTerm = SumPointLightsOmni((float3(voxel) + 0.5) * 0.1);
            }

            // ambientSky, modulated by sky visibility so a sealed cave is dark
            // and a cave mouth is not (§6.5). With the probe off this collapses
            // to the plain ambient term.
            float ambientScale = lerp(_UndergroundAmbientFloor, 1.0, skyVis);
            float3 ambientTerm = _AmbientColor * ambientScale;

            // Self-lit materials (today: lava) keep the shading cheat that
            // predates Phase 7 AND now also carry a real emissive term. The
            // cheat skips AO and the hemisphere so they stay hot; the emissive
            // is what makes them light their surroundings via the §3.8 buffer.
            // PaletteSyncTests pins that lava is still the only self-lit
            // material, and a torch deliberately is NOT one -- it takes the
            // real emissive path instead, so it is not double-counted.
            if (selfLit) shaded = saturate(baseColor * 1.35 + 0.06);
            else
            {
                float3 faceLight = sunTerm + pointTerm + ambientTerm;
                if (_UniformFaceHue != 0)
                    faceLight = UniformFaceHue(faceLight, _SunColor * 0.6 + _AmbientColor + omniTerm);
                shaded = shaded * faceLight;
            }

            shaded += MaterialEmissiveTint(mat) * MaterialEmissive(mat);

            // Distance fog toward the sky colour. Depth cue only.
            if (_ShadeFog != 0)
            {
                float f = saturate((currentDist * 0.1 - _FogStartM) / max(0.001, _FogEndM - _FogStartM));
                shaded = lerp(shaded, _SkyColor.rgb, f * 0.85);
            }

            // §6.1's deferred "post", at the one place every lit pixel passes
            // through. With _Tonemap == 0 this is byte-identical to the
            // previous `saturate(shaded)`.
            color = float4(ApplyTonemap(shaded), 1.0);
        }
        else
        {
            // Original flat shading, preserved byte-for-byte behind the
            // toggle - _UseDevColors defaults ON, but flipping it off
            // reproduces every pre-existing Beauty screenshot exactly, for
            // any future A/B comparison that needs the old look specifically.
            color = float4(0.5 * ndotl, 0.5 * ndotl, 0.5 * ndotl, 1.0);
            if (mat == 2) color = float4(0.6 * ndotl, 0.6 * ndotl, 0.6 * ndotl, 1.0);
        }
    }
    else if (farHit)
    {
        // FAR BAND SHADING: the look-1 combine with the terms a heightfield
        // cannot supply set to "open sky" -- no AO, no point lights, sky
        // visibility 1. The albedo hash is the TEXEL CENTRE, so each far column
        // is one flat-coloured block (§2.3: the far band stays blocky).
        uint fm = (fh.texel >> 16) & 0xFFu;
        if (fh.normal.y == 0 && (float)(fh.texel & 0xFFFFu) - (rayStart.y + rayDir.y * fh.t) > FAR_WALL_LIP)
            fm = FarWallMaterial(fm);
        int ftv = 8 << fh.level;
        int3 fvox = int3(fh.cell.x * ftv + (ftv >> 1), (int)(fh.texel & 0xFFFFu) - 1, fh.cell.y * ftv + (ftv >> 1));
        float3 nF = float3(fh.normal);
        float3 sd = normalize(_SunDir);
        float sunVisF = (_SunDir.y > 0.0) ? farSunVis : 0.0;
        if (_Look == 1 && _UseDevColors != 0)
        {
            float3 baseColor = LookAlbedo(fm, fvox);
            float3 ln = normalize(nF + float3(0.0, 0.65, 0.0));
            float faceShade = saturate(ln.y) * 0.6 + saturate(abs(ln.x)) * 0.2 + 0.2;
            float softened = lerp(0.4, 1.0, faceShade);
            float sunLight = saturate(dot(nF, sd) * 0.8 + 0.2);
            float sunExposure = lerp(1.0 - _LookShadowDarkness, 1.0, sunVisF);
            float3 direct = _LookSun.rgb * sunLight * sunExposure * softened;
            float moonLight = saturate(dot(nF, -sd) * 0.8 + 0.2);
            direct += _LookMoon.rgb * moonLight * softened;
            float3 faceLightF = (direct + _LookAmbient.rgb) * _LookGrade.x;
            faceLightF = UniformFaceHue(faceLightF, (_LookSun.rgb * 0.6 + _LookMoon.rgb * 0.6 + _LookAmbient.rgb) * _LookGrade.x);
            float3 lit = baseColor * faceLightF;
            if (_ShadeFog != 0) lit = lerp(lit, LookAtmosphere(rayDir), HazeAmount(fh.t, rayStart.y, rayStart.y + rayDir.y * fh.t));
            if (_LookGrade.w > 0.0) lit = LookGradeColour(lit, _LookGrade.y, _LookGrade.z);
            color = float4(LookToLinear(lit), 1.0);
        }
        else
        {
            float3 shadedF = MaterialAlbedo(fm) * UniformFaceHue(_SunColor * saturate(dot(nF, sd)) * sunVisF + _AmbientColor,
                                                                 _SunColor * 0.6 + _AmbientColor);
            if (_ShadeFog != 0) shadedF = lerp(shadedF, _SkyColor.rgb, HazeAmount(fh.t, rayStart.y, rayStart.y + rayDir.y * fh.t) * 0.85);
            color = float4(ApplyTonemap(shadedF), 1.0);
        }
    }

    // ---- 66b: THE FLUID BETWEEN THE EYE AND WHAT IT SEES ----
    // The whole path was in the fluid (the march stops where it leaves it), so
    // transmittance is exp(-d * extinction) per channel. The fog is the fluid's
    // albedo under the sky's light; where the ray leaves through the surface it
    // sees the sky inside Snell's window (~49 deg from straight up, cos 0.66)
    // and the fluid's own light reflected outside it.
    if (passMat != 0u)
    {
        float3 sdU = normalize(_SunDir);
        float dayU = saturate(sdU.y * 0.8 + 0.2);
        float window = smoothstep(0.55, 0.75, rayDir.y);
        float3 fogLin, surfLin;
        if (_Look == 1 && _UseDevColors != 0)
        {
            float3 fogL = MaterialAlbedoLook(passMat) * ((_LookSun.rgb * dayU + _LookMoon.rgb * 0.3 + _LookAmbient.rgb) * _LookGrade.x) * 0.6;
            float3 surfL = lerp(fogL * 1.6, LookAtmosphere(rayDir) * 0.85 + fogL * 0.3, window);
            if (_LookGrade.w > 0.0) { fogL = LookGradeColour(fogL, _LookGrade.y, _LookGrade.z); surfL = LookGradeColour(surfL, _LookGrade.y, _LookGrade.z); }
            fogLin = LookToLinear(fogL);
            surfLin = LookToLinear(surfL);
        }
        else
        {
            float3 fogS = MaterialAlbedo(passMat) * (_SunColor * dayU + _AmbientColor) * 0.6;
            fogLin = ApplyTonemap(fogS);
            surfLin = ApplyTonemap(lerp(fogS * 1.6, _SkyColor.rgb * 0.85 + fogS * 0.3, window));
        }
        // Light comes down from the fluid's top: what reaches a depth d is
        // exp(-d * ext / 2) (half: scattered light keeps some of it), for the
        // fog at the eye and for the surface the ray hit. Flat-top assumption.
        float3 ext = FluidExtinction(passMat);
        float eyeDepthM = max(0.0, fluidTopY - rayStart.y) * 0.1;
        float hitDepthM = max(0.0, fluidTopY - (rayStart.y + rayDir.y * currentDist)) * 0.1;
        fogLin *= exp(-eyeDepthM * ext * 0.5);
        fogLin += MaterialEmissiveTint(passMat) * MaterialEmissive(passMat) * 0.3;   // sludge glows
        float3 base = fluidSurface ? surfLin : (hit ? color.rgb * exp(-hitDepthM * ext * 0.5) : fogLin);
        float3 trans = exp(-(currentDist * 0.1) * ext);
        color = float4(base * trans + fogLin * (1.0 - trans), 1.0);
    }

    // TAA: where this pixel's surface was last frame, and what it was.
    if (_TaaEnabled != 0 && inBounds)
    {
        float tHit = hit ? currentDist : (farHit ? fh.t : -1.0);
        float3 P = rayStart + rayDir * max(tHit, 0.0);
        // Sky reprojects as a point at infinity (w = 0): rotation only.
        float4 pc = (tHit >= 0.0) ? mul(_TaaPrevViewProj, float4(P * 0.1, 1.0))
                                  : mul(_TaaPrevViewProj, float4(rayDir, 0.0));
        float expD = (tHit >= 0.0) ? length(P - _TaaPrevCamVox.xyz) : -2.0;
        float2 prevPx = float2(-1e4, -1e4);
        if (pc.w > 1e-6) prevPx = (pc.xy / pc.w * 0.5 + 0.5) * float2(width, height) - _TaaJitter;
        else expD = -1.0;
        // The voxel mirror rewrote this chunk this frame (an edit, a fluid tick,
        // a streamed chunk): whatever history says about it may be stale.
        if (hit)
        {
            float3 ch = float3(voxel >> 7);
            for (int k = 0; k < _TaaDirtyCount; k++)
                if (all(ch == _TaaDirtyChunks[k].xyz)) expD = -1.0;
        }
        uint key = hit ? (((uint)voxel.x & 0xFFu) | (((uint)voxel.y & 0xFFu) << 8) | (((uint)voxel.z & 0xFFu) << 16) | ((mat & 0xFFu) << 24))
                       : 0xFFFFFFFFu;
        uint pi = id.y * width + id.x;
        TaaCur[pi] = float4(prevPx, expD, asfloat(key));
        TaaMetaW[pi] = float2((tHit >= 0.0) ? length(P - rayStart) : -2.0, asfloat(key));
    }
    if (inBounds) ResultTexture[id.xy] = color;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 tid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID)
{
    CSMainBody(tid, gtid, false);
}

[numthreads(8, 8, 1)]
void CSMainChecker(uint3 tid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID)
{
    CSMainBody(tid, gtid, true);
}

// TASK 24: compiled with VE_DETAIL_SPEED (the #pragma kernel line above).
[numthreads(8, 8, 1)]
void CSMainDetail(uint3 tid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID)
{
    CSMainBody(tid, gtid, false);
}

// ===========================================================================
// TAA RESOLVE AND SHARPEN (task 06). Dispatched only with _TaaEnabled, after
// CSMain, at the gate resolution: (w+7)/8 x (h+7)/8 groups of 8x8.
// ===========================================================================
float3 TaaToYCoCg(float3 c)
{
    return float3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}
float3 TaaFromYCoCg(float3 y)
{
    return float3(y.x + y.y - y.z, y.x + y.z, y.x - y.y - y.z);
}
// Pull h toward the box centre until it lies inside (clip, not clamp: keeps
// the history's hue instead of snapping each channel separately).
float3 TaaClipAABB(float3 h, float3 bmin, float3 bmax)
{
    float3 c = 0.5 * (bmax + bmin);
    float3 e = 0.5 * (bmax - bmin) + 1e-5;
    float3 v = h - c;
    float3 a = abs(v / e);
    float m = max(a.x, max(a.y, a.z));
    return (m > 1.0) ? c + v / m : h;
}

// ---- CHECKERBOARD MISSING PIXEL (task 08) ----
// No sample of its own this frame. Its four cross neighbours were traced. Each
// neighbour's reprojection is a candidate motion for this pixel; the candidate
// whose history taps match that neighbour's surface (the same distance test as
// below) wins, and its history, clipped to the neighbours' YCoCg box, is the
// output. No match (disocclusion, a dirty chunk, a reset, an edit next door):
// the edge-directed average of the neighbours, which never feeds the history
// (meta distance -1), so a filled pixel cannot persist.
static const int2 kTaaCross[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };

void TaaResolveMissing(int2 p, uint width, uint height)
{
    int2 hiP = int2(width, height) - 1;
    uint pi = (uint)p.y * width + (uint)p.x;
    float3 nc[4];
    float4 nr[4];
    float nd[4];
    bool nv[4];
    float3 mn = 1e9, mx = -1e9, csum = 0.0;
    float cnt = 0.0;
    bool anyDirty = false;
    for (int k = 0; k < 4; k++)
    {
        int2 q = p + kTaaCross[k];
        nv[k] = (q.x >= 0 && q.y >= 0 && q.x <= hiP.x && q.y <= hiP.y);
        nc[k] = 0.0; nr[k] = float4(0, 0, -1, 0); nd[k] = -1.0;
        if (!nv[k]) continue;
        uint qi = (uint)q.y * width + (uint)q.x;
        nc[k] = TaaCurColor[q].rgb;
        nr[k] = TaaCur[qi];
        nd[k] = TaaMetaW[qi].x;
        float3 c = TaaToYCoCg(nc[k]);
        mn = min(mn, c); mx = max(mx, c); csum += nc[k]; cnt += 1.0;
        if (nr[k].z == -1.0) anyDirty = true;
    }

    // Spatial fallback: average the pair (horizontal or vertical) that differs
    // less, so an edge through this pixel is continued rather than blurred.
    float3 fill = csum / max(cnt, 1.0);
    if (nv[0] && nv[1] && nv[2] && nv[3])
    {
        float3 lw = float3(0.299, 0.587, 0.114);
        float dh = abs(dot(nc[0] - nc[1], lw)), dv = abs(dot(nc[2] - nc[3], lw));
        fill = (dh < dv) ? 0.5 * (nc[0] + nc[1]) : (dv < dh) ? 0.5 * (nc[2] + nc[3]) : fill;
    }
    float3 outc = fill;
    float2 meta = float2(-1.0, asfloat(0xFFFFFFFFu));

    if (_TaaHistValid != 0 && !anyDirty)
    {
        // The neighbours' depth slope (distance from the previous camera), per
        // pixel: half the difference across this pixel on each axis.
        float gx = (nv[0] && nv[1] && nr[0].z >= 0.0 && nr[1].z >= 0.0) ? 0.5 * abs(nr[0].z - nr[1].z) : 0.0;
        float gy = (nv[2] && nv[3] && nr[2].z >= 0.0 && nr[3].z >= 0.0) ? 0.5 * abs(nr[2].z - nr[3].z) : 0.0;
        float bestW = 0.0, bestD = 0.0;
        int bestK = -1;
        float3 bestH = 0.0;
        uint bestKey = 0xFFFFFFFFu;
        for (int k = 0; k < 4; k++)
        {
            if (!nv[k]) continue;
            float z = nr[k].z;
            float tol = (z >= 0.0) ? min(max(2.0, z * 0.02) + 1.5 * (gx + gy), max(2.0, z * 0.5)) : 0.0;
            // This pixel's previous position if it moved like neighbour k.
            float2 x = nr[k].xy - float2(kTaaCross[k]) - 0.5;
            int2 b = int2(floor(x));
            float2 f = x - float2(b);
            float wsum = 0.0, dsum = 0.0, wtop = 0.0;
            float3 hsum = 0.0;
            uint ktop = 0xFFFFFFFFu;
            for (int t = 0; t < 4; t++)
            {
                int2 o = int2(t & 1, t >> 1);
                int2 q = b + o;
                if (q.x < 0 || q.y < 0 || q.x > hiP.x || q.y > hiP.y) continue;
                float w = (o.x ? f.x : 1.0 - f.x) * (o.y ? f.y : 1.0 - f.y);
                uint qi = (uint)q.y * width + (uint)q.x;
                float2 hm = TaaMetaR[qi];
                bool ok = (z < 0.0) ? (hm.x == -2.0) : (hm.x >= 0.0 && abs(hm.x - z) <= tol);
                if (!ok) continue;
                wsum += w; dsum += w * hm.x; hsum += w * TaaColR[qi].rgb;
                if (w > wtop) { wtop = w; ktop = asuint(hm.y); }
            }
            if (wsum > bestW) { bestW = wsum; bestK = k; bestH = hsum / wsum; bestD = dsum / wsum; bestKey = ktop; }
        }
        if (bestK >= 0 && bestW > 1e-3)
        {
            outc = TaaFromYCoCg(TaaClipAABB(TaaToYCoCg(bestH), mn, mx));
            // Next frame's meta: the history's own distance, moved by the change
            // the matching neighbour saw (previous camera -> this camera).
            float z = nr[bestK].z;
            meta = float2((z < 0.0) ? -2.0 : bestD + (nd[bestK] - z), asfloat(bestKey));
        }
    }
    TaaColW[pi] = float4(outc, 1.0);
    TaaMetaW[pi] = meta;
}

[numthreads(8, 8, 1)]
void TaaResolve(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    TaaCurColor.GetDimensions(width, height);
    if (id.x >= width || id.y >= height) return;
    int2 p = int2(id.xy);
    int2 hiP = int2(width, height) - 1;
    uint pi = id.y * width + id.x;

    // Checkerboard: a pixel CSMain did not trace this frame is filled; a traced
    // one resolves below with its neighbourhood and slope taken from traced
    // pixels only (itself + the 4 diagonals; +-2 along each axis).
    bool checker = (_TaaChecker != 0);
    if (checker && ((((uint)(p.x + p.y)) & 1u) != _TaaCheckerParity)) { TaaResolveMissing(p, width, height); return; }
    int ss = checker ? 2 : 1;

    float3 cur = TaaCurColor[p].rgb;
    float3 m1 = 0.0, m2 = 0.0, mn = 1e9, mx = -1e9;
    float nb = 0.0;
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++)
    {
        if (checker && ((dx + dy) & 1) != 0) continue;
        float3 c = TaaToYCoCg(TaaCurColor[clamp(p + int2(dx, dy), 0, hiP)].rgb);
        m1 += c; m2 += c * c; mn = min(mn, c); mx = max(mx, c); nb += 1.0;
    }
    float3 mu = m1 / nb;
    float3 sigma = sqrt(max(0.0, m2 / nb - mu * mu));
    float3 bmin = max(mn, mu - 1.25 * sigma);
    float3 bmax = min(mx, mu + 1.25 * sigma);

    float4 rp = TaaCur[pi];
    float3 outc = cur;
    if (_TaaHistValid != 0 && rp.z != -1.0)
    {
        // "Same surface?" -- the temporal-shadow test (2% + 2 voxels), widened
        // by the surface's own depth slope: on ground seen at a grazing angle
        // one pixel spans far more than 2%. The slope is the SMALLER of the two
        // one-sided differences per axis, so a silhouette (one side a cliff
        // drop, the other continuous) does not widen it.
        float tol = 0.0;
        if (rp.z >= 0.0)
        {
            float zl = TaaCur[(uint)p.y * width + (uint)clamp(p.x - ss, 0, hiP.x)].z;
            float zr = TaaCur[(uint)p.y * width + (uint)clamp(p.x + ss, 0, hiP.x)].z;
            float zd = TaaCur[(uint)clamp(p.y - ss, 0, hiP.y) * width + (uint)p.x].z;
            float zu = TaaCur[(uint)clamp(p.y + ss, 0, hiP.y) * width + (uint)p.x].z;
            // (Checkerboard: a clamped +-2 tap at the border can land on an
            // untraced pixel holding last frame's data; it only loosens the
            // tolerance on the outermost column/row.)
            float gx = min(zl >= 0.0 ? abs(zl - rp.z) : 1e9, zr >= 0.0 ? abs(zr - rp.z) : 1e9) / ss;
            float gy = min(zd >= 0.0 ? abs(zd - rp.z) : 1e9, zu >= 0.0 ? abs(zu - rp.z) : 1e9) / ss;
            tol = min(max(2.0, rp.z * 0.02) + 1.5 * (min(gx, 1e6) + min(gy, 1e6)), max(2.0, rp.z * 0.5));
        }
        uint ck = asuint(rp.w);

        float2 x = rp.xy - 0.5;
        int2 b = int2(floor(x));
        float2 f = x - float2(b);
        float wsum = 0.0;
        float3 hsum = 0.0;
        for (int t = 0; t < 4; t++)
        {
            int2 o = int2(t & 1, t >> 1);
            int2 q = b + o;
            if (q.x < 0 || q.y < 0 || q.x > hiP.x || q.y > hiP.y) continue;
            float w = (o.x ? f.x : 1.0 - f.x) * (o.y ? f.y : 1.0 - f.y);
            uint qi = (uint)q.y * width + (uint)q.x;
            float2 hm = TaaMetaR[qi];
            bool ok = (rp.z < 0.0) ? (hm.x == -2.0) : (hm.x >= 0.0 && abs(hm.x - rp.z) <= tol);
            // Same voxel, different material: it was edited (or flowed).
            uint hk = asuint(hm.y);
            if (ok && ck != 0xFFFFFFFFu && hk != 0xFFFFFFFFu && (hk & 0xFFFFFFu) == (ck & 0xFFFFFFu) && (hk >> 24) != (ck >> 24)) ok = false;
            if (ok) { wsum += w; hsum += w * TaaColR[qi].rgb; }
        }
        if (wsum > 1e-3)
        {
            float3 hist = TaaFromYCoCg(TaaClipAABB(TaaToYCoCg(hsum / wsum), bmin, bmax));
            float motion = length(rp.xy - (float2(p) + 0.5));
            float alpha = lerp(_TaaParams.x, _TaaParams.y, saturate(motion / max(_TaaParams.z, 1e-3)));
            // Part of the footprint was rejected (a disocclusion edge): trust the
            // history less, down to none at all.
            alpha = 1.0 - (1.0 - alpha) * saturate(wsum * 2.0);
            // Luminance-weighted blend, so one bright sample cannot dominate.
            float wc = alpha / (1.0 + dot(cur, float3(0.299, 0.587, 0.114)));
            float wh = (1.0 - alpha) / (1.0 + dot(hist, float3(0.299, 0.587, 0.114)));
            outc = (cur * wc + hist * wh) / max(wc + wh, 1e-6);
        }
    }
    TaaColW[pi] = float4(outc, 1.0);
}

[numthreads(8, 8, 1)]
void TaaSharpen(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    ResultTexture.GetDimensions(width, height);
    if (id.x >= width || id.y >= height) return;
    int2 p = int2(id.xy);
    int2 hiP = int2(width, height) - 1;
    float3 c = TaaColS[id.y * width + id.x].rgb;
    float3 l = TaaColS[(uint)p.y * width + (uint)clamp(p.x - 1, 0, hiP.x)].rgb;
    float3 r = TaaColS[(uint)p.y * width + (uint)clamp(p.x + 1, 0, hiP.x)].rgb;
    float3 d = TaaColS[(uint)clamp(p.y - 1, 0, hiP.y) * width + (uint)p.x].rgb;
    float3 u = TaaColS[(uint)clamp(p.y + 1, 0, hiP.y) * width + (uint)p.x].rgb;
    float3 s = c + _TaaParams.w * (c - 0.25 * (l + r + d + u));
    // No overshoot: the sharpened value stays inside its cross neighbourhood.
    float3 lo = min(c, min(min(l, r), min(d, u)));
    float3 hi = max(c, max(max(l, r), max(d, u)));
    ResultTexture[id.xy] = float4(clamp(s, lo, hi), 1.0);
}

// ===========================================================================
// SHADOW ROOF SKIP -- the per-frame pyramid build. One thread per ring column.
// ===========================================================================
[numthreads(8, 8, 1)]
void BuildHeightRaw(uint3 id : SV_DispatchThreadID)
{
    int nx = (int)_WindowDimsBricksPacked.x, nz = (int)_WindowDimsBricksPacked.z;
    if ((int)id.x >= nx || (int)id.y >= nz) return;
    int3 o = _WindowOriginBricksPacked.xyz;
    // The one world brick column in the window that maps to this ring slot.
    int bx = o.x + (((int)id.x - o.x) & (nx - 1));
    int bz = o.z + (((int)id.y - o.z) & (nz - 1));
    int yHi = min(o.y + (int)_WindowDimsBricksPacked.y, (_ContentCeilingVoxelY + 7) >> 3);
    uint top = 0u;
    [loop]
    for (int by = yHi - 1; by >= o.y; by--)
    {
        uint h = ReadClipmap(int3(bx, by, bz), _WindowDimsBricksPacked.xyz);
        if ((h & 0x80000000u) != 0u || (h & 0xFFu) != 0u) { top = (uint)((by + 1) << 3); break; }
    }
    HeightMip[_HeightOffsetsB.z + (int)id.x + (int)id.y * nx] = top;
}

[numthreads(8, 8, 1)]
void BuildHeightDilate(uint3 id : SV_DispatchThreadID)
{
    int nx = (int)_WindowDimsBricksPacked.x, nz = (int)_WindowDimsBricksPacked.z;
    if ((int)id.x >= nx || (int)id.y >= nz) return;
    uint m = 0u;
    [unroll] for (int dz = -1; dz <= 1; dz++)
    [unroll] for (int dx = -1; dx <= 1; dx++)
    {
        int x = ((int)id.x + dx) & (nx - 1);
        int z = ((int)id.y + dz) & (nz - 1);
        m = max(m, HeightMip[_HeightOffsetsB.z + x + z * nx]);
    }
    HeightMip[_HeightOffsetsA.x + (int)id.x + (int)id.y * nx] = (m + 15u) & ~15u;
}

[numthreads(8, 8, 1)]
void BuildHeightLevel(uint3 id : SV_DispatchThreadID)
{
    int L = _HeightLevel;
    int nx = (int)_WindowDimsBricksPacked.x >> L, nz = (int)_WindowDimsBricksPacked.z >> L;
    if ((int)id.x >= nx || (int)id.y >= nz) return;
    int cnx = nx << 1;
    int src = HeightOffset(L - 1);
    int x2 = (int)id.x << 1, z2 = (int)id.y << 1;
    uint m = max(max(HeightMip[src + x2 + z2 * cnx], HeightMip[src + x2 + 1 + z2 * cnx]),
                 max(HeightMip[src + x2 + (z2 + 1) * cnx], HeightMip[src + x2 + 1 + (z2 + 1) * cnx]));
    HeightMip[HeightOffset(L) + (int)id.x + (int)id.y * nx] = m;
}

// ===========================================================================
// FAR BAND upkeep kernels (FarField.cs). FarScatter writes one staged strip
// into its level's ring; FarMipBuild rebuilds one mip of one level from the
// mip below. Ring-slot arithmetic only: mip k's slot s has children 2s and
// 2s+1 in mip k-1's ring of twice the size, which holds because the ring
// origins are aligned to the coarsest cell.
// ===========================================================================
[numthreads(64, 1, 1)]
void FarScatter(uint3 id : SV_DispatchThreadID)
{
    int n = _FarScatter.z * _FarScatter.w;
    int i = (int)id.x;
    if (i >= n) return;
    int tx = _FarScatter.x + i % _FarScatter.z;
    int tz = _FarScatter.y + i / _FarScatter.z;
    FarTexelsRW[_FarScatterLevel * FAR_LEVEL_TEXELS + ((tz & FAR_MASK) << 10) + (tx & FAR_MASK)] = FarStaging[i];
}

[numthreads(8, 8, 1)]
void FarMipBuild(uint3 id : SV_DispatchThreadID)
{
    int k = _FarMipK;
    int n = FAR_EDGE >> k;
    if ((int)id.x >= n || (int)id.y >= n) return;
    int n2 = n * 2;
    uint m = 0u;
    for (int j = 0; j < 2; j++)
    for (int i = 0; i < 2; i++)
    {
        int cx = (int)id.x * 2 + i;
        int cz = (int)id.y * 2 + j;
        uint h = (k == 1)
            ? (FarTexelsRW[_FarMipLevel * FAR_LEVEL_TEXELS + (cz << 10) + cx] & 0xFFFFu)
            : FarMipsRW[_FarMipLevel * FAR_MIPS_PER_LEVEL + FarMipOffset(k - 1) + cz * n2 + cx];
        m = max(m, h);
    }
    FarMipsRW[_FarMipLevel * FAR_MIPS_PER_LEVEL + FarMipOffset(k) + (int)id.y * n + (int)id.x] = m;
}

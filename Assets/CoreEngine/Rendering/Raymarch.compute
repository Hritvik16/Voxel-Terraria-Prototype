// Assets/CoreEngine/Rendering/Raymarch.compute
//
// AMENDMENT 8.9 / §6.4 LOD CASCADE ADDITION:
// New buffers/params for cascade tiers 1-2, and a new coarse-tier traversal
// branch, ALL gated behind _UseLODCascade (default 0 from C#). When that flag
// is 0, "tier" is forced to 0 every iteration and the ENTIRE original tier-0
// code path below runs completely unchanged - same buffers, same branches,
// same math, byte-for-byte identical to the pre-LOD file. This is deliberate:
// every number in Amendment 8.9 was measured against the old code path, and
// none of that measurement is invalidated by this file until _UseLODCascade
// is explicitly turned on for a new benchmark run.
//
// Coarse-tier design: the ray's DDA state (voxel, tMax, tDelta, step) stays
// in RAW TIER-0 VOXEL UNITS for the whole ray, always. Tiers 1/2 don't get
// their own coordinate space - they just read coarser clipmap/brick buffers
// and treat one coarse brick's span as (8 << tierShift) raw voxels instead of
// 8. This means LeapSpanReseedClosedForm (unchanged, already CPU-fuzz-proven
// per Amendment 8.9 §6) is reused AS-IS for tier 1/2 empty-brick leaps - no
// new DDA math, just a bigger span passed to proven code.
//
// KNOWN LIMITATION, FIXED THIS PASS (was open, now resolved - see chat): the
// coarse-tier dense-brick path used to step ONE RAW VOXEL at a time even
// though a tier-2 coarse voxel is 4 raw voxels wide, costing up to 4
// iterations per coarse voxel crossed instead of 1. A real benchmark
// (Mode4-DenseSkip, cascade ON vs OFF, same pose) measured this costing
// ~83% - nearly 2x - before the fix, confirming the file's own earlier
// prediction. Fixed by leaping the full raw-voxel span of an air coarse
// voxel via the same already-proven LeapSpanReseedClosedForm the empty-
// brick case already used, just with a one-coarse-voxel-sized span instead
// of a whole-brick-sized one. See the tier>0 dense branch below for the
// exact change. NOT yet re-measured after this fix - that's the next
// verification step, not something to assume from the reasoning alone.
//
// STILL OPEN, NOT ADDRESSED THIS PASS: tiers 1/2 still have no air-mip
// pyramid equivalent - empty coarse BRICKS are still skipped one brick at a
// time (see the empty-brick leap below), with no multi-level hierarchy to
// leap across many bricks at once the way tier 0's pyramid does. If the fix
// above isn't enough on its own to close the gap with cascade-off, this is
// the next thing to build, not a smaller tweak to the fix above.
// ===========================================================================
// §6.5's 8.4 BRANCH GUARD: TWO ATTEMPTS AT WAVE INTRINSICS FAILED ON THIS
// TARGET. THE THIRD IS GROUPSHARED, IT IS PORTABLE, AND IT IS BETTER.
//
// §6.5 asks, in terms, for `WaveActiveAnyTrue(hasPrimaryHit)` around the shadow
// branch, and says to build it in from the start rather than retrofit it after
// a budget miss. §6.5's rung 1 similarly wants "neighbour reuse", for which
// QuadReadLaneAt is the natural primitive. Neither is available here:
//
//   ATTEMPT 1 -- plain build, legacy compute compiler:
//     "Shader error in 'Raymarch': undeclared identifier 'WaveActiveAnyTrue'
//      at kernel CSMain at Raymarch.compute(1532) (on metal)"
//   ATTEMPT 2 -- #pragma use_dxc:
//     "DXC SPIRV-Cross error: Subgroups are only supported in Metal 2.0 and up.
//      at kernel CSMain"
//
// A third attempt at the intrinsics would have meant raising the project's
// Metal/MSL floor in ProjectSettings -- a global change to every shader and to
// the shipping macOS minimum, for one branch guard. That is the owner's call,
// not a side effect of a lighting phase, and §0.3's debugging rule says to stop
// patching after ~3 attempts rather than reach for a cleverer one.
//
// THE GROUPSHARED FORM BELOW IS NOT A CONSOLATION PRIZE. It achieves exactly
// what §6.5 asks for -- "a wave that is ENTIRELY sky skips instantiating the
// shadow-ray code path altogether" -- at 64-thread THREAD-GROUP granularity
// instead of 32-thread wave granularity. Coarser by a factor of two, same
// mechanism. And for rung 1 it is strictly BETTER than QuadReadLaneAt: reading
// gsSunVis[(gtid.y & ~1) * 8 + (gtid.x & ~1)] is an exact, stated index, where
// QuadReadLaneAt would have relied on the SM6.0 assumption that quad lane 0 is
// the even/even thread -- an assumption that could have been silently wrong on
// this driver and would have shown up only as distant shadows sampling the
// wrong neighbour.
//
// AND IT KEEPS THE MEASUREMENT CLEAN. Reverting use_dxc means this shader is
// still built by the same compiler as every historical number in Amendments
// 8.9/8.10, PHASE_2 §5 and FPS_INVESTIGATION. Had DXC been kept, every Stage 6
// arm would have carried a compiler change as a confound and the
// pre-Phase-7 baseline would not have been comparable.
//
// THE COST OF THE BARRIERS, and the one restructure they forced: a group
// barrier requires EVERY thread in the group to reach it, so CSMain's
// out-of-bounds early `return` had to become a flag tested at the final write.
// Out-of-bounds threads therefore traverse. At the shipped 960x540 gate that is
// 4 rows of 960 threads out of 2,073,600 -- 0.185% -- and at 1920x1080 both
// dimensions divide by 8 exactly, so it is 0.000%.
// ===========================================================================
#pragma kernel CSMain
#pragma kernel BuildHeightRaw
#pragma kernel BuildHeightDilate
#pragma kernel BuildHeightLevel
#pragma kernel FarScatter
#pragma kernel FarMipBuild
#pragma kernel TaaResolve
#pragma kernel TaaSharpen
#pragma kernel CSMainChecker
// TASK 24: CSMain + the voxel-detail square (DetailRadius.cs). Every task-24
// line is under #ifdef VE_DETAIL_SPEED, so CSMain/CSMainChecker compile from
// exactly the pre-task code; RaymarchFeature dispatches this kernel only
// while the square is active (-detailspeed 1 and the camera moving).
#pragma kernel CSMainDetail VE_DETAIL_SPEED

#include "../Coord/CoordMath.hlsl"
#include "../Memory/StructHeaders.hlsl"

RWTexture2D<float4> ResultTexture;
StructuredBuffer<uint> ClipmapBuffer;
StructuredBuffer<uint> BrickDataBuffer;

// --- LOD CASCADE: tier 1 (0.2m) and tier 2 (0.4m) clipmap + brick data ---
// Bound even when _UseLODCascade==0 (RaymarchFeature falls back to binding
// the tier-0 buffers as harmless dummies in that case, same pattern already
// used for AirMip2-4 when fewer levels are built) so the shader never reads
// an unset buffer.
StructuredBuffer<uint> ClipmapBufferTier1;
StructuredBuffer<uint> BrickDataBufferTier1;
StructuredBuffer<uint> ClipmapBufferTier2;
StructuredBuffer<uint> BrickDataBufferTier2;
uint4 _WindowDimsCoarseBricksTier1; // .xyz = coarse-brick dims, .w unused
uint4 _WindowDimsCoarseBricksTier2;

// .x = tier0 outer bound, .y = tier1 outer bound, .z = tier2 outer bound (the
// true ray-travel cap when cascade is active), .w unused. All in RAW VOXEL
// UNITS (meters * 10), matching currentDist's units. Set from
// LODConfig.TIER_OUTER_RANGE_M by RaymarchFeature - this shader has no
// knowledge of the meter values itself, only the voxel-unit conversion.
float4 _TierOuterRangeVoxels;
int _UseLODCascade;

// --- AIR-MIP: legacy four-buffer form (modes 0-4) ---
StructuredBuffer<uint> AirMip1;
StructuredBuffer<uint> AirMip2;
StructuredBuffer<uint> AirMip3;
StructuredBuffer<uint> AirMip4;
uint4 _AirMipDims0;
uint4 _AirMipDims1;
uint4 _AirMipDims2;
uint4 _AirMipDims3;
uint  _AirMipLevelCount;

// --- AIR-MIP: packed + merged form (optimization pass) ---
// One buffer, all levels, 1 bit per cell. _MipInfo[k-1] = (dimX, dimY, dimZ,
// wordOffset) for level k. Removes the 4-way dynamic branch over four separate
// buffers AND shrinks the pyramid from ~38 MB to ~1.2 MB so it fits in cache.
StructuredBuffer<uint> AirMipPacked;
float4 _MipInfo[4];
int _UsePackedMips;

float4x4 _CameraInverseProjection;
float4x4 _CameraInverseView;
float3 _CameraPos;
uint4 _WindowDimsBricksPacked;

// --- PHASE 4: sliding window ---
// The clipmap is now CHUNK-MAJOR: flat = chunkSlot*4096 + localBrickIndex.
// See TerrainClipmap.cs's header for the derivation (brick-linear made a
// boundary-crossing slab ~16,000 scattered upload ranges; chunk-major makes it
// 64 contiguous ones).
uint4 _WindowDimsChunksPacked;   // .xyz = window size in CHUNKS

// Minimum corner of the resident window, in BRICKS. Was implicitly (0,0,0)
// while the window was static; the Phase 3 XZ bounds guard said so in its own
// PHASE 4 NOTE. Now supplied by RaymarchFeature every frame.
int4 _WindowOriginBricksPacked;

// Highest world voxel Y that generation can produce content for, +1. Replaces
// the hardcoded 128 in the early-exit below.
//
// DELIBERATELY NOT the window's Y extent. The window reaches 256 voxels at
// WINDOW_CHUNKS_Y=2 but nothing generates above 128, and §6.1 showed grazing
// and sky rays are exactly where the iteration budget goes -- terminating them
// at the CONTENT ceiling rather than the WINDOW ceiling halves their travel.
// Folding this into the window bounds test would be a silent perf regression.
int _ContentCeilingVoxelY;
// V2: the loaded band's floor (0 for a flat world -- the old hard `y < 0`).
int _ContentFloorVoxelY;

// Cascade tier geometry: .x = coarse bricks per chunk edge, .y = log2 of that,
// .z = coarse-brick entries per chunk. Tier 1 = (8,3,512), tier 2 = (4,2,64).
uint4 _CascadeTierInfo1;
uint4 _CascadeTierInfo2;

RWStructuredBuffer<float> DebugOut;

// ===========================================================================
// STAGE F -- SHADOW BRANCH STATISTICS, frame-wide.
//
// §0.3's rule and this project's repeated experience: instrument before
// guessing. Rung 1 measures indistinguishable from rung 0 (53.0 vs 52.06 ms),
// and PHASE_7_COMPLETION §E.2 offered a HYPOTHESIS for why -- that the
// half-res branch rarely engages because most hit pixels are nearer than the
// 128 m LOD1 boundary. A hypothesis is not a cause. These counters settle it
// with a number.
//
//   [0] pixels with a primary hit
//   [1] pixels beyond the LOD1 boundary (the ones rung 1 targets)
//   [2] shadow rays ACTUALLY TRACED
//   [3] pixels that took a REUSED value instead of tracing
//
// InterlockedAdd per pixel is genuinely expensive and is why this is behind
// _CollectShadowStats, off by default and enabled only for the diagnostic arm.
// It measures BRANCH ENGAGEMENT, not time -- the timing arms stay clean.
// ===========================================================================
RWStructuredBuffer<uint> ShadowStats;
int _CollectShadowStats;

// ---- TEMPORAL SHADOW REUSE (2026-09-26; owner target 60 FPS) ----
// The sun ray was measured at ~2/3 of the frame on the in-air orbit (51.7 ms
// with shadows, 18.6 ms without). The world is static between edits, so a
// pixel traces its sun ray on ONE frame in four (a rotating 2x2 pattern) and
// otherwise reuses last frame's value at its reprojected position -- only when
// the previous frame traced the SAME shadow origin there; anything newly
// revealed traces. Off unless _TemporalShadows (-tshadow 1).
//
// TASK 56 (BUGS #1, the owner's "shadow acne -- dots on the terrain"). The
// history used to be looked up at the hit voxel's CENTRE, a point inside the
// solid: on a top face seen at walking height it projects ~1.5 voxels nearer
// the camera, onto the NEIGHBOUR's face, and "same surface" was a depth window
// (2% + 2 voxels) that the neighbour passes. So the non-tracing tiles showed
// their neighbours' shadows: a lattice of 8x8-pixel squares, lit-in-dark and
// dark-in-light, on stepped ground at a low sun (1-6% of pixels disagreed
// with ShadowRayReference at golden hour; 0.01-0.5% with -tshadow 0).
// Now the pixel's own SURFACE POINT is reprojected (as TAA does) and the
// history is keyed by the shadow-origin cell (hit voxel + normal), which is
// everything TraceShadowRay's result depends on: a match reuses exactly the
// value this pixel would trace (bar the sun's drift over a few frames).
StructuredBuffer<uint2> ShadowHistR;      // x = asuint(sunVis), y = ShadowOriginKey; 0xFFFFFFFF = none
RWStructuredBuffer<uint2> ShadowHistW;
float4x4 _PrevViewProj;
int _TemporalShadows;
int _ShadowHistValid;
uint _ShadowFrame;
uint2 _DebugPixel;

// ---- TEMPORAL ANTI-ALIASING (overnight task 06, 2026-10-02) ----
// Off unless _TaaEnabled (-taa 1 / Playground F4); with it 0 CSMain runs
// exactly as before and the two TAA kernels are never dispatched. With it on:
// every primary ray is jittered by _TaaJitter (gate pixels, Halton 2,3, set by
// RaymarchFeature), CSMain writes this frame's colour to a scratch target and,
// per pixel, WHERE ITS HIT WAS IN THE PREVIOUS FRAME (the exact hit point
// projected through _PrevViewProj -- the temporal-shadow machinery's matrix;
// no motion-vector pass) plus a "same surface?" key. TaaResolve blends it with
// the reprojected history (clipped to the 3x3 neighbourhood in YCoCg) and
// TaaSharpen writes the result, lightly sharpened, to the real target.
int _TaaEnabled;
float2 _TaaJitter;
int _TaaHistValid;
float4x4 _TaaPrevViewProj;      // previous frame's UNJITTERED view-projection (metres)
float4 _TaaPrevCamVox;          // previous frame's camera, voxels
float4 _TaaParams;              // x = current weight when still, y = when moving fast, z = motion (px) for y, w = sharpen
float4 _TaaDirtyChunks[16];     // chunks the GPU mirror rewrote this frame (edits, streaming): no history there
int _TaaDirtyCount;
// CHECKERBOARD (task 08, -checker; only with _TaaEnabled). The kernel
// CSMainChecker (CSMain's body with checker = true) is dispatched at half width
// and thread (x, y) traces pixel (2x + ((y + parity) & 1), y): the pixels with
// ((px + py) & 1) == _TaaCheckerParity, which flips every frame. TaaResolve
// fills the other half from history (see TaaResolveMissing). CSMain itself is
// the same body with checker = false, folded away at compile time, so the
// shipped kernel's code is unchanged (a runtime uniform here moved the TAA-off
// image by a few silhouette pixels: Metal recompiled the float maths).
int _TaaChecker;
uint _TaaCheckerParity;
// x,y = previous-frame pixel position of this pixel's surface (pixel centres at
// k + 0.5, this frame's jitter already removed); z = that point's distance from
// the PREVIOUS camera in voxels (-2 = sky, -1 = no history allowed);
// w = asfloat(key): voxel xyz & 0xFF | material << 24, 0xFFFFFFFF = no voxel.
RWStructuredBuffer<float4> TaaCur;
RWStructuredBuffer<float2> TaaMetaW;    // this frame: (distance from THIS camera, key) -- next frame's history meta
StructuredBuffer<float2> TaaMetaR;      // previous frame's TaaMetaW
StructuredBuffer<float4> TaaColR;       // previous frame's resolved colour (unsharpened)
RWStructuredBuffer<float4> TaaColW;
StructuredBuffer<float4> TaaColS;       // TaaSharpen's input: this frame's TaaColW
Texture2D<float4> TaaCurColor;          // TaaResolve's input: CSMain's output this frame

// 0=Beauty 1=StepHeat 2=UniformDense 3=Normals 4=NonExitHeat 5=VoxelGrain 6=LODTier
int4 _DebugModePacked;

int _MaxOuterIterations;

// Max ray travel in VOXELS (128 m = 1280 voxels). Lowering this is the LOD0
// radius trim: the 128 m figure was derived for a 1080p pixel-footprint match,
// so at 960x540 the matched distance is roughly half that. NOTE: with LOD1
// unimplemented (Phase 4), trimming this makes distant terrain vanish rather
// than drop to a coarser level - it measures the cost saving honestly but is
// not a shippable configuration on its own.
// (LOD cascade is now implemented behind _UseLODCascade - when that's on,
// RaymarchFeature overrides the effective max distance to
// _TierOuterRangeVoxels.z instead of using this constant. This field/comment
// is otherwise unchanged so the pre-cascade A/B measurements stay meaningful.)
float _MaxRayDistance;

int _TraversalMode;

// NEW: developer material color palette + per-voxel grain toggle for the
// default Beauty output (DebugMode 0 only - diagnostic views are untouched).
// Defaults ON. Set to 0 to reproduce the original flat-gray Beauty shading
// exactly, byte-for-byte, for any comparison against pre-existing screenshots.
int _UseDevColors;

// ---- PRESENTATION FLAGS (shading step only) ----
// Every one of these gates a purely cosmetic term applied AFTER traversal has
// already resolved which voxel and which face a ray hit. None of them is read
// by any stepping, addressing or LOD-selection code. Set them to 0 and the
// output collapses to the pre-existing look, which is why they are flags and
// not edits: Phase 7's real lighting (§6.5) can switch any of them off without
// unpicking anything.
int   _ShadeAO;        // per-face ambient occlusion from neighbour occupancy
int   _ShadeHemi;      // sky/ground hemisphere tint
int   _ShadeFog;       // distance fog toward the sky colour
float4 _SkyColor;      // also the fog target and the "up" hemisphere tint
float  _FogStartM;
float  _FogEndM;

// ===========================================================================
// PHASE 7 -- LIGHTING (§6.5, §3.8, C.9 / C.10 / C.11)
//
// Everything below is read ONLY after traversal has resolved a hit, except
// _ShadowQualityLevel and _SunDir, which gate whether the fused shadow ray runs
// at all. No stepping, addressing or LOD-selection code for the PRIMARY ray
// reads any of it -- so with _ShadowQualityLevel == 3 (rung "off") and the
// lighting terms neutral, the tier-0 path is the pre-Phase-7 path. That claim
// is not left as an argument from code structure: RaymarchLightingTests and the
// Phase 7 rig both check an EXACT traversal-counter match at a pose where the
// shadow branch cannot engage, the way Amendment 8.10 §2 proved the cascade's
// tier-0 path unchanged (denseMicroSteps 116 == 116).
// ===========================================================================

// A.6 point lights (§3.8). Always MAX_ACTIVE_LIGHTS entries; _ActiveLightCount
// says how many are live this frame. Selection (nearest-to-player, furthest
// dropping first) happens on the CPU in LightSourceBuffer.SelectActive -- the
// shader never decides which lights to drop, it just reads the first N.
StructuredBuffer<LightSource> LightBuffer;
uint _ActiveLightCount;

// The two animated uniforms §6.5 calls for: "sun direction + color are two
// animated uniforms from the in-game clock."
// _SunDir points FROM a surface TOWARD the sun -- the direction a shadow ray
// travels, and the L in C.9's max(0, N.L).
// _SunColor is EXACTLY zero below the horizon, not merely small, so this and
// the "is the sun up" branch can never disagree about whether it is night.
float3 _SunDir;
float3 _SunColor;

// C.9's ambientSky, already scaled by intensity and by time of day.
float3 _AmbientColor;

// C.10's penumbra constant. 0 => hard shadows (a BRANCH, not a limit --
// smoothstep with a zero-width edge is undefined).
float _KSoft;
int   _MaterialVariation;
float _MaterialVariationAmount;

// =====================================================================
// SHADOW LOD BY *TRAVEL* AS WELL AS BY CAMERA DISTANCE.
//
// §6.5's 8.2 rule pins shadow LOD to CAMERA distance to the sample, and it is
// right to: the retracted 8.1 rule (coarsen by travelled distance alone) let a
// short shadow ray evaluate a distant mountain at fine LOD, so the cast shadow
// did not match the silhouette the camera drew -- detached, floating shadows.
//
// But 8.2 alone is what makes golden hour cost 9-12 ms. At a 6 degree sun the
// ray travels almost horizontally ALONG the surface, so its samples stay close
// to the camera and it marches per-voxel through dense bricks -- calling
// ShadowClearance (up to six clipmap reads) at every step -- for a hundred
// metres. §6.5's own cost note assumes the opposite ("mostly through uniform-Air
// leaps at coarse LOD"), and that assumption does not hold for the exact case
// the gate is measured at.
//
// THE FIX TAKES THE COARSER OF THE TWO RULES:
//
//     tier = max(tierByCameraDistance, tierByTravelDistance)
//
// max() is what makes this safe. It can only ever coarsen, never refine, so the
// shadow is NEVER evaluated at finer detail than the camera draws that geometry
// -- which is precisely the condition 8.1 violated and 8.2 exists to guarantee.
// 8.2's acceptance test (a player in a distant mountain's shadow sees the edge
// align with the silhouette) is unaffected: for distant geometry the camera term
// already returns tier 2 and max() leaves it there.
//
// WHY COARSENING BY TRAVEL IS INVISIBLE. C.10 already blurs the shadow edge by
// smoothstep(0, _KSoft, m) with m = min(clearance/t), so the penumbra half-width
// at travel t is ~ _KSoft * t voxels. Once that exceeds the tier's voxel size,
// detail finer than the tier is *already* being blurred away by the penumbra --
// sampling it is work whose result cannot be seen. At the shipped _KSoft = 0.03
// tier 1 (2 voxels) is justified beyond ~6.7 m of travel and tier 2 (4 voxels)
// beyond ~13.3 m.
//
// _ShadowTravelLOD is that threshold's multiplier: <= 0 disables the rule
// entirely (exactly the shipped 8.2 behaviour, so every historical measurement
// stays reproducible), 1.0 is the penumbra-derived threshold above, and larger
// values are more conservative.
// =====================================================================
float _ShadowTravelLOD;


// §6.5's fallback ladder, from EngineConfig.SHADOW_QUALITY_LEVEL:
//   0 full penumbra | 1 half-res beyond LOD1 | 2 hard only | 3 off
// All four are compiled in so ONE binary can be measured at every rung in one
// session -- FPS_INVESTIGATION_RESULTS.md §3.2 records a CROSS-session
// comparison producing a wrong number because the untouched arm drifted.
int _ShadowQualityLevel;

// Runaway guard for the shadow DDA. Counts OUTER iterations, like
// _MaxOuterIterations, not voxels -- each can leap a whole air brick or
// air-mip cell.
int _MaxShadowSteps;

// C.9 applies max(0, N.L) to the SUN term only; the pointLights term is bare.
// Implemented literally by default (0). See the FLAG in PHASE_7_COMPLETION.md:
// the literal reading lights faces pointing away from a torch, which reads as
// flat. 1 applies N.L to point lights too. Shipped at the literal reading so
// the owner judges the deviation rather than inheriting it.
int _PointLightNdotL;

// FLAG (§6.5's three simultaneous ambient requirements). 1 = modulate ambient
// by a straight-up sky-visibility probe so deep caves are genuinely dark; 0 =
// plain hemisphere term, which lights a cave ceiling as brightly as open sky.
// Measured as its own arm; see AMENDMENT_8_12_PHASE7_GATE.md.
int _UseSkyProbeAmbient;

// Fraction of ambient surviving with zero sky visibility -- §6.5's
// "underground reads near-zero ambient". Art constant, live-tunable via
// LightingConfig.json.
float _UndergroundAmbientFloor;

// ===========================================================================
// TONEMAPPING (§6.1: "Palette/mood/post are deferred to visual prototyping in
// Phases 2 and 7." This is Phase 7, and none existed.)
//
// FOUND BY LOOKING RATHER THAN BY TUNING. A strict search of the whole
// ARCHITECTURE_v8.6.md returns ZERO hits for tonemap / Reinhard / filmic /
// ACES / exposure curve, and the shader ended in a bare `saturate(shaded)` --
// a HARD CLAMP of raw linear radiance to [0,1].
//
// That clamp is why the snow finding looked the way it did. §C measured an
// up-facing snow voxel at 1.149 at noon and the fix was to lower intensities
// until it fitted under 1.0. That works, but it treats the symptom: with a hard
// clamp, ANY surface that exceeds 1.0 loses all gradient at once and goes flat
// white, so the whole image is permanently one bad exposure away from a cliff.
// It also means bright and mid-bright surfaces compress differently from how
// any camera or eye responds, which is a large part of "it doesn't look
// amazing" that no amount of intensity tuning can reach.
//
// 0 = OFF, the previous behaviour exactly (hard clamp), kept so every earlier
//     screenshot and measurement remains reproducible.
// 1 = Reinhard, extended with a white point: c(1 + c/w^2)/(1 + c). Never
//     clips, gentle, desaturates highlights.
// 2 = ACES filmic (Narkowicz's fit). Punchier, holds saturation into the
//     highlights, the more "graded" look.
//
// Deliberately a TOGGLE AND AN AXIS rather than a silent replacement: the
// presets ship in both states so the owner compares rather than takes my word.
// ===========================================================================
// ===========================================================================
// STAGE F -- AN INDEPENDENT SHADOW-RAY CLAMP.
//
// §6.5 says the shadow ray "clamps at max distance (island diagonal)", and
// until now it simply inherited the PRIMARY ray's _MaxRayDistance (tier 2's
// outer bound, 290 m) -- recorded as a deliberate reading in
// PHASE_7_COMPLETION §5.4, and named there as an unbuilt lever.
//
// STAGE F's INSTRUMENTATION IS WHAT MADE THIS THE OBVIOUS LEVER. It measured
// only 34 of 1,043,918 hit pixels (0.003%) beyond the 128 m LOD1 boundary at
// the ground-level gameplay pose: essentially every shaded pixel is NEAR, yet
// every one of their shadow rays was permitted to travel 290 m. §6.5 itself
// predicts where that cost goes -- "grazing golden-hour rays travel farthest".
//
// <= 0 means "inherit the primary ray's clamp", i.e. the previous behaviour
// exactly, so every earlier measurement stays reproducible.
//
// THE VISUAL COST IS REAL AND IS THE POINT OF MEASURING IT: a shorter clamp
// means a distant mountain stops casting a shadow onto you, and shadows fade
// out at range rather than ending at the world edge. That is a quality trade,
// so it is a LightingConfig value (per-preset, live-tunable) rather than a
// hidden constant.
float _ShadowMaxDistVoxels;

// Rung 1's engagement threshold, in raw voxels. Was hardcoded to the LOD1
// boundary; made configurable purely so Stage F could test whether the
// threshold -- rather than the mechanism -- was why rung 1 never engaged.
float _Rung1DistVoxels;

// TASK 61 (engine step 8b): HALF-RES SUN SHADOWS at ALL distances, a play
// setting (PlaySettings.shadowRes, `-shadowres half`). 0 = off; > 0 = ON, and
// the value is the march's radians per pixel (the edge test's footprint).
// Rung 1's 2x2 quad reuse, but EDGE-AWARE: a pixel takes its quad lead's value
// only if its shadow origin (voxel + normal) is within 2 voxels + 2 pixel
// footprints of the lead's, or lies on the lead's plane (same normal, within
// one voxel along it -- a voxel stair step). Anything else -- a silhouette, a
// sky lead, a far surface behind a near one -- traces its own ray, so shadow
// values never cross a depth/normal edge. Rung 1 itself is unchanged.
float _ShadowHalfRes;

int   _Tonemap;
float _Exposure;
float _TonemapWhite;

float3 TonemapReinhard(float3 c, float w)
{
    float w2 = max(0.0001, w * w);
    return (c * (1.0 + c / w2)) / (1.0 + c);
}

float3 TonemapAces(float3 c)
{
    // Narkowicz 2015 fit. Cheap, and close enough to the real ACES curve for
    // a look pass; the full RRT/ODT is not worth its cost here.
    const float a = 2.51, b = 0.03, cc = 2.43, d = 0.59, e = 0.14;
    return saturate((c * (a * c + b)) / (c * (cc * c + d) + e));
}

float3 ApplyTonemap(float3 c)
{
    c *= max(0.0, _Exposure);
    if (_Tonemap == 1) return saturate(TonemapReinhard(c, _TonemapWhite));
    if (_Tonemap == 2) return TonemapAces(c);
    return saturate(c);          // 0 = the pre-Phase-7 hard clamp, unchanged
}

// §6.5's 8.4 guard and rung 1's neighbour reuse, in groupshared memory.
// 8x8 threads = 64 lanes; gsSunVis is 256 B, which is nothing against a 32 KB
// budget and is the entire cost of not needing wave intrinsics.
groupshared uint  gsAnyShadowNeeded;
groupshared float gsSunVis[64];
// Task 61's edge test: each lane's shadow origin, w = NormalCode or -1 (no ray).
groupshared int4  gsShadowOrg[64];

int NormalCode(int3 n) { return (n.x + 1) + 3 * (n.y + 1) + 9 * (n.z + 1); }

#define MAX_CHAIN_LEAPS 7

float4 StepHeatColor(int steps)
{
    if (steps <= 24)  return float4(0.0, 0.1, 0.6, 1.0);
    if (steps <= 48)  return float4(0.0, 0.6, 0.2, 1.0);
    if (steps <  96)  return float4(0.8, 0.6, 0.0, 1.0);
    return float4(0.9, 0.05, 0.05, 1.0);
}

float VoxelHash(int3 v)
{
    uint3 uv = (uint3)(v + int3(1 << 20, 1 << 20, 1 << 20));
    uint h = uv.x * 73856093u ^ uv.y * 19349663u ^ uv.z * 83492791u;
    h ^= h >> 13; h *= 1274126177u; h ^= h >> 16;
    return (float)(h & 0xFFFFFFu) / (float)0xFFFFFF;
}

// =====================================================================
// WITHIN-MATERIAL COLOUR VARIATION (§M.4 item 1).
//
// §M.4's assessment was that the remaining gap to the target aesthetic is not in
// the lighting model -- fog, tone curve, AO, hemisphere, sun, shadows and point
// lights all exist -- but in the fact that the landscape is large contiguous
// areas of ONE FLAT COLOUR per material, nine materials total.
//
// The existing `grain` term does not address that, for two reasons worth stating
// because they are the whole design of this function:
//
//   1. IT IS WHITE NOISE. Per-voxel uncorrelated noise averages to grey over any
//      distance or downsample -- so it vanishes exactly where the flatness is
//      most visible (mid and far ground), and at the shipped gate it is fighting
//      the upscale as well. Variation has to be LOW FREQUENCY to survive.
//   2. IT ONLY MOVES BRIGHTNESS. Real ground varies in hue, not just value. A
//      brightness-only jitter reads as noise on a flat colour, not as varied
//      ground.
//
// So this adds two octaves of smooth value noise (a hash lattice, trilinearly
// interpolated -- pure ALU, no texture and no memory traffic) and uses it to
// move the albedo along a warm/cool axis as well as in value.
//
// _MaterialVariation is the toggle and DEFAULTS OFF: it changes the look of
// every surface in the game, and that is the owner's call, not a default I get
// to set. _MaterialVariationAmount scales it.
// =====================================================================
float VoxelNoiseSmooth(int3 v, int shift)
{
    int3 c = v >> shift;
    float3 f = (float3)(v - (c << shift)) / (float)(1 << shift);
    f = f * f * (3.0 - 2.0 * f);                       // smoothstep fade

    float n000 = VoxelHash(c + int3(0, 0, 0));
    float n100 = VoxelHash(c + int3(1, 0, 0));
    float n010 = VoxelHash(c + int3(0, 1, 0));
    float n110 = VoxelHash(c + int3(1, 1, 0));
    float n001 = VoxelHash(c + int3(0, 0, 1));
    float n101 = VoxelHash(c + int3(1, 0, 1));
    float n011 = VoxelHash(c + int3(0, 1, 1));
    float n111 = VoxelHash(c + int3(1, 1, 1));

    float nx00 = lerp(n000, n100, f.x), nx10 = lerp(n010, n110, f.x);
    float nx01 = lerp(n001, n101, f.x), nx11 = lerp(n011, n111, f.x);
    return lerp(lerp(nx00, nx10, f.y), lerp(nx01, nx11, f.y), f.z);
}

float3 ApplyMaterialVariation(int3 voxel, float3 base)
{
    if (_MaterialVariation == 0) return base;

    // ~6.4 m patches carry the shape; ~1.6 m breaks up their edges.
    float lf = VoxelNoiseSmooth(voxel, 6) - 0.5;
    float mf = VoxelNoiseSmooth(voxel, 4) - 0.5;
    float v = lf * 0.72 + mf * 0.28;

    // Warm/cool rather than light/dark. The two tints are deliberately gentle
    // and near-complementary so the result reads as the same material under
    // varying ground, not as two different materials.
    float3 warm = float3(1.07, 1.01, 0.91);
    float3 cool = float3(0.93, 0.99, 1.07);
    float3 tint = lerp(cool, warm, saturate(v * 2.0 + 0.5));

    float amt = _MaterialVariationAmount;
    return base * lerp(float3(1.0, 1.0, 1.0), tint, amt) * (1.0 + v * amt * 0.55);
}

// NEW: developer material palette. 8 hand-picked, well-separated colors,
// cycled by material id (mat-1, since 0 is always air/no-hit and never
// reaches this function). Explicitly a DEBUG palette, not final art -
// picked for maximum distinguishability at low resolution, not for how the
// game should actually look. Swap freely once real material art exists;
// nothing else in the traversal depends on these specific values.
float3 DevMaterialColor(uint mat)
{
    static const float3 kDevPalette[8] = {
        float3(0.85, 0.35, 0.25), // 0: terracotta
        float3(0.35, 0.65, 0.85), // 1: sky blue
        float3(0.45, 0.75, 0.35), // 2: green
        float3(0.85, 0.65, 0.25), // 3: amber
        float3(0.65, 0.35, 0.75), // 4: purple
        float3(0.30, 0.80, 0.75), // 5: teal
        float3(0.80, 0.45, 0.65), // 6: pink
        float3(0.55, 0.55, 0.30), // 7: olive
    };
    uint idx = (mat - 1u) % 8u; // mat is always >=1 here (0/air never hits)
    return kDevPalette[idx];
}


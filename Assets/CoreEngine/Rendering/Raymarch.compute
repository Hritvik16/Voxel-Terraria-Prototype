// Assets/CoreEngine/Rendering/Raymarch.compute
//
// AMENDMENT 8.9 / §6.4 LOD CASCADE ADDITION:
// New buffers/params for cascade tiers 1-2, and a new coarse-tier traversal
// branch, ALL gated behind _UseLODCascade (default 0 from C#). When that flag
// is 0, "tier" is forced to 0 every iteration and the ENTIRE original tier-0
// code path below runs completely unchanged - same buffers, same branches,
// same math, byte-for-byte identical to the pre-LOD file. This is deliberate:
// every number in Amendment 8.9 was measured against the old code path, and
// none of that measurement is invalidated by this file until _UseLODCascade
// is explicitly turned on for a new benchmark run.
//
// Coarse-tier design: the ray's DDA state (voxel, tMax, tDelta, step) stays
// in RAW TIER-0 VOXEL UNITS for the whole ray, always. Tiers 1/2 don't get
// their own coordinate space - they just read coarser clipmap/brick buffers
// and treat one coarse brick's span as (8 << tierShift) raw voxels instead of
// 8. This means LeapSpanReseedClosedForm (unchanged, already CPU-fuzz-proven
// per Amendment 8.9 §6) is reused AS-IS for tier 1/2 empty-brick leaps - no
// new DDA math, just a bigger span passed to proven code.
//
// KNOWN LIMITATION, FIXED THIS PASS (was open, now resolved - see chat): the
// coarse-tier dense-brick path used to step ONE RAW VOXEL at a time even
// though a tier-2 coarse voxel is 4 raw voxels wide, costing up to 4
// iterations per coarse voxel crossed instead of 1. A real benchmark
// (Mode4-DenseSkip, cascade ON vs OFF, same pose) measured this costing
// ~83% - nearly 2x - before the fix, confirming the file's own earlier
// prediction. Fixed by leaping the full raw-voxel span of an air coarse
// voxel via the same already-proven LeapSpanReseedClosedForm the empty-
// brick case already used, just with a one-coarse-voxel-sized span instead
// of a whole-brick-sized one. See the tier>0 dense branch below for the
// exact change. NOT yet re-measured after this fix - that's the next
// verification step, not something to assume from the reasoning alone.
//
// STILL OPEN, NOT ADDRESSED THIS PASS: tiers 1/2 still have no air-mip
// pyramid equivalent - empty coarse BRICKS are still skipped one brick at a
// time (see the empty-brick leap below), with no multi-level hierarchy to
// leap across many bricks at once the way tier 0's pyramid does. If the fix
// above isn't enough on its own to close the gap with cascade-off, this is
// the next thing to build, not a smaller tweak to the fix above.
#pragma kernel CSMain

#include "../Coord/CoordMath.hlsl"
#include "../Memory/StructHeaders.hlsl"

RWTexture2D<float4> ResultTexture;
StructuredBuffer<uint> ClipmapBuffer;
StructuredBuffer<uint> BrickDataBuffer;

// --- LOD CASCADE: tier 1 (0.2m) and tier 2 (0.4m) clipmap + brick data ---
// Bound even when _UseLODCascade==0 (RaymarchFeature falls back to binding
// the tier-0 buffers as harmless dummies in that case, same pattern already
// used for AirMip2-4 when fewer levels are built) so the shader never reads
// an unset buffer.
StructuredBuffer<uint> ClipmapBufferTier1;
StructuredBuffer<uint> BrickDataBufferTier1;
StructuredBuffer<uint> ClipmapBufferTier2;
StructuredBuffer<uint> BrickDataBufferTier2;
uint4 _WindowDimsCoarseBricksTier1; // .xyz = coarse-brick dims, .w unused
uint4 _WindowDimsCoarseBricksTier2;

// .x = tier0 outer bound, .y = tier1 outer bound, .z = tier2 outer bound (the
// true ray-travel cap when cascade is active), .w unused. All in RAW VOXEL
// UNITS (meters * 10), matching currentDist's units. Set from
// LODConfig.TIER_OUTER_RANGE_M by RaymarchFeature - this shader has no
// knowledge of the meter values itself, only the voxel-unit conversion.
float4 _TierOuterRangeVoxels;
int _UseLODCascade;

// --- AIR-MIP: legacy four-buffer form (modes 0-4) ---
StructuredBuffer<uint> AirMip1;
StructuredBuffer<uint> AirMip2;
StructuredBuffer<uint> AirMip3;
StructuredBuffer<uint> AirMip4;
uint4 _AirMipDims0;
uint4 _AirMipDims1;
uint4 _AirMipDims2;
uint4 _AirMipDims3;
uint  _AirMipLevelCount;

// --- AIR-MIP: packed + merged form (optimization pass) ---
// One buffer, all levels, 1 bit per cell. _MipInfo[k-1] = (dimX, dimY, dimZ,
// wordOffset) for level k. Removes the 4-way dynamic branch over four separate
// buffers AND shrinks the pyramid from ~38 MB to ~1.2 MB so it fits in cache.
StructuredBuffer<uint> AirMipPacked;
float4 _MipInfo[4];
int _UsePackedMips;

float4x4 _CameraInverseProjection;
float4x4 _CameraInverseView;
float3 _CameraPos;
uint4 _WindowDimsBricksPacked;

// --- PHASE 4: sliding window ---
// The clipmap is now CHUNK-MAJOR: flat = chunkSlot*4096 + localBrickIndex.
// See TerrainClipmap.cs's header for the derivation (brick-linear made a
// boundary-crossing slab ~16,000 scattered upload ranges; chunk-major makes it
// 64 contiguous ones).
uint4 _WindowDimsChunksPacked;   // .xyz = window size in CHUNKS

// Minimum corner of the resident window, in BRICKS. Was implicitly (0,0,0)
// while the window was static; the Phase 3 XZ bounds guard said so in its own
// PHASE 4 NOTE. Now supplied by RaymarchFeature every frame.
int4 _WindowOriginBricksPacked;

// Highest world voxel Y that generation can produce content for, +1. Replaces
// the hardcoded 128 in the early-exit below.
//
// DELIBERATELY NOT the window's Y extent. The window reaches 256 voxels at
// WINDOW_CHUNKS_Y=2 but nothing generates above 128, and §6.1 showed grazing
// and sky rays are exactly where the iteration budget goes -- terminating them
// at the CONTENT ceiling rather than the WINDOW ceiling halves their travel.
// Folding this into the window bounds test would be a silent perf regression.
int _ContentCeilingVoxelY;

// Cascade tier geometry: .x = coarse bricks per chunk edge, .y = log2 of that,
// .z = coarse-brick entries per chunk. Tier 1 = (8,3,512), tier 2 = (4,2,64).
uint4 _CascadeTierInfo1;
uint4 _CascadeTierInfo2;

RWStructuredBuffer<float> DebugOut;
uint2 _DebugPixel;

// 0=Beauty 1=StepHeat 2=UniformDense 3=Normals 4=NonExitHeat 5=VoxelGrain 6=LODTier
int4 _DebugModePacked;

int _MaxOuterIterations;

// Max ray travel in VOXELS (128 m = 1280 voxels). Lowering this is the LOD0
// radius trim: the 128 m figure was derived for a 1080p pixel-footprint match,
// so at 960x540 the matched distance is roughly half that. NOTE: with LOD1
// unimplemented (Phase 4), trimming this makes distant terrain vanish rather
// than drop to a coarser level - it measures the cost saving honestly but is
// not a shippable configuration on its own.
// (LOD cascade is now implemented behind _UseLODCascade - when that's on,
// RaymarchFeature overrides the effective max distance to
// _TierOuterRangeVoxels.z instead of using this constant. This field/comment
// is otherwise unchanged so the pre-cascade A/B measurements stay meaningful.)
float _MaxRayDistance;

int _TraversalMode;

// NEW: developer material color palette + per-voxel grain toggle for the
// default Beauty output (DebugMode 0 only - diagnostic views are untouched).
// Defaults ON. Set to 0 to reproduce the original flat-gray Beauty shading
// exactly, byte-for-byte, for any comparison against pre-existing screenshots.
int _UseDevColors;

// ---- PRESENTATION FLAGS (shading step only) ----
// Every one of these gates a purely cosmetic term applied AFTER traversal has
// already resolved which voxel and which face a ray hit. None of them is read
// by any stepping, addressing or LOD-selection code. Set them to 0 and the
// output collapses to the pre-existing look, which is why they are flags and
// not edits: Phase 7's real lighting (§6.5) can switch any of them off without
// unpicking anything.
int   _ShadeAO;        // per-face ambient occlusion from neighbour occupancy
int   _ShadeHemi;      // sky/ground hemisphere tint
int   _ShadeFog;       // distance fog toward the sky colour
float4 _SkyColor;      // also the fog target and the "up" hemisphere tint
float  _FogStartM;
float  _FogEndM;

// ===========================================================================
// PHASE 7 -- LIGHTING (§6.5, §3.8, C.9 / C.10 / C.11)
//
// Everything below is read ONLY after traversal has resolved a hit, except
// _ShadowQualityLevel and _SunDir, which gate whether the fused shadow ray runs
// at all. No stepping, addressing or LOD-selection code for the PRIMARY ray
// reads any of it -- so with _ShadowQualityLevel == 3 (rung "off") and the
// lighting terms neutral, the tier-0 path is the pre-Phase-7 path. That claim
// is not left as an argument from code structure: RaymarchLightingTests and the
// Phase 7 rig both check an EXACT traversal-counter match at a pose where the
// shadow branch cannot engage, the way Amendment 8.10 §2 proved the cascade's
// tier-0 path unchanged (denseMicroSteps 116 == 116).
// ===========================================================================

// A.6 point lights (§3.8). Always MAX_ACTIVE_LIGHTS entries; _ActiveLightCount
// says how many are live this frame. Selection (nearest-to-player, furthest
// dropping first) happens on the CPU in LightSourceBuffer.SelectActive -- the
// shader never decides which lights to drop, it just reads the first N.
StructuredBuffer<LightSource> LightBuffer;
uint _ActiveLightCount;

// The two animated uniforms §6.5 calls for: "sun direction + color are two
// animated uniforms from the in-game clock."
// _SunDir points FROM a surface TOWARD the sun -- the direction a shadow ray
// travels, and the L in C.9's max(0, N.L).
// _SunColor is EXACTLY zero below the horizon, not merely small, so this and
// the "is the sun up" branch can never disagree about whether it is night.
float3 _SunDir;
float3 _SunColor;

// C.9's ambientSky, already scaled by intensity and by time of day.
float3 _AmbientColor;

// C.10's penumbra constant. 0 => hard shadows (a BRANCH, not a limit --
// smoothstep with a zero-width edge is undefined).
float _KSoft;

// §6.5's fallback ladder, from EngineConfig.SHADOW_QUALITY_LEVEL:
//   0 full penumbra | 1 half-res beyond LOD1 | 2 hard only | 3 off
// All four are compiled in so ONE binary can be measured at every rung in one
// session -- FPS_INVESTIGATION_RESULTS.md §3.2 records a CROSS-session
// comparison producing a wrong number because the untouched arm drifted.
int _ShadowQualityLevel;

// Runaway guard for the shadow DDA. Counts OUTER iterations, like
// _MaxOuterIterations, not voxels -- each can leap a whole air brick or
// air-mip cell.
int _MaxShadowSteps;

// C.9 applies max(0, N.L) to the SUN term only; the pointLights term is bare.
// Implemented literally by default (0). See the FLAG in PHASE_7_COMPLETION.md:
// the literal reading lights faces pointing away from a torch, which reads as
// flat. 1 applies N.L to point lights too. Shipped at the literal reading so
// the owner judges the deviation rather than inheriting it.
int _PointLightNdotL;

// FLAG (§6.5's three simultaneous ambient requirements). 1 = modulate ambient
// by a straight-up sky-visibility probe so deep caves are genuinely dark; 0 =
// plain hemisphere term, which lights a cave ceiling as brightly as open sky.
// Measured as its own arm; see AMENDMENT_8_12_PHASE7_GATE.md.
int _UseSkyProbeAmbient;

// Fraction of ambient surviving with zero sky visibility -- §6.5's
// "underground reads near-zero ambient". Art constant, live-tunable via
// LightingConfig.json.
float _UndergroundAmbientFloor;

#define MAX_CHAIN_LEAPS 7

float4 StepHeatColor(int steps)
{
    if (steps <= 24)  return float4(0.0, 0.1, 0.6, 1.0);
    if (steps <= 48)  return float4(0.0, 0.6, 0.2, 1.0);
    if (steps <  96)  return float4(0.8, 0.6, 0.0, 1.0);
    return float4(0.9, 0.05, 0.05, 1.0);
}

float VoxelHash(int3 v)
{
    uint3 uv = (uint3)(v + int3(1 << 20, 1 << 20, 1 << 20));
    uint h = uv.x * 73856093u ^ uv.y * 19349663u ^ uv.z * 83492791u;
    h ^= h >> 13; h *= 1274126177u; h ^= h >> 16;
    return (float)(h & 0xFFFFFFu) / (float)0xFFFFFF;
}

// NEW: developer material palette. 8 hand-picked, well-separated colors,
// cycled by material id (mat-1, since 0 is always air/no-hit and never
// reaches this function). Explicitly a DEBUG palette, not final art -
// picked for maximum distinguishability at low resolution, not for how the
// game should actually look. Swap freely once real material art exists;
// nothing else in the traversal depends on these specific values.
float3 DevMaterialColor(uint mat)
{
    static const float3 kDevPalette[8] = {
        float3(0.85, 0.35, 0.25), // 0: terracotta
        float3(0.35, 0.65, 0.85), // 1: sky blue
        float3(0.45, 0.75, 0.35), // 2: green
        float3(0.85, 0.65, 0.25), // 3: amber
        float3(0.65, 0.35, 0.75), // 4: purple
        float3(0.30, 0.80, 0.75), // 5: teal
        float3(0.80, 0.45, 0.65), // 6: pink
        float3(0.55, 0.55, 0.30), // 7: olive
    };
    uint idx = (mat - 1u) % 8u; // mat is always >=1 here (0/air never hits)
    return kDevPalette[idx];
}

// ===========================================================================
// AUTHORED PALETTE + CHEAP FAKE SHADING. Presentation only.
//
// MIRRORS MaterialPalette in Assets/ContentModules/MaterialRules.cs, which is
// the authoritative table. PaletteSyncTests parses this function and fails if
// the two drift. If you change a colour, change it in BOTH places.
//
// Nothing below participates in traversal. These functions are called once, at
// the end of CSMain, on a voxel the DDA has already decided was hit.
// ===========================================================================
float3 MaterialAlbedo(uint mat)
{
    if (mat == 2u)  return float3(0.440, 0.425, 0.400);  // Stone
    if (mat == 3u)  return float3(0.365, 0.470, 0.255);  // Grass
    if (mat == 4u)  return float3(0.735, 0.660, 0.495);  // Sand
    if (mat == 5u)  return float3(0.355, 0.410, 0.330);  // MossyStone
    if (mat == 6u)  return float3(0.150, 0.330, 0.420);  // Water
    if (mat == 7u)  return float3(0.715, 0.735, 0.760);  // Snow
    if (mat == 8u)  return float3(0.520, 0.415, 0.295);  // Sandstone (earth role)
    if (mat == 9u)  return float3(0.275, 0.410, 0.235);  // JungleGrass
    if (mat == 10u) return float3(0.255, 0.260, 0.285);  // Deepstone
    if (mat == 11u) return float3(0.720, 0.215, 0.070);  // Lava
    if (mat == 12u) return float3(0.680, 0.480, 0.130);  // Honey
    if (mat == 13u) return float3(0.095, 0.085, 0.125);  // Obsidian
    if (mat == 14u) return float3(0.760, 0.545, 0.285);  // Torch (Phase 7)
    return float3(0.90, 0.10, 0.80);                     // unauthored -> obvious magenta
}

// Self-lit materials skip the darkening terms so they stay hot. This is a
// SHADING CHEAT, not a light source: nothing here illuminates anything else.
// Real emission is Phase 7 (§6.5).
bool MaterialIsSelfLit(uint mat) { return mat == 11u; }

// ===========================================================================
// A.7's `emissive`, MIRRORED -- and why it is mirrored rather than uploaded.
//
// Stage 0 established that there is NO GraphicsBuffer<MaterialData> anywhere in
// this project: A.7's struct is declared in StructHeaders.cs/.hlsl and read by
// nothing, and FluidGpuSimulation uploads four separate flat uint arrays
// instead, deliberately, "restricted to what the CA reads". So Phase 7 had a
// choice: build the real §3.9 registry buffer and thread it through
// RaymarchFeature's render-graph pass, or mirror the two numbers it needs the
// way the palette beside it is already mirrored.
//
// It mirrors, for MaterialPalette's own stated reason: wiring a new registry
// buffer through render setup for a colour change is a §3.9 sync-contract
// addition, and Phase 7 already has one new untrusted thing (§0.1 invariant 5).
// The real A.7 buffer is CARRIED FORWARD, not silently skipped --
// PHASE_7_COMPLETION.md's CARRY-FORWARD section names it.
//
// PaletteSyncTests parses BOTH of these functions and fails if they drift from
// MaterialRules' tables, exactly as it already does for MaterialAlbedo.
// ===========================================================================
float MaterialEmissive(uint mat)
{
    if (mat == 14u) return 1.00;   // Torch
    if (mat == 11u) return 0.55;   // Lava
    return 0.0;
}

float3 MaterialEmissiveTint(uint mat)
{
    if (mat == 14u) return float3(1.00, 0.72, 0.38);   // Torch -- warm candle flame
    if (mat == 11u) return float3(1.00, 0.42, 0.14);   // Lava  -- hotter, redder
    return float3(0.0, 0.0, 0.0);
}



// CHUNK-MAJOR (Phase 4). Ring-masking the CHUNK coord rather than the brick
// coord is what makes a chunk's 4096 entries contiguous. Masking stays
// origin-independent: under a power-of-two mask, subtracting the origin only
// rotates the ring, so the origin is needed for the BOUNDS TEST (in CSMain,
// once per iteration) and not here.
uint ReadClipmap(int3 brickCoord, uint3 windowDimsBricks)
{
    int3 chunkCoord   = brickCoord >> 4;
    int3 wrappedChunk = chunkCoord & (int3)(_WindowDimsChunksPacked.xyz - 1);
    int  chunkSlot    = wrappedChunk.x
                      + (wrappedChunk.y * (int)_WindowDimsChunksPacked.x)
                      + (wrappedChunk.z * (int)_WindowDimsChunksPacked.x * (int)_WindowDimsChunksPacked.y);

    int3 localBrick = brickCoord & 15;
    int  local      = LocalBrickIndex(localBrick);   // C.1, CoordMath.hlsl

    return ClipmapBuffer[(chunkSlot * 4096) + local];
}

// ---- AO helpers live HERE, below ReadClipmap, because they call it.
// HLSL requires declaration before use; placing them up beside the palette
// produced 'undeclared identifier ReadClipmap' on Metal only, which the
// Editor-side shader check does not catch -- the build-log gate did.
/// Solid test for ambient occlusion. READ-ONLY, and deliberately a separate
/// function from anything the DDA uses -- it reuses ReadClipmap and
/// BrickDataBuffer exactly as the traversal reads them, but no traversal code
/// path calls this and it mutates nothing.
bool AoSolidAt(int3 voxel, uint3 windowDimsBricks)
{
    int3 rel = VoxelToBrick(voxel) - _WindowOriginBricksPacked.xyz;
    if (rel.x < 0 || rel.y < 0 || rel.z < 0 ||
        rel.x >= (int)windowDimsBricks.x ||
        rel.y >= (int)windowDimsBricks.y ||
        rel.z >= (int)windowDimsBricks.z) return false;

    uint handle = ReadClipmap(VoxelToBrick(voxel), windowDimsBricks);
    if ((handle & 0x80000000u) == 0u) return (handle & 0xFFu) != 0u;   // uniform brick
    uint poolIdx = handle & 0x3FFFFFFFu;
    uint vIdx = (uint)LocalVoxelIndex(LocalVoxelIndex3D(voxel));
    uint packed = BrickDataBuffer[(poolIdx * 128) + (vIdx >> 2)];
    return (((packed >> ((vIdx & 3u) * 8u)) & 0xFFu) != 0u);
}

/// Classic voxel corner-darkening. For each of the four corners of the hit
/// face, occlusion is a function of the two edge neighbours and the diagonal;
/// the four values are then bilinearly interpolated across the face using the
/// ray's actual hit position. This is the trick that makes voxel terrain read
/// as having depth without any light in the scene at all.
float FaceAO(int3 voxel, int3 normal, float3 hitVoxelPos, uint3 windowDimsBricks)
{
    // Face-plane tangents. Any consistent pair works; the bilinear weights
    // below are computed in the same basis, so the choice cannot skew the result.
    int3 n = normal;
    int3 u = (abs(n.x) == 1) ? int3(0, 1, 0) : int3(1, 0, 0);
    int3 v = (abs(n.z) == 1) ? int3(0, 1, 0) : int3(0, 0, 1);
    if (abs(n.y) == 1) { u = int3(1, 0, 0); v = int3(0, 0, 1); }

    int3 base = voxel + n;                    // the empty cell in front of the face
    float ao[4];
    [unroll]
    for (int c = 0; c < 4; c++)
    {
        int su = (c & 1) ? 1 : -1;
        int sv = (c & 2) ? 1 : -1;
        bool s1 = AoSolidAt(base + u * su, windowDimsBricks);
        bool s2 = AoSolidAt(base + v * sv, windowDimsBricks);
        bool cd = AoSolidAt(base + u * su + v * sv, windowDimsBricks);
        // Both edges occluded => fully dark corner, the diagonal cannot help.
        float occ = (s1 && s2) ? 3.0 : (float)((s1 ? 1 : 0) + (s2 ? 1 : 0) + (cd ? 1 : 0));
        ao[c] = 1.0 - occ * 0.25;             // 3 occluders -> 0.25, none -> 1.0
    }

    // Where in the face did the ray land? Project the hit position onto the
    // tangents and remap [-0.5,0.5] to [0,1].
    float fu = saturate(dot(hitVoxelPos, float3(u)) + 0.5);
    float fv = saturate(dot(hitVoxelPos, float3(v)) + 0.5);
    float a = lerp(ao[0], ao[1], fu);
    float b = lerp(ao[2], ao[3], fu);
    return lerp(a, b, fv);
}

// Generalized clipmap read for cascade tiers 1/2. tierCoarseBrickCoord is in
// THAT TIER's own coarse-brick coordinate space (i.e. already divided down
// to "brick index," not raw voxels) - same convention ReadClipmap uses for
// tier 0. Branches on tier to pick the buffer/dims; tier is derived from
// currentDist so it's coherent across most of a thread group's rays (same
// coherent-branch argument already used for the dense/uniform branch above).
// CHUNK-MAJOR, matching CascadeTierPool. A chunk contributes
// entriesPerChunk contiguous coarse-brick entries (512 at tier 1, 64 at
// tier 2), indexed chunkSlot*entriesPerChunk + local, local x-fastest.
uint ReadClipmapTier(int tier, int3 tierCoarseBrickCoord)
{
    uint4 info = (tier == 1) ? _CascadeTierInfo1 : _CascadeTierInfo2;
    int edge           = (int)info.x;   // coarse bricks per chunk edge
    int edgeShift      = (int)info.y;   // log2(edge)
    int entriesPerChunk= (int)info.z;

    int3 chunkCoord   = tierCoarseBrickCoord >> edgeShift;
    int3 wrappedChunk = chunkCoord & (int3)(_WindowDimsChunksPacked.xyz - 1);
    int  chunkSlot    = wrappedChunk.x
                      + (wrappedChunk.y * (int)_WindowDimsChunksPacked.x)
                      + (wrappedChunk.z * (int)_WindowDimsChunksPacked.x * (int)_WindowDimsChunksPacked.y);

    int3 localCoarse = tierCoarseBrickCoord & (edge - 1);
    int  local       = localCoarse.x + edge * (localCoarse.y + edge * localCoarse.z);

    int flatIndex = (chunkSlot * entriesPerChunk) + local;
    return (tier == 1) ? ClipmapBufferTier1[flatIndex] : ClipmapBufferTier2[flatIndex];
}

uint ReadBrickDataTier(int tier, uint poolIdx, uint wordIdx)
{
    if (tier == 1) return BrickDataBufferTier1[(poolIdx * 128) + wordIdx];
    return BrickDataBufferTier2[(poolIdx * 128) + wordIdx];
}

// Tier shift: log2(downsample factor). Tier 1 -> factor 2 -> shift 1.
// Tier 2 -> factor 4 -> shift 2. Matches LODConfig.DownsampleFactor exactly;
// if LODConfig's tier voxel sizes ever change, this must change with it -
// there is deliberately no runtime derivation here (would cost a log2 per
// iteration for a value that's only ever 1 or 2), so this is the one place
// a LODConfig edit requires a matching shader edit.
int TierShift(int tier)
{
    return (tier == 1) ? 1 : 2;
}

// ===========================================================================
// §6.5's 8.2 LOD RULE, EXTRACTED SO IT IS DEFINED ONCE (§0.1 invariant 8).
//
// This was four inline lines in CSMain. It is now a function for one reason,
// and the reason is a latent bug rather than tidiness:
//
//   §6.5: "the shadow ray selects LOD by CAMERA DISTANCE TO THE CURRENT SAMPLE
//   POINT, NOT by the shadow ray's own traveled distance. The 8.1 rule
//   (coarsen by traveled distance) was wrong: a short shadow ray to a mountain
//   the camera renders coarse would evaluate it at fine LOD, so the cast shadow
//   wouldn't match the on-screen silhouette -- detached, floating shadows."
//
// The inline version compared `currentDist`. For a PRIMARY ray that is correct,
// but only by accident of where the ray starts: a primary ray begins at the
// camera, so its travelled distance IS its camera distance. A shadow ray begins
// at a surface. Reusing `currentDist` there is EXACTLY the retracted 8.1 rule,
// and it would have looked like working code.
//
// Naming the parameter `cameraDistanceVoxels` forces each call site to say
// which distance it is passing. ShadowRayReference.SelectLODTier is the CPU
// sibling of this function and is unit-tested against these same boundaries.
// ===========================================================================
int SelectLODTier(float cameraDistanceVoxels)
{
    if (_UseLODCascade == 0) return 0;
    if (cameraDistanceVoxels >= _TierOuterRangeVoxels.y) return 2;
    if (cameraDistanceVoxels >= _TierOuterRangeVoxels.x) return 1;
    return 0;
}

int AirMipFlatIndex(int3 cell, uint3 dims)
{
    int3 wrapped = cell & (int3)(dims - 1);
    return wrapped.x
         + wrapped.y * (int)dims.x
         + wrapped.z * (int)dims.x * (int)dims.y;
}

uint ReadAirMipLegacy(int level, int3 cell)
{
    if (level == 1) return AirMip1[AirMipFlatIndex(cell, _AirMipDims0.xyz)];
    if (level == 2) return AirMip2[AirMipFlatIndex(cell, _AirMipDims1.xyz)];
    if (level == 3) return AirMip3[AirMipFlatIndex(cell, _AirMipDims2.xyz)];
    return AirMip4[AirMipFlatIndex(cell, _AirMipDims3.xyz)];
}

// Packed + merged read. One indexed load from one buffer plus a shift/mask -
// no branch over which buffer to hit, and the whole pyramid is small enough
// to stay resident in cache.
uint ReadAirMipPacked(int level, int3 cell)
{
    float4 info = _MipInfo[level - 1];
    uint3 dims = uint3((uint)info.x, (uint)info.y, (uint)info.z);
    int3 wrapped = cell & (int3)(dims - 1);
    int flat = wrapped.x
             + wrapped.y * (int)dims.x
             + wrapped.z * (int)dims.x * (int)dims.y;
    uint wordIdx = (uint)info.w + ((uint)flat >> 5);
    return (AirMipPacked[wordIdx] >> ((uint)flat & 31u)) & 1u;
}

// Dispatches on a UNIFORM, so the branch is scalar and coherent across every
// thread in the dispatch - cheap on Apple GPUs. Note this means the A/B very
// slightly understates the packed path's true benefit, since a dedicated
// packed-only kernel would not carry the dead legacy code at all.
uint ReadAirMip(int level, int3 cell)
{
    if (_UsePackedMips != 0) return ReadAirMipPacked(level, cell);
    return ReadAirMipLegacy(level, cell);
}

// ---------------------------------------------------------------------------
//  mode 0 leap (unchanged)
// ---------------------------------------------------------------------------
void LeapSpan(inout int3 voxel, inout float3 tMax, inout float currentDist,
              float3 tDelta, int3 step, int3 spanMin, int spanVoxels, inout int3 normal,
              inout int exitIters, inout int nonExitIters)
{
    int3 exitCount = int3(
        step.x > 0 ? (spanMin.x + spanVoxels - voxel.x) : (voxel.x - (spanMin.x - 1)),
        step.y > 0 ? (spanMin.y + spanVoxels - voxel.y) : (voxel.y - (spanMin.y - 1)),
        step.z > 0 ? (spanMin.z + spanVoxels - voxel.z) : (voxel.z - (spanMin.z - 1)));

    precise float tExitX = tMax.x + (exitCount.x - 1) * tDelta.x;
    precise float tExitY = tMax.y + (exitCount.y - 1) * tDelta.y;
    precise float tExitZ = tMax.z + (exitCount.z - 1) * tDelta.z;

    int axis;
    if (tExitX <= tExitY) axis = (tExitX <= tExitZ) ? 0 : 2;
    else                  axis = (tExitY <= tExitZ) ? 1 : 2;

    float tHit = (axis == 0) ? tExitX : ((axis == 1) ? tExitY : tExitZ);

    const float eps = 1e-4;

    int guardX = min(exitCount.x, spanVoxels + 1);
    int guardY = min(exitCount.y, spanVoxels + 1);
    int guardZ = min(exitCount.z, spanVoxels + 1);

    if (axis == 0) { for (int kx = 0; kx < exitCount.x; kx++) { voxel.x += step.x; tMax.x += tDelta.x; exitIters++; } }
    if (axis == 1) { for (int ky = 0; ky < exitCount.y; ky++) { voxel.y += step.y; tMax.y += tDelta.y; exitIters++; } }
    if (axis == 2) { for (int kz = 0; kz < exitCount.z; kz++) { voxel.z += step.z; tMax.z += tDelta.z; exitIters++; } }

    if (axis != 0) { int g = 0; [loop] while (tMax.x <= tHit + eps && g < guardX) { voxel.x += step.x; tMax.x += tDelta.x; g++; nonExitIters++; } }
    if (axis != 1) { int g = 0; [loop] while (tMax.y <= tHit + eps && g < guardY) { voxel.y += step.y; tMax.y += tDelta.y; g++; nonExitIters++; } }
    if (axis != 2) { int g = 0; [loop] while (tMax.z <= tHit + eps && g < guardZ) { voxel.z += step.z; tMax.z += tDelta.z; g++; nonExitIters++; } }

    currentDist = tHit;
    normal = (axis == 0) ? int3(-step.x, 0, 0)
           : ((axis == 1) ? int3(0, -step.y, 0)
                          : int3(0, 0, -step.z));
}

float ReseedTMaxAxis(int voxelAxis, float rayStartAxis, float tDeltaAxis, int stepAxis)
{
    return (stepAxis > 0 ? (voxelAxis + 1.0 - rayStartAxis) : (rayStartAxis - voxelAxis)) * tDeltaAxis;
}

void LeapSpanReseed(inout int3 voxel, inout float3 tMax, inout float currentDist,
                     float3 tDelta, int3 step, float3 rayStart, int3 spanMin, int spanVoxels,
                     inout int3 normal, inout int exitLeaps, inout int nonExitIters)
{
    int3 exitCount = int3(
        step.x > 0 ? (spanMin.x + spanVoxels - voxel.x) : (voxel.x - (spanMin.x - 1)),
        step.y > 0 ? (spanMin.y + spanVoxels - voxel.y) : (voxel.y - (spanMin.y - 1)),
        step.z > 0 ? (spanMin.z + spanVoxels - voxel.z) : (voxel.z - (spanMin.z - 1)));

    precise float tExitX = tMax.x + (exitCount.x - 1) * tDelta.x;
    precise float tExitY = tMax.y + (exitCount.y - 1) * tDelta.y;
    precise float tExitZ = tMax.z + (exitCount.z - 1) * tDelta.z;

    int axis;
    if (tExitX <= tExitY) axis = (tExitX <= tExitZ) ? 0 : 2;
    else                  axis = (tExitY <= tExitZ) ? 1 : 2;

    float tHit = (axis == 0) ? tExitX : ((axis == 1) ? tExitY : tExitZ);

    const float eps = 1e-4;
    int nonExitGuard = spanVoxels + 1;
    int guardX = min(exitCount.x, nonExitGuard);
    int guardY = min(exitCount.y, nonExitGuard);
    int guardZ = min(exitCount.z, nonExitGuard);

    if (axis == 0)
    {
        voxel.x += step.x * exitCount.x;
        tMax.x = ReseedTMaxAxis(voxel.x, rayStart.x, tDelta.x, step.x);
    }
    if (axis == 1)
    {
        voxel.y += step.y * exitCount.y;
        tMax.y = ReseedTMaxAxis(voxel.y, rayStart.y, tDelta.y, step.y);
    }
    if (axis == 2)
    {
        voxel.z += step.z * exitCount.z;
        tMax.z = ReseedTMaxAxis(voxel.z, rayStart.z, tDelta.z, step.z);
    }
    exitLeaps++;

    if (axis != 0) { int g = 0; [loop] while (tMax.x <= tHit + eps && g < guardX) { voxel.x += step.x; tMax.x += tDelta.x; g++; nonExitIters++; } }
    if (axis != 1) { int g = 0; [loop] while (tMax.y <= tHit + eps && g < guardY) { voxel.y += step.y; tMax.y += tDelta.y; g++; nonExitIters++; } }
    if (axis != 2) { int g = 0; [loop] while (tMax.z <= tHit + eps && g < guardZ) { voxel.z += step.z; tMax.z += tDelta.z; g++; nonExitIters++; } }

    currentDist = tHit;
    normal = (axis == 0) ? int3(-step.x, 0, 0)
           : ((axis == 1) ? int3(0, -step.y, 0)
                          : int3(0, 0, -step.z));
}

void LeapSpanReseedClosedForm(inout int3 voxel, inout float3 tMax, inout float currentDist,
                     float3 tDelta, int3 step, float3 rayStart, int3 spanMin, int spanVoxels,
                     inout int3 normal, inout int exitLeaps, inout int nonExitIters)
{
    int3 exitCount = int3(
        step.x > 0 ? (spanMin.x + spanVoxels - voxel.x) : (voxel.x - (spanMin.x - 1)),
        step.y > 0 ? (spanMin.y + spanVoxels - voxel.y) : (voxel.y - (spanMin.y - 1)),
        step.z > 0 ? (spanMin.z + spanVoxels - voxel.z) : (voxel.z - (spanMin.z - 1)));

    precise float tExitX = tMax.x + (exitCount.x - 1) * tDelta.x;
    precise float tExitY = tMax.y + (exitCount.y - 1) * tDelta.y;
    precise float tExitZ = tMax.z + (exitCount.z - 1) * tDelta.z;

    int axis;
    if (tExitX <= tExitY) axis = (tExitX <= tExitZ) ? 0 : 2;
    else                  axis = (tExitY <= tExitZ) ? 1 : 2;

    float tHit = (axis == 0) ? tExitX : ((axis == 1) ? tExitY : tExitZ);

    const float eps = 1e-4;
    int nonExitGuard = spanVoxels + 1;
    int guardX = min(exitCount.x, nonExitGuard);
    int guardY = min(exitCount.y, nonExitGuard);
    int guardZ = min(exitCount.z, nonExitGuard);

    if (axis == 0) voxel.x += step.x * exitCount.x;
    if (axis == 1) voxel.y += step.y * exitCount.y;
    if (axis == 2) voxel.z += step.z * exitCount.z;
    exitLeaps++;

    if (axis != 0)
    {
        float absDirX = 1.0 / tDelta.x;
        int nx = (int)floor((tHit + eps - tMax.x) * absDirX) + 1;
        nx = clamp(nx, 0, guardX);
        voxel.x += step.x * nx;
        nonExitIters += nx;
    }
    if (axis != 1)
    {
        float absDirY = 1.0 / tDelta.y;
        int ny = (int)floor((tHit + eps - tMax.y) * absDirY) + 1;
        ny = clamp(ny, 0, guardY);
        voxel.y += step.y * ny;
        nonExitIters += ny;
    }
    if (axis != 2)
    {
        float absDirZ = 1.0 / tDelta.z;
        int nz = (int)floor((tHit + eps - tMax.z) * absDirZ) + 1;
        nz = clamp(nz, 0, guardZ);
        voxel.z += step.z * nz;
        nonExitIters += nz;
    }

    tMax.x = ReseedTMaxAxis(voxel.x, rayStart.x, tDelta.x, step.x);
    tMax.y = ReseedTMaxAxis(voxel.y, rayStart.y, tDelta.y, step.y);
    tMax.z = ReseedTMaxAxis(voxel.z, rayStart.z, tDelta.z, step.z);

    currentDist = tHit;
    normal = (axis == 0) ? int3(-step.x, 0, 0)
           : ((axis == 1) ? int3(0, -step.y, 0)
                          : int3(0, 0, -step.z));
}

// ===========================================================================
// THE FUSED SUN-SHADOW RAY (§6.5, C.10)
//
// §6.5: "in the SAME raymarch kernel, immediately after a pixel's primary ray
// resolves a hit, the thread fires ONE secondary DDA ray from the hit voxel
// toward the sun THROUGH THE SAME CLIPMAP/LOD DATA."
//
// "the same data" is the load-bearing phrase and it is why this function reads
// ReadClipmap / ReadClipmapTier / ReadAirMip and nothing else. There is no
// shadow-specific buffer, no shadow map, no cascade to re-render and nothing to
// invalidate -- which is also why "bomb a cave roof at noon and sunlight
// reaches the floor the SAME frame" and "pour water off a ledge and get a
// moving shadow" are consequences of §3.10's authoritative-byte rule rather
// than features anyone implements.
//
// STRUCTURALLY THIS IS THE PRIMARY LOOP WITH FOUR DIFFERENCES, and §13's own
// "if stuck" note says so: "the shadow ray is the Phase-2 DDA with a new origin
// + early-out." The four:
//   1. the origin is one cell off the hit face, not the camera (§6.5)
//   2. the tier comes from CAMERA distance to the sample, not from travel (8.2)
//   3. the first hit ends the ray -- occlusion only, material never recorded
//   4. it tracks C.10's minimum clearance ratio on the way
// Everything else -- the leap primitives, the bounds guard, the content-ceiling
// early exit -- is the same already-proven code, called with different numbers.
// ===========================================================================

struct ShadowHit
{
    float sunVis;   // C.9's sunVis: 0 fully occluded .. 1 fully lit
    int   steps;    // outer iterations, for the §10.3 heat view and §10.4 dump
};

/// Solid test at a tier, for C.10's near-miss scan.
///
/// Out of the window means NO DATA, and no data must read as air -- returning
/// "solid" there would paint a penumbra against the window edge that moves with
/// the player. Same rule the traversal itself uses: leaving the window
/// terminates a ray, it never aliases back in (PHASE_3_COMPLETION.md §6.2).
bool ShadowSolidAt(int3 v, int tier, uint3 windowDimsBricks)
{
    int3 rel = VoxelToBrick(v) - _WindowOriginBricksPacked.xyz;
    if (rel.x < 0 || rel.y < 0 || rel.z < 0 ||
        rel.x >= (int)windowDimsBricks.x ||
        rel.y >= (int)windowDimsBricks.y ||
        rel.z >= (int)windowDimsBricks.z) return false;

    if (tier == 0)
    {
        uint handle = ReadClipmap(VoxelToBrick(v), windowDimsBricks);
        if ((handle & 0x80000000u) == 0u) return (handle & 0xFFu) != 0u;
        uint poolIdx = handle & 0x3FFFFFFFu;
        uint vIdx = (uint)LocalVoxelIndex(LocalVoxelIndex3D(v));
        uint packed = BrickDataBuffer[(poolIdx * 128) + (vIdx >> 2)];
        return (((packed >> ((vIdx & 3u) * 8u)) & 0xFFu) != 0u);
    }

    int tierShift = TierShift(tier);
    int3 tv = v >> tierShift;
    uint h = ReadClipmapTier(tier, tv >> 3);
    if ((h & 0x80000000u) == 0u) return (h & 0xFFu) != 0u;
    uint pi = h & 0x3FFFFFFFu;
    uint vi = (uint)LocalVoxelIndex(tv & 7);
    uint pk = ReadBrickDataTier(tier, pi, vi >> 2);
    return (((pk >> ((vi & 3u) * 8u)) & 0xFFu) != 0u);
}

/// C.10's `clearance`, in voxel units: the perpendicular distance from the
/// ray's current position to the nearest solid face neighbour that lies AHEAD
/// of the ray. 3.0e30 when nothing ahead is solid.
///
/// THE `dir` TEST IS NOT AN OPTIMISATION -- IT IS WHY LIT PIXELS ARE LIT.
/// A shadow ray starts one cell off the surface it is shading, so that surface
/// is ALWAYS a face neighbour of the origin cell and is always solid. Scanned
/// as a near-miss it gives clearance ~0 at t ~ 0, C.10's m collapses to 0, and
/// every sunlit surface in the world reports full shadow. Skipping neighbours
/// strictly behind the advancing ray removes it BY CONSTRUCTION: the receiver
/// sits at -hitNormal, and any pixel the sun lights has dot(dir, hitNormal) > 0
/// (that is C.9's max(0, N.L) being positive), so dot(dir, -hitNormal) < 0
/// always. No epsilon, nothing to tune. Full derivation and the failing test
/// that found it are in ShadowRayReference.NearestSolidFaceClearance.
float ShadowClearance(int3 voxel, float3 posVox, float3 dir, int tier, uint3 windowDimsBricks)
{
    float best = 3.0e30;
    if (dir.x >= 0.0 && ShadowSolidAt(voxel + int3(1, 0, 0), tier, windowDimsBricks))
        best = min(best, max(0.0, (voxel.x + 1.0) - posVox.x));
    if (dir.x <= 0.0 && ShadowSolidAt(voxel - int3(1, 0, 0), tier, windowDimsBricks))
        best = min(best, max(0.0, posVox.x - voxel.x));
    if (dir.y >= 0.0 && ShadowSolidAt(voxel + int3(0, 1, 0), tier, windowDimsBricks))
        best = min(best, max(0.0, (voxel.y + 1.0) - posVox.y));
    if (dir.y <= 0.0 && ShadowSolidAt(voxel - int3(0, 1, 0), tier, windowDimsBricks))
        best = min(best, max(0.0, posVox.y - voxel.y));
    if (dir.z >= 0.0 && ShadowSolidAt(voxel + int3(0, 0, 1), tier, windowDimsBricks))
        best = min(best, max(0.0, (voxel.z + 1.0) - posVox.z));
    if (dir.z <= 0.0 && ShadowSolidAt(voxel - int3(0, 0, 1), tier, windowDimsBricks))
        best = min(best, max(0.0, posVox.z - voxel.z));
    return best;
}

// §10.4's ring buffer for the shadow path. DebugOut is 128 floats; slots 0-19
// are the pre-Phase-7 raymarcher dump and are NOT touched. 20-33 are the shadow
// ray's scalars, 34-43 are the last 10 clipmap indices it traversed.
#define SHADOW_DUMP_BASE 34
#define SHADOW_DUMP_RING 10

/// The flat clipmap index a shadow ray is about to read, recorded verbatim so a
/// dump can be checked against the CPU store by index rather than by
/// re-deriving addressing from a coordinate (re-deriving it is how an
/// addressing bug hides from its own diagnostic).
int ShadowClipmapFlatIndex(int3 voxel, uint3 windowDimsBricks)
{
    int3 brickCoord = VoxelToBrick(voxel);
    int3 chunkCoord = brickCoord >> 4;
    int3 wrappedChunk = chunkCoord & (int3)(_WindowDimsChunksPacked.xyz - 1);
    int chunkSlot = wrappedChunk.x
                  + (wrappedChunk.y * (int)_WindowDimsChunksPacked.x)
                  + (wrappedChunk.z * (int)_WindowDimsChunksPacked.x * (int)_WindowDimsChunksPacked.y);
    return (chunkSlot * 4096) + LocalBrickIndex(brickCoord & 15);
}

/// Fires one shadow ray. `softEnabled` turns C.10's near-miss tracking on;
/// with it off this is pure binary occlusion, which is §6.5's rung 2.
ShadowHit TraceShadowRay(int3 hitVoxel, int3 hitNormal, float3 sunDir,
                         uint3 windowDimsBricks, bool softEnabled, bool dbg)
{
    ShadowHit r;
    r.sunVis = 1.0;
    r.steps = 0;

    // ---- §6.5's ORIGIN RULE. One cell off the hit face, at its centre. ----
    // There is no bias term here and there must never be one: §13's failure
    // signature for acne and Peter-Panning is "shadow-ray origin isn't starting
    // one cell off the hit face; FIX THE ORIGIN, DON'T ADD A BIAS HACK."
    int3 voxel = hitVoxel + hitNormal;
    float3 rayStart = (float3)voxel + 0.5;

    float3 dir = normalize(sunDir);
    dir.x = abs(dir.x) < 1e-6 ? (dir.x >= 0 ? 1e-6 : -1e-6) : dir.x;
    dir.y = abs(dir.y) < 1e-6 ? (dir.y >= 0 ? 1e-6 : -1e-6) : dir.y;
    dir.z = abs(dir.z) < 1e-6 ? (dir.z >= 0 ? 1e-6 : -1e-6) : dir.z;

    int3 step = int3(sign(dir.x), sign(dir.y), sign(dir.z));
    float3 tDelta = abs(1.0 / dir);
    float3 tMax = float3(
        step.x > 0 ? (voxel.x + 1.0 - rayStart.x) : (rayStart.x - voxel.x),
        step.y > 0 ? (voxel.y + 1.0 - rayStart.y) : (rayStart.y - voxel.y),
        step.z > 0 ? (voxel.z + 1.0 - rayStart.z) : (rayStart.z - voxel.z)
    ) * tDelta;

    float currentDist = 0.0;

    // §6.5: "clamps at max distance (island diagonal)". The SAME clamp the
    // primary ray uses, which under the cascade is tier 2's outer bound. That
    // is the effective island diagonal in this build: the renderer draws 290 m,
    // the resident window is 409.6 m across, and nothing exists past it -- so a
    // literal ~2,700 m island diagonal would only buy thousands of voxels of
    // guaranteed-nothing before the window guard stopped the ray anyway. This
    // is NOT an implementation of Amendment 8.11 (DRAFT, NOT ADOPTED); it
    // follows _MaxRayDistance, so if render range ever grows this follows.
    float maxDist = (_MaxRayDistance > 0.0) ? _MaxRayDistance : 1280.0;

    float m = 3.0e30;                 // C.10's minimum clearance/travel ratio
    float3 camVox = _CameraPos * 10.0;

    int3 nrm = int3(0, 0, 0);         // the leap helpers want these; unused here
    int exitIters = 0, nonExitIters = 0;

    [loop]
    while (currentDist < maxDist && r.steps < _MaxShadowSteps)
    {
        // Content-ceiling early exit. Same structural fact the primary ray
        // uses: above the highest chunk layer generation can produce, and
        // moving further away, every remaining voxel is guaranteed unloaded.
        // For a shadow ray aimed at the sun this fires almost immediately on
        // open ground, which is most of why an unshadowed pixel is cheap.
        if ((voxel.y >= _ContentCeilingVoxelY && step.y > 0) || (voxel.y < 0 && step.y < 0)) break;

        {
            int3 rel = VoxelToBrick(voxel) - _WindowOriginBricksPacked.xyz;
            if (rel.x < 0 || rel.y < 0 || rel.z < 0 ||
                rel.x >= (int)windowDimsBricks.x ||
                rel.y >= (int)windowDimsBricks.y ||
                rel.z >= (int)windowDimsBricks.z) break;
        }

        r.steps++;

        // ---- §10.4 PER-SUBSYSTEM DIAGNOSTIC DUMP ----
        // "Raymarcher: if a single ray's step count exceeds a threshold (e.g.
        //  >1000), log its origin, direction, and LAST ~10 CLIPMAP INDICES
        //  TRAVERSED." This is the shadow ray's form of that, the same shape as
        //  the existing raymarcher dump: a ring buffer in DebugOut that
        //  ShadowRayDump reads back and writes to a file when the threshold is
        //  crossed.
        //
        // COST, STATED RATHER THAN HIDDEN. `dbg` is uniform per thread and true
        // for exactly one thread in the dispatch, so 2,073,599 of 2,073,600
        // pixels pay one predicated compare per outer iteration and no store.
        // That is the same class of diagnostic branch Amendment 8.10 §5.3
        // measured (all diagnostics together, ~12%) and explicitly recommended
        // continuing to pay -- and Stage 6 measures the SHIPPED binary with it
        // compiled in, so the reported number includes it rather than excluding
        // it and being quietly optimistic.
        if (dbg)
        {
            int slot = (r.steps - 1) % SHADOW_DUMP_RING;
            DebugOut[SHADOW_DUMP_BASE + slot] = (float)ShadowClipmapFlatIndex(voxel, windowDimsBricks);
        }

        // ---- §6.5's 8.2 LOD RULE ----
        // By CAMERA distance to THIS sample point. Passing `currentDist` here
        // would be the retracted 8.1 rule and would produce detached shadows;
        // SelectLODTier's parameter is named so this line has to say which
        // distance it means.
        float3 sampleVox = (float3)voxel + 0.5;
        int tier = SelectLODTier(length(sampleVox - camVox));

        if (tier == 0)
        {
            // Air-mip leaps, exactly as the primary tier-0 path does them.
            // PHASE_3_COMPLETION.md §5 measured the air-mip as the highest-value
            // structure in the traversal (disabling it costs 44% at one pose,
            // 3.5x at another), and a sun-facing shadow ray is mostly empty sky,
            // which is precisely what it accelerates.
            bool leapt = false;
            [loop]
            for (int k = (int)_AirMipLevelCount; k >= 1; k--)
            {
                int shift = 3 + k;
                int3 cell = voxel >> shift;
                if (ReadAirMip(k, cell) == 0u)
                {
                    LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart,
                                             cell << shift, 8 << k, nrm, exitIters, nonExitIters);
                    leapt = true;
                    break;
                }
            }
            if (leapt) continue;

            int3 brickCoord = VoxelToBrick(voxel);
            uint handle = ReadClipmap(brickCoord, windowDimsBricks);

            if ((handle & 0x80000000) != 0)
            {
                uint poolIdx = handle & 0x3FFFFFFF;
                uint vIdx = (uint)LocalVoxelIndex(LocalVoxelIndex3D(voxel));
                uint packed = BrickDataBuffer[(poolIdx * 128) + (vIdx >> 2)];
                uint mat = (packed >> ((vIdx & 3u) * 8u)) & 0xFF;

                // OCCLUSION ONLY. §6.5: "first hit = done." The material is
                // deliberately not recorded -- nothing downstream may branch on
                // WHAT cast a shadow, only that something did.
                if (mat != 0) { r.sunVis = 0.0; return r; }

                // ---- C.10, tracked on the DENSE path only ----
                // A BOUNDED, STATED APPROXIMATION, not an oversight. Scanning
                // six neighbours at every outer iteration would pay for it on
                // air-brick leaps too, where by definition there is no solid
                // within the brick being leapt. Restricting it to dense bricks
                // puts the cost exactly where near-misses can occur and keeps
                // the reads inside the 512-byte body the step just touched.
                // WHAT IT MISSES: a ray skimming a wall built of UNIFORM-solid
                // bricks while travelling through uniform-air bricks gets a hard
                // edge rather than a penumbra, because neither brick is ever
                // micro-stepped. ShadowRayReference (the CPU oracle) scans every
                // cell and is the reference definition; the two agree exactly on
                // OCCLUSION, which is the binary the oracle property is about,
                // and the shader's sunVis is an approximation of the oracle's.
                // Recorded in PHASE_7_COMPLETION.md rather than left implicit.
                if (softEnabled)
                {
                    float3 posVox = rayStart + dir * currentDist;
                    float c = ShadowClearance(voxel, posVox, dir, tier, windowDimsBricks);
                    if (c < 3.0e30) m = min(m, c / max(1.0, currentDist));
                }

                if (tMax.x < tMax.y)
                {
                    if (tMax.x < tMax.z) { voxel.x += step.x; currentDist = tMax.x; tMax.x += tDelta.x; }
                    else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; }
                }
                else
                {
                    if (tMax.y < tMax.z) { voxel.y += step.y; currentDist = tMax.y; tMax.y += tDelta.y; }
                    else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; }
                }
                continue;
            }

            uint umat = handle & 0xFF;
            if (umat != 0) { r.sunVis = 0.0; return r; }

            LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart,
                                     brickCoord * 8, 8, nrm, exitIters, nonExitIters);
        }
        else
        {
            // Tiers 1/2, mirroring the primary coarse path. NOTE, and it is a
            // real gap rather than a claim: this branch has NO CPU oracle, for
            // shadow rays exactly as for primary rays (Amendment 8.10 §5.7,
            // PHASE_2_COMPLETION.md §6.2). Every statement about it is "this
            // reuses an already-proven primitive with different arguments",
            // which is real evidence and categorically weaker than a fuzz proof.
            int tierShift = TierShift(tier);
            int3 tierVoxel = voxel >> tierShift;
            int3 tierBrick = tierVoxel >> 3;

            uint handle = ReadClipmapTier(tier, tierBrick);
            if ((handle & 0x80000000) != 0)
            {
                uint poolIdx = handle & 0x3FFFFFFF;
                uint vIdx = (uint)LocalVoxelIndex(tierVoxel & 7);
                uint packed = ReadBrickDataTier(tier, poolIdx, vIdx >> 2);
                uint mat = (packed >> ((vIdx & 3u) * 8u)) & 0xFF;
                if (mat != 0) { r.sunVis = 0.0; return r; }

                LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart,
                                         tierVoxel << tierShift, 1 << tierShift,
                                         nrm, exitIters, nonExitIters);
                continue;
            }

            uint umat = handle & 0xFF;
            if (umat != 0) { r.sunVis = 0.0; return r; }

            LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart,
                                     (tierBrick * 8) << tierShift, 8 << tierShift,
                                     nrm, exitIters, nonExitIters);
        }
    }

    // Missed. C.10: sunVis = smoothstep(0, k_soft, m) on a miss.
    // k_soft <= 0 is §6.5's hard-shadow toggle and is a BRANCH, not a limit --
    // smoothstep with a zero-width edge is undefined and a NaN here would black
    // out every lit pixel in the frame.
    if (softEnabled && _KSoft > 0.0 && m < 3.0e30) r.sunVis = smoothstep(0.0, _KSoft, m);
    else                                           r.sunVis = 1.0;

    if (dbg)
    {
        DebugOut[21] = (float)voxel.x;      // where the ray ended up
        DebugOut[22] = (float)voxel.y;
        DebugOut[23] = (float)voxel.z;
        DebugOut[32] = (m < 3.0e30) ? m : -1.0;   // C.10's m, -1 = no near miss
    }
    return r;
}

// ===========================================================================
// C.11 -- POINT LIGHTS
//
// §6.5: "On a surface hit the raymarcher sums attenuated contributions from
// lights within range (atten = 1/(1 + d^2 k), C.11). No propagation, no BFS, no
// per-brick storage -- LIGHT DOES NOT BEND AROUND CORNERS IN v1 (a torch behind
// a wall does not light the far side)."
//
// IMPLEMENTED LITERALLY, INCLUDING THE CONSEQUENCE. There is no occlusion ray
// per light here, because §3.8's whole cost model (2M pixels x N lights)
// assumes there is not one. With no occlusion test, a torch behind a wall
// LIGHTS THE FAR SIDE -- which is leaking, not bending, and is in tension with
// §13's acceptance wording. The literal reading is what ships; the consequence
// is screenshotted; the ambiguity and the cost of the alternative are flagged
// in PHASE_7_COMPLETION.md for the owner. No per-light shadow rays were added.
//
// The loop is bounded by _ActiveLightCount, which the CPU caps at
// MAX_ACTIVE_LIGHTS -- that cap is the entire defence against §3.8's
// "per-pixel light death spiral", so the bound is load-bearing, not hygiene.
// ===========================================================================
float3 SumPointLights(float3 posM, float3 nrmF)
{
    float3 sum = float3(0.0, 0.0, 0.0);
    [loop]
    for (uint i = 0u; i < _ActiveLightCount; i++)
    {
        LightSource L = LightBuffer[i];
        float3 d = float3(L.x, L.y, L.z) - posM;
        float dist2 = dot(d, d);

        // The hard cutoff at `range` is what keeps the per-pixel cost bounded
        // in a way the 1/(1+d^2 k) falloff alone would not -- attenuation never
        // reaches zero, so without it every light would touch every pixel.
        if (dist2 > L.range * L.range) continue;

        float atten = 1.0 / (1.0 + dist2 * L.k);

        // C.9 attaches max(0, N.L) to the SUN term only and leaves pointLights
        // bare, so the literal default is 0. See the FLAG: the literal reading
        // lights faces pointing away from a torch, which reads flat.
        if (_PointLightNdotL != 0)
            atten *= max(0.0, dot(nrmF, normalize(d + 1e-6)));

        sum += float3(L.r, L.g, L.b) * atten;
    }
    return sum;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint3 _WindowDimsBricks = _WindowDimsBricksPacked.xyz;
    int _DebugMode = _DebugModePacked.x;

    uint width, height;
    ResultTexture.GetDimensions(width, height);
    if (id.x >= width || id.y >= height) return;

    bool isDebugPixel = (id.x == _DebugPixel.x && id.y == _DebugPixel.y);

    float2 uv = float2((id.x + 0.5) / width, (id.y + 0.5) / height) * 2.0 - 1.0;
    float4 target = mul(_CameraInverseProjection, float4(uv.x, uv.y, 1, 1));
    float3 rayDir = mul(_CameraInverseView, float4(normalize(target.xyz / target.w), 0)).xyz;

    rayDir.x = abs(rayDir.x) < 1e-6 ? (rayDir.x >= 0 ? 1e-6 : -1e-6) : rayDir.x;
    rayDir.y = abs(rayDir.y) < 1e-6 ? (rayDir.y >= 0 ? 1e-6 : -1e-6) : rayDir.y;
    rayDir.z = abs(rayDir.z) < 1e-6 ? (rayDir.z >= 0 ? 1e-6 : -1e-6) : rayDir.z;

    float3 rayStart = _CameraPos * 10.0;

    int3 step = int3(sign(rayDir.x), sign(rayDir.y), sign(rayDir.z));
    float3 tDelta = abs(1.0 / rayDir);

    int3 voxel = WorldToVoxel(_CameraPos);

    float3 tMax = float3(
        step.x > 0 ? (voxel.x + 1.0 - rayStart.x) : (rayStart.x - voxel.x),
        step.y > 0 ? (voxel.y + 1.0 - rayStart.y) : (rayStart.y - voxel.y),
        step.z > 0 ? (voxel.z + 1.0 - rayStart.z) : (rayStart.z - voxel.z)
    ) * tDelta;

    float currentDist = 0;
    int steps = 0;
    bool hit = false;
    uint mat = 0;
    int3 normal = 0;
    bool lastWasDense = false;
    int tierAtHit = 0;

    int exitIters = 0;
    int nonExitIters = 0;
    int chainLeapsTotal = 0;
    int denseMicroSteps = 0;
    int mipProbeCalls = 0;

    if (isDebugPixel)
    {
        DebugOut[0] = rayDir.x; DebugOut[1] = rayDir.y; DebugOut[2] = rayDir.z;
        DebugOut[3] = tDelta.x; DebugOut[4] = tDelta.y; DebugOut[5] = tDelta.z;
    }

    // With cascade OFF (default), _TierOuterRangeVoxels is irrelevant and
    // maxDist behaves exactly as before. With cascade ON, RaymarchFeature
    // sets _MaxRayDistance to _TierOuterRangeVoxels.z itself (the tier-2
    // outer bound), so this line doesn't need its own branch - it already
    // picks up the cascade's true travel limit via the same field.
    float maxDist = (_MaxRayDistance > 0.0) ? _MaxRayDistance : 1280.0;
    int _iterCap = (_MaxOuterIterations > 0) ? _MaxOuterIterations : 400;

    while (currentDist < maxDist && steps < _iterCap)
    {
        // EARLY-EXIT (new, added after real diagnostic data - see chat).
        // Phase2Bootstrapper only EVER generates chunks at cy=0 (world Y in
        // [0, 12.8m) = raw voxel Y in [0, 128)). If the ray is already
        // outside that range and moving FURTHER away (not toward it), every
        // remaining voxel it could ever reach is guaranteed unloaded -
        // ChunkStore.GetVoxel treats a null chunk as air unconditionally.
        // This is not a probabilistic/height-derived bound (which would risk
        // being wrong the way guessed constants have been elsewhere this
        // session) - it's the hard, structural fact of what chunks could
        // possibly exist, so this can never skip a real hit, only a
        // guaranteed miss. StepHeat/LODTierView/UniformDenseView at
        // GroundHorizon showed the cascade's actual dominant added cost is
        // exactly this case: no-hit sky rays now walking to the tier-2 outer
        // bound (290m) instead of the old 128m constant, with nothing to
        // make that walk cheap. This fixes the ROOT case, tier-independent -
        // it fires before tier selection even runs, so it benefits cascade
        // on AND off alike (proportionally far more when cascade is on,
        // given the much longer old maxDist).
        // ASSUMPTION, FLAGGED: breaks if Phase2Bootstrapper ever generates
        // more than cy=0 - the 128 below would need to become the true
        // loaded ceiling instead of this one hardcoded layer's height.
                // ---- CONTENT-CEILING EARLY EXIT (Phase 3, now config-driven) ----
        // Unchanged in behaviour; the hardcoded 128 is now _ContentCeilingVoxelY,
        // set from (MAX_GENERATED_CHUNK_Y+1)*128. Its own Phase 3 comment
        // flagged the constant as an assumption that breaks the moment anything
        // outside cy=0 generates. It stays SEPARATE from, and tighter than, the
        // window bounds test below -- see _ContentCeilingVoxelY's declaration.
        if ((voxel.y >= _ContentCeilingVoxelY && step.y > 0) || (voxel.y < 0 && step.y < 0))
        {
            hit = false;
            break;
        }

        // ---- RESIDENT WINDOW BOUNDS (Phase 4: origin-relative, 3 axes) ----
        // ReadClipmap/ReadClipmapTier mask toroidally with no bounds check, so
        // anything outside the window aliases silently back inside -- the
        // phantom-terrain bug of PHASE_3_COMPLETION.md §6.2. Leaving the window
        // means "no data", which must TERMINATE the ray, never alias into it.
        //
        // ONE guard covers all three tiers. Tiers 1 and 2 cover the same
        // spatial volume as tier 0, sampled coarser, so a voxel inside the
        // tier-0 window is inside theirs by construction. No per-tier origin
        // uniforms are needed and there is deliberately only one bounds site.
        //
        // Placement matters: this must stay the FIRST thing in the loop body,
        // ahead of every clipmap and air-mip read. The tier-1/2 chain loop
        // further down re-reads ReadClipmapTier up to MAX_CHAIN_LEAPS times
        // without re-testing bounds; that is safe ONLY because every exit from
        // that loop returns here before anything is drawn, and because the loop
        // breaks on both dense and uniform-solid handles without setting `hit`.
        {
            int3 rel = VoxelToBrick(voxel) - _WindowOriginBricksPacked.xyz;
            if (rel.x < 0 || rel.y < 0 || rel.z < 0 ||
                rel.x >= (int)_WindowDimsBricks.x ||
                rel.y >= (int)_WindowDimsBricks.y ||
                rel.z >= (int)_WindowDimsBricks.z)
            {
                hit = false;
                break;
            }
        }

        steps++;
        mipProbeCalls++;

        // Tier selection: 0 unless cascade is on AND currentDist has passed
        // that tier's own outer bound. Forced to 0 whenever _UseLODCascade==0,
        // so every line inside "if (tier == 0)" below is reached exactly as
        // it always was - this is the one and only new branch point tier-0
        // rays pass through, and it's a single cheap comparison.
        // NOTE THE ARGUMENT. For a PRIMARY ray, `currentDist` IS the distance
        // from the camera -- the ray started there. That equality is why the
        // old inline form was correct here and is NOT correct for a shadow ray,
        // which starts at a surface; see SelectLODTier's header. Behaviour at
        // this call site is unchanged, byte for byte.
        int tier = SelectLODTier(currentDist);

        if (tier == 0)
        {
            // ===================================================================
            // TIER 0 PATH - UNCHANGED from the pre-cascade file. Nothing in this
            // block was touched; it's reproduced verbatim so tier-0-only rays
            // (or any ray when _UseLODCascade==0) get byte-identical behavior.
            // ===================================================================
            bool leapt = false;
            [loop]
            for (int k = (int)_AirMipLevelCount; k >= 1; k--)
            {
                int shift = 3 + k;
                int3 cell = voxel >> shift;
                if (ReadAirMip(k, cell) == 0u)
                {
                    int spanVoxels = 8 << k;
                    int3 spanMin = cell << shift;

                    if (_TraversalMode == 0)
                        LeapSpan(voxel, tMax, currentDist, tDelta, step, spanMin, spanVoxels, normal, exitIters, nonExitIters);
                    else if (_TraversalMode == 3 || _TraversalMode == 4)
                        LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart, spanMin, spanVoxels, normal, exitIters, nonExitIters);
                    else
                        LeapSpanReseed(voxel, tMax, currentDist, tDelta, step, rayStart, spanMin, spanVoxels, normal, exitIters, nonExitIters);

                    if (_TraversalMode == 2)
                    {
                        int chainCount = 0;
                        [loop]
                        while (chainCount < MAX_CHAIN_LEAPS)
                        {
                            int3 newCell = voxel >> shift;
                            if (ReadAirMip(k, newCell) != 0u) break;

                            int3 newSpanMin = newCell << shift;
                            LeapSpanReseed(voxel, tMax, currentDist, tDelta, step, rayStart, newSpanMin, spanVoxels, normal, exitIters, nonExitIters);
                            chainCount++;
                            chainLeapsTotal++;
                        }
                    }

                    leapt = true;
                    break;
                }
            }
            if (leapt) continue;

            int3 brickCoord = VoxelToBrick(voxel);
            uint handle = ReadClipmap(brickCoord, _WindowDimsBricks);
            bool isDense = (handle & 0x80000000) != 0;

            if (isDense)
            {
                uint poolIdx = handle & 0x3FFFFFFF;

                if (_TraversalMode == 4)
                {
                    [loop]
                    while (currentDist < maxDist && steps < _iterCap)
                    {
                        int3 localVoxel = LocalVoxelIndex3D(voxel);
                        uint vIdx = (uint)LocalVoxelIndex(localVoxel);
                        uint packedData = BrickDataBuffer[(poolIdx * 128) + (vIdx >> 2)];
                        uint pShift = (vIdx & 3) * 8;
                        mat = (packedData >> pShift) & 0xFF;

                        if (mat != 0) { hit = true; lastWasDense = true; break; }

                        denseMicroSteps++;
                        steps++;

                        if (tMax.x < tMax.y)
                        {
                            if (tMax.x < tMax.z) { voxel.x += step.x; currentDist = tMax.x; tMax.x += tDelta.x; normal = int3(-step.x, 0, 0); }
                            else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; normal = int3(0, 0, -step.z); }
                        }
                        else
                        {
                            if (tMax.y < tMax.z) { voxel.y += step.y; currentDist = tMax.y; tMax.y += tDelta.y; normal = int3(0, -step.y, 0); }
                            else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; normal = int3(0, 0, -step.z); }
                        }

                        if (!all(VoxelToBrick(voxel) == brickCoord)) break;
                    }
                    if (hit) { tierAtHit = 0; break; }
                    continue;
                }

                int3 localVoxel2 = LocalVoxelIndex3D(voxel);
                uint vIdx2 = (uint)LocalVoxelIndex(localVoxel2);
                uint packedData2 = BrickDataBuffer[(poolIdx * 128) + (vIdx2 >> 2)];
                uint shift2 = (vIdx2 & 3) * 8;
                mat = (packedData2 >> shift2) & 0xFF;

                if (mat != 0) { hit = true; lastWasDense = true; tierAtHit = 0; break; }

                denseMicroSteps++;
                if (tMax.x < tMax.y)
                {
                    if (tMax.x < tMax.z) { voxel.x += step.x; currentDist = tMax.x; tMax.x += tDelta.x; normal = int3(-step.x, 0, 0); }
                    else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; normal = int3(0, 0, -step.z); }
                }
                else
                {
                    if (tMax.y < tMax.z) { voxel.y += step.y; currentDist = tMax.y; tMax.y += tDelta.y; normal = int3(0, -step.y, 0); }
                    else                 { voxel.z += step.z; currentDist = tMax.z; tMax.z += tDelta.z; normal = int3(0, 0, -step.z); }
                }
                continue;
            }

            mat = handle & 0xFF;
            if (mat != 0) { hit = true; lastWasDense = false; tierAtHit = 0; break; }

            {
                int3 bMin = brickCoord * 8;
                if (_TraversalMode == 0)
                    LeapSpan(voxel, tMax, currentDist, tDelta, step, bMin, 8, normal, exitIters, nonExitIters);
                else if (_TraversalMode == 3 || _TraversalMode == 4)
                    LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart, bMin, 8, normal, exitIters, nonExitIters);
                else
                    LeapSpanReseed(voxel, tMax, currentDist, tDelta, step, rayStart, bMin, 8, normal, exitIters, nonExitIters);
            }
        }
        else
        {
            // ===================================================================
            // TIER 1 / TIER 2 PATH - new. Only reached when _UseLODCascade!=0
            // AND currentDist has already passed tier 0's (and possibly tier
            // 1's) outer bound. No air-mip pyramid exists for these tiers yet
            // (deliberate scope cut for this pass - flagged in the file header
            // and in chat) - empty coarse bricks are skipped one brick at a
            // time via LeapSpanReseedClosedForm instead, same as tier 0's own
            // non-air-mip brick-skip fallback below.
            // ===================================================================
            int tierShift = TierShift(tier); // 1 for tier1, 2 for tier2

            int3 tierVoxel = voxel >> tierShift;
            int3 tierBrickCoord = tierVoxel >> 3;

            uint handle = ReadClipmapTier(tier, tierBrickCoord);
            bool isDense = (handle & 0x80000000) != 0;

            if (isDense)
            {
                uint poolIdx = handle & 0x3FFFFFFF;
                int3 localTierVoxel = tierVoxel & 7;
                uint vIdx = (uint)LocalVoxelIndex(localTierVoxel);
                uint packedData = ReadBrickDataTier(tier, poolIdx, vIdx >> 2);
                uint pShift = (vIdx & 3) * 8;
                mat = (packedData >> pShift) & 0xFF;

                if (mat != 0) { hit = true; lastWasDense = true; tierAtHit = tier; break; }

                // FIX (measured, not guessed): this used to single-step one RAW
                // voxel at a time even though a coarse voxel here spans `factor`
                // (1<<tierShift) raw voxels, all sharing this SAME sampled byte -
                // exactly the "up to 4 iterations, not 1" cost the file header
                // already predicted, now confirmed by a real benchmark (cascade
                // ON measured ~83% SLOWER than cascade OFF at the same pose -
                // see chat). Since every raw voxel within this one coarse voxel
                // is provably the same material (that's what "dense body, one
                // byte per coarse voxel" means), an air coarse voxel (mat==0,
                // this branch) can be leapt in full using the SAME proven
                // LeapSpanReseedClosedForm the empty-brick case below already
                // uses - just with a span of ONE coarse voxel (`factor` raw
                // voxels) instead of one whole brick (8 coarse voxels). No new
                // math, same reused primitive, smaller span.
                {
                    int3 coarseVoxelMinRaw = tierVoxel << tierShift;
                    int coarseVoxelSpanRaw = 1 << tierShift; // = factor: 2 (tier1) or 4 (tier2)
                    LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart, coarseVoxelMinRaw, coarseVoxelSpanRaw, normal, exitIters, nonExitIters);
                    denseMicroSteps++;
                }
                continue;
            }

            mat = handle & 0xFF;
            if (mat != 0) { hit = true; lastWasDense = false; tierAtHit = tier; break; }

            // Empty coarse brick: leap its full span using the SAME, UNCHANGED
            // LeapSpanReseedClosedForm tier-0 already uses - just with the span
            // converted back to raw voxel units (8 coarse voxels * factor raw
            // voxels each).
            {
                int3 bMinRaw = (tierBrickCoord * 8) << tierShift;
                int spanVoxelsRaw = 8 << tierShift;
                LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart, bMinRaw, spanVoxelsRaw, normal, exitIters, nonExitIters);

                // FIX (measured, not guessed - see chat): the prior fix to the
                // dense-voxel-stepping cost barely moved the cascade's overall
                // slowdown (+82.7% -> +77.9%), which means it wasn't the
                // dominant cost at this pose. This is: tiers 1/2 still have no
                // air-mip-equivalent pyramid, so a long empty run gets crossed
                // one brick at a time, each requiring the outer loop to fully
                // re-derive `tier` and re-probe from scratch. Chains ADDITIONAL
                // same-tier empty-brick leaps within this one outer iteration
                // instead - the exact same pattern tier 0's own _TraversalMode
                // == 2 chaining already uses above (MAX_CHAIN_LEAPS), applied
                // here for the first time. Every chained leap re-reads and
                // re-verifies the next brick's handle before leaping it - this
                // is not assuming consecutive bricks are empty, it's confirming
                // each one exactly as the single-leap path already did, just
                // without returning to the outer while loop between them.
                int tierChainCount = 0;
                [loop]
                while (tierChainCount < MAX_CHAIN_LEAPS)
                {
                    // Stop chaining the moment the ray leaves THIS tier's own
                    // distance range - let the outer loop's tier-selection
                    // logic run fresh rather than reading this tier's buffers
                    // past where they're valid.
                    bool stillInThisTier = (tier == 1)
                        ? (currentDist < _TierOuterRangeVoxels.y)
                        : (currentDist < _TierOuterRangeVoxels.z);
                    if (!stillInThisTier) break;

                    int3 nextTierVoxel = voxel >> tierShift;
                    int3 nextTierBrickCoord = nextTierVoxel >> 3;
                    uint nextHandle = ReadClipmapTier(tier, nextTierBrickCoord);

                    if ((nextHandle & 0x80000000) != 0) break; // dense - let the outer loop handle it
                    if ((nextHandle & 0xFF) != 0) break;        // uniform solid - let the outer loop resolve the hit

                    int3 nextBMinRaw = (nextTierBrickCoord * 8) << tierShift;
                    LeapSpanReseedClosedForm(voxel, tMax, currentDist, tDelta, step, rayStart, nextBMinRaw, spanVoxelsRaw, normal, exitIters, nonExitIters);
                    tierChainCount++;
                    chainLeapsTotal++;
                }
            }
        }
    }

    if (isDebugPixel)
    {
        DebugOut[7] = (float)steps;
        DebugOut[8] = (float)(exitIters + nonExitIters);
        DebugOut[9] = (float)exitIters;
        DebugOut[10] = (float)nonExitIters;
        DebugOut[11] = (float)_TraversalMode;
        DebugOut[12] = (float)chainLeapsTotal;
        DebugOut[13] = (float)denseMicroSteps;
        DebugOut[14] = (float)mipProbeCalls;
        DebugOut[15] = (float)_UsePackedMips;
        DebugOut[16] = maxDist;
        DebugOut[17] = (float)tierAtHit;
        DebugOut[18] = (float)_UseLODCascade;
        // NEW: currentDist at the point the loop exited (hit or maxDist),
        // in RAW VOXEL units (meters * 10) - same units as maxDist/tier
        // boundaries elsewhere in this file. Added specifically to answer
        // "how far away is the pixel that spiked in the diagnostic scan" -
        // see chat - without it, distance had to be estimated from camera
        // geometry instead of measured directly.
        DebugOut[19] = currentDist;
    }

    // =======================================================================
    // PHASE 7 -- THE FUSED SHADOW RAY, FIRED HERE (§6.5)
    //
    // §6.5: "in the same raymarch kernel, IMMEDIATELY AFTER a pixel's primary
    // ray resolves a hit, the thread fires one secondary DDA ray from the hit
    // voxel toward the sun." This is that point: traversal is done, `hit`,
    // `voxel` and `normal` are resolved, and no debug view has returned yet --
    // so the two new debug views below can show the shadow ray's own state.
    // =======================================================================

    float sunVis = 0.0;
    float skyVis = 1.0;
    int shadowSteps = 0;

    // §6.5's night rule and rung 3, evaluated once and shared by every branch
    // below so they cannot disagree. _SunColor is EXACTLY zero below the
    // horizon, which is the other half of the same guarantee.
    bool sunIsUp = (_SunDir.y > 0.0);
    bool shadowsOn = (_ShadowQualityLevel < 3);
    bool softShadows = (_ShadowQualityLevel <= 1) && (_KSoft > 0.0);

    // §6.5: "skips sky pixels (no primary hit => no shadow ray)".
    bool needsShadowRay = hit && sunIsUp && shadowsOn;

    // -----------------------------------------------------------------------
    // §6.5's 8.4 WAVE-UNIFORM BRANCH GUARD -- built in from the start.
    //
    // "GPU threads execute in lockstep groups (waves/warps); if even one lane
    //  in a wave needs a shadow ray, the whole wave pays for entering that
    //  divergent branch, even though only the needing lanes are unmasked. Guard
    //  the shadow branch with WaveActiveAnyTrue(hasPrimaryHit) so a wave that is
    //  ENTIRELY sky skips instantiating the shadow-ray code path altogether...
    //  worth building into Raymarch.compute FROM THE START rather than
    //  retrofitting after a Phase 7 budget miss."
    //
    // This is the literal instruction, taken literally. At the horizon poses
    // that dominate this project's cost (Amendment 8.9: GroundHorizon is the
    // most expensive pose in every config) a large fraction of waves are pure
    // sky, and those waves now skip the entire block rather than each of their
    // 32 lanes paying branch-entry cost for nothing.
    // -----------------------------------------------------------------------
    if (WaveActiveAnyTrue(needsShadowRay))
    {
        // §6.5 rung 1: "shadow rays beyond LOD1 drop to half resolution with
        // NEIGHBOUR REUSE (near shadows, the ones by the player, untouched)."
        //
        // Implemented as 2x2 quad reuse: one lane of each quad traces and the
        // other three read its result. QuadReadLaneAt is the primitive designed
        // for exactly this, and quads in a 2D compute dispatch are the 2x2
        // block of threads, so quad lane 0 is the even/even thread.
        //
        // THAT LANE MAPPING IS AN ASSUMPTION OF THE SM6.0 COMPUTE QUAD RULES
        // AND IS FLAGGED, NOT ASSERTED. If it is wrong on this driver the
        // symptom is distant shadows taking their value from the wrong
        // neighbour -- visible in the rig's own screenshots, not silent. It
        // affects rung 1 ONLY; rungs 0, 2 and 3 never execute this path.
        //
        // `quadComplete` keeps the quad ops away from partially-out-of-bounds
        // quads, where lanes have already returned and cross-lane reads are
        // undefined. Both shipped gate resolutions are even in both axes, so
        // every quad is entirely in or entirely out, but the guard costs two
        // comparisons and removes the question.
        bool distant = hit && (currentDist >= _TierOuterRangeVoxels.y);
        bool quadComplete = ((id.x | 1u) < width) && ((id.y | 1u) < height);
        bool reuse = (_ShadowQualityLevel == 1) && distant && quadComplete;
        bool isQuadLead = ((id.x & 1u) == 0u) && ((id.y & 1u) == 0u);

        // Every lane evaluates the trace condition the same way so the quad
        // read below is reached uniformly.
        bool traceMine = needsShadowRay && (!reuse || isQuadLead);

        ShadowHit sh;
        sh.sunVis = 1.0;
        sh.steps = 0;
        if (traceMine) sh = TraceShadowRay(voxel, normal, _SunDir, _WindowDimsBricks, softShadows, isDebugPixel);

        float mineVis = sh.sunVis;
        float leadVis = QuadReadLaneAt(mineVis, 0);
        sunVis = needsShadowRay ? (reuse ? leadVis : mineVis) : 0.0;
        shadowSteps = sh.steps;
    }

    // When shadows are OFF (rung 3), §6.5 says "sun becomes a flat N.L term
    // with ambient" -- i.e. full sun visibility everywhere, with the N.L in the
    // combine doing the shaping. Handled here rather than inside the guard so a
    // wave that skipped the block entirely still lands on the right value.
    if (hit && sunIsUp && !shadowsOn) sunVis = 1.0;

    // -----------------------------------------------------------------------
    // AMBIENT SKY VISIBILITY (§6.5's "underground reads near-zero ambient")
    //
    // FLAGGED, NOT DECIDED. §6.5 asks ambient to be three things at once: a
    // CHEAP HEMISPHERE TERM, the stand-in for BOUNCE INTO CAVE MOUTHS, and
    // near-zero DEEP UNDERGROUND. A plain normal-based hemisphere term cannot
    // be the third -- it lights a sealed cave ceiling exactly as brightly as
    // open sky, and "deep cave genuinely dark" is a §13 acceptance bullet.
    //
    // The cheapest thing that satisfies all three is a straight-up occlusion
    // probe, and it is deliberately THE SAME FUNCTION with its direction fixed
    // to +Y rather than a second traversal: it inherits the air-mip, the
    // content-ceiling exit and the window guard, and it has the same CPU oracle
    // (ShadowRayReference.Trace with dir = (0,1,0)). A vertical ray is also the
    // cheapest possible one -- axis-aligned, so every air-mip leap is maximal
    // and it exits at the content ceiling in a handful of iterations.
    //
    // IT IS STILL A SECOND RAY AND IS NOT CLAIMED TO BE FREE. It is behind its
    // own flag so Stage 6 measures it as its own arm, and the decision is the
    // owner's. See PHASE_7_COMPLETION.md's FLAG list.
    // -----------------------------------------------------------------------
    if (hit && _UseSkyProbeAmbient != 0)
    {
        if (WaveActiveAnyTrue(hit))
        {
            // `dbg` false: the sky probe must not overwrite the SUN ray's §10.4
            // ring buffer, or the dump would describe the wrong ray.
            ShadowHit sky = TraceShadowRay(voxel, normal, float3(0.0, 1.0, 0.0),
                                           _WindowDimsBricks, false, false);
            skyVis = sky.sunVis;
        }
    }

    // §10.4's scalar record for the shadow path, alongside the ring buffer the
    // trace filled. Written unconditionally for the debug pixel so a dump
    // describes a LIT ray as readily as an occluded one -- "why is this pixel
    // lit when it should be shadowed" is the question this answers most often.
    if (isDebugPixel)
    {
        DebugOut[20] = (float)shadowSteps;
        DebugOut[24] = _SunDir.x;        // direction the shadow ray travelled
        DebugOut[25] = _SunDir.y;
        DebugOut[26] = _SunDir.z;
        DebugOut[27] = (float)(voxel.x + normal.x);   // §6.5's origin, one cell off
        DebugOut[28] = (float)(voxel.y + normal.y);
        DebugOut[29] = (float)(voxel.z + normal.z);
        DebugOut[30] = sunVis;
        DebugOut[31] = skyVis;
        DebugOut[33] = (float)_ShadowQualityLevel;
        DebugOut[44] = (float)_ActiveLightCount;
        DebugOut[45] = hit ? 1.0 : 0.0;
    }

    if (_DebugMode == 1) { ResultTexture[id.xy] = StepHeatColor(steps); return; }
    if (_DebugMode == 2)
    {
        if (!hit) { ResultTexture[id.xy] = float4(0.05, 0.05, 0.1, 1.0); return; }
        ResultTexture[id.xy] = lastWasDense ? float4(0.9, 0.9, 0.2, 1.0) : float4(0.2, 0.2, 0.3, 1.0);
        return;
    }
    if (_DebugMode == 3)
    {
        if (!hit) { ResultTexture[id.xy] = float4(0.0, 0.0, 0.0, 1.0); return; }
        float3 n = (float3(normal) * 0.5) + 0.5;
        ResultTexture[id.xy] = float4(n, 1.0);
        return;
    }
    if (_DebugMode == 4) { ResultTexture[id.xy] = StepHeatColor(nonExitIters >> 3); return; }
    if (_DebugMode == 5)
    {
        if (!hit) { ResultTexture[id.xy] = float4(0.2, 0.4, 0.8, 1.0); return; }
        float ndotlV = max(0.25, dot(float3(normal), normalize(float3(0.5, 1.0, 0.2))));
        float baseV = (mat == 2) ? 0.60 : 0.50;
        float variation = (VoxelHash(voxel) - 0.5) * 0.28;
        float shadeV = saturate(baseV + variation) * ndotlV;
        ResultTexture[id.xy] = float4(shadeV, shadeV, shadeV, 1.0);
        return;
    }
    if (_DebugMode == 7)
    {
        // §10.3 item 6: SUN-VISIBILITY VIEW. Greyscale sunVis on hits; sky
        // pixels a flat dark blue so "no primary hit" is distinguishable from
        // "fully shadowed", which a plain greyscale ramp would conflate -- and
        // telling those two apart is exactly what you need this view for.
        if (!hit) { ResultTexture[id.xy] = float4(0.05, 0.08, 0.16, 1.0); return; }
        if (!sunIsUp) { ResultTexture[id.xy] = float4(0.10, 0.02, 0.16, 1.0); return; }  // night: violet
        ResultTexture[id.xy] = float4(sunVis, sunVis, sunVis, 1.0);
        return;
    }
    if (_DebugMode == 8)
    {
        // §10.3 item 6: SHADOW-RAY STEP-COUNT HEAT. Same StepHeatColor ramp the
        // primary heat view uses, so the two are directly comparable by eye --
        // the question this view exists to answer is "does a shadow ray cost
        // the same as the primary ray that spawned it", and two different
        // colour ramps would make that unanswerable.
        if (!hit) { ResultTexture[id.xy] = float4(0.02, 0.02, 0.04, 1.0); return; }
        ResultTexture[id.xy] = StepHeatColor(shadowSteps);
        return;
    }
    if (_DebugMode == 6)
    {
        // LOD tier visualization: NEW. Not hit -> background. Tier 0 -> blue,
        // tier 1 -> green, tier 2 -> red. Purely diagnostic - lets a human
        // eyeball whether tier boundaries land where expected and whether the
        // 0->1->2 transitions are visually reasonable, BEFORE trusting this
        // path for a benchmark run. This is the capture to send back first.
        if (!hit) { ResultTexture[id.xy] = float4(0.05, 0.05, 0.05, 1.0); return; }
        float4 tierColor = float4(0.1, 0.3, 0.9, 1.0); // tier 0 = blue
        if (tierAtHit == 1) tierColor = float4(0.15, 0.85, 0.2, 1.0); // tier 1 = green
        if (tierAtHit == 2) tierColor = float4(0.9, 0.15, 0.15, 1.0); // tier 2 = red
        ResultTexture[id.xy] = tierColor;
        return;
    }

    float4 color = _SkyColor;
    if (hit)
    {
        float ndotl = max(0.2, dot(float3(normal), normalize(float3(0.5, 1.0, 0.2))));
        if (_UseDevColors != 0)
        {
            // NEW: developer material colors + per-voxel grain. Not final art -
            // a cheap, explicitly-flagged debug palette so individual voxels
            // are distinguishable at 960x540, which flat single-shade gray
            // wasn't. Reuses VoxelHash (already existed, was previously only
            // wired into DebugMode 5/VoxelGrain) as the per-voxel noise source -
            // same idea the person asked for ("take the voxel position, apply
            // noise, shift the color slightly"), just extended from grayscale-
            // only to also picking a base hue per material id.
            // ---- AUTHORED PALETTE + CHEAP FAKE SHADING (presentation only) ----
            // Runs after traversal has resolved `voxel`, `normal` and
            // `currentDist`. Reads nothing the DDA writes and writes nothing the
            // DDA reads.
            float3 baseColor = MaterialAlbedo(mat);
            bool selfLit = MaterialIsSelfLit(mat);

            // Per-voxel grain, kept from the dev shading: without it, large flat
            // faces of one material read as untextured plastic. Halved from the
            // old +/-17.5%, because a real palette needs far less help than the
            // modulo one did.
            float grain = (VoxelHash(voxel) - 0.5) * 0.18;
            float3 shaded = saturate(baseColor * (1.0 + grain));

            // Hemisphere tint: up-facing faces catch the sky, down-facing faces
            // fall toward ground shadow. This single term does most of the work
            // that other voxel engines get from real lighting -- it is what makes
            // a horizontal surface read as horizontal.
            if (_ShadeHemi != 0 && !selfLit)
            {
                float upness = float(normal.y) * 0.5 + 0.5;      // 0 down, 0.5 side, 1 up
                float hemi = lerp(0.62, 1.12, upness);
                shaded *= hemi;
                shaded = lerp(shaded, shaded * (0.85 + 0.35 * _SkyColor.rgb), upness * 0.35);
            }

            // Ambient occlusion from neighbour occupancy.
            if (_ShadeAO != 0 && !selfLit)
            {
                float3 hitP = rayStart + rayDir * currentDist;
                float3 inVoxel = hitP - (float3(voxel) + 0.5);   // [-0.5, 0.5] per axis
                float ao = FaceAO(voxel, normal, inVoxel, _WindowDimsBricks);
                shaded *= lerp(0.55, 1.0, ao);
            }

            // ===============================================================
            // C.9 -- THE FINAL COMBINE
            //
            //   color = albedo x (sunColor . sunVis . max(0, N.L)
            //                     + pointLights + ambientSky) + emissive,
            //   then VAO.
            //
            // Written in that order, term for term, so it is checkable against
            // the spec line rather than merely "a lighting model".
            //
            // WHERE VAO IS. C.9 says "then VAO", and the VAO term is the
            // FaceAO() corner-darkening already applied above. Stage 0 recorded
            // its provenance honestly: the literal token "VAO" appears nowhere
            // in this project, and FaceAO arrived in a later presentation pass
            // rather than as §13 Phase 2's file-4 build step, which
            // PHASE_2_COMPLETION.md never ticked. It IS voxel ambient occlusion
            // -- four corners, two edge neighbours and a diagonal each,
            // bilinearly interpolated across the face -- so it is used as C.9's
            // VAO rather than a new one being invented. Flagged, not assumed.
            //
            // WHAT THE OLD SHADING TERMS BECOME. The hemisphere tint and the
            // softened lerp(0.80, 1.0, ndotl) above were a stand-in for
            // lighting that did not exist yet, and RaymarchFeature's own
            // comment says the flags exist "precisely so Phase 7's real
            // lighting (§6.5) can disable any of them without unpicking
            // anything". They are now DEMOTED, not deleted: _ShadeHemi still
            // gates the hemisphere tint (it is C.9's ambientSky given a
            // direction, which is what makes a horizontal surface read as
            // horizontal), and the fake directional term is replaced outright
            // by the real sun term below. Turning the new lighting off restores
            // the old look exactly, which is what makes the A/B in Stage 6
            // meaningful.
            // ===============================================================
            float ndl = max(0.0, dot(float3(normal), normalize(_SunDir)));
            float3 sunTerm = _SunColor * sunVis * ndl;

            float3 hitPosM = (rayStart + rayDir * currentDist) * 0.1;
            float3 pointTerm = SumPointLights(hitPosM, float3(normal));

            // ambientSky, modulated by sky visibility so a sealed cave is dark
            // and a cave mouth is not (§6.5). With the probe off this collapses
            // to the plain ambient term.
            float ambientScale = lerp(_UndergroundAmbientFloor, 1.0, skyVis);
            float3 ambientTerm = _AmbientColor * ambientScale;

            // Self-lit materials (today: lava) keep the shading cheat that
            // predates Phase 7 AND now also carry a real emissive term. The
            // cheat skips AO and the hemisphere so they stay hot; the emissive
            // is what makes them light their surroundings via the §3.8 buffer.
            // PaletteSyncTests pins that lava is still the only self-lit
            // material, and a torch deliberately is NOT one -- it takes the
            // real emissive path instead, so it is not double-counted.
            if (selfLit) shaded = saturate(baseColor * 1.35 + 0.06);
            else         shaded = shaded * (sunTerm + pointTerm + ambientTerm);

            shaded += MaterialEmissiveTint(mat) * MaterialEmissive(mat);

            // Distance fog toward the sky colour. Depth cue only.
            if (_ShadeFog != 0)
            {
                float f = saturate((currentDist * 0.1 - _FogStartM) / max(0.001, _FogEndM - _FogStartM));
                shaded = lerp(shaded, _SkyColor.rgb, f * 0.85);
            }

            color = float4(saturate(shaded), 1.0);
        }
        else
        {
            // Original flat shading, preserved byte-for-byte behind the
            // toggle - _UseDevColors defaults ON, but flipping it off
            // reproduces every pre-existing Beauty screenshot exactly, for
            // any future A/B comparison that needs the old look specifically.
            color = float4(0.5 * ndotl, 0.5 * ndotl, 0.5 * ndotl, 1.0);
            if (mat == 2) color = float4(0.6 * ndotl, 0.6 * ndotl, 0.6 * ndotl, 1.0);
        }
    }
    ResultTexture[id.xy] = color;
}

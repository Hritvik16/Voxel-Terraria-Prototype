+        /// Task 87 (8.14 row 11, Q4 (a)): does any resident tile lie in this
+        /// 0.1 m chunk? With AwakeOnly, a resident tile is awake fluid, and the
+        /// streamer keeps its chunk resident outside the load radius
+        /// (StreamManager.KeepResident). A chunk is (CHUNK_EDGE / TileEdge)^3 tiles.
+        public bool HoldsTileInChunk(int3 chunkCoord)
+        {
+            if (ResidentTiles == 0) return false;
+            int n = EngineConfig.CHUNK_EDGE_VOXELS >> TileShift;
+            int3 t0 = chunkCoord * n;
+            for (int z = 0; z < n; z++)
+            for (int y = 0; y < n; y++)
+            for (int x = 0; x < n; x++)
+                if (TryGetSlot(t0 + new int3(x, y, z)) != NO_TILE) return true;
+            return false;
+        }
+

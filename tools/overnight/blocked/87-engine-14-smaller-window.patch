+    /// Task 87 (8.14 rows 6-7): with shells on, High's 0.1 m window loads 7
+    /// chunks, not 10. A chunk 9 out (inside the old window, outside the new) is
+    /// not resident, so SetVoxel cannot reach it; IEditOps.Record logs the op,
+    /// and the chunk shows it when the camera brings it in.
+    [Test]
+    public void StreamManager_FarOp_BeyondTheSmallWindow_ShowsWhenTheChunkLoads()
+    {
+        int load = ShellLayout.From(QualityPreset.High).LoadRadiusChunks;
+        Assert.Less(load + 2, EngineConfig.TG2_LOAD_RADIUS_CHUNKS + 1, "the site must lie inside the old 128 m window");
+        int3 camChunk = new int3((int)(CAM.x * 10) >> 7, 0, (int)(CAM.z * 10) >> 7);
+        int3 c = camChunk + new int3(load + 2, 0, 0);
+        Vector3 over = new Vector3(c.x * 12.8f + 6.4f, CAM.y, c.z * 12.8f + 6.4f);
+        string dirR = TempDir("swref"), dirF = TempDir("swfar");
+        try
+        {
+            byte[] reference; int3 centre = default; bool found = false;
+            using (var w = new World(dirR))
+            {
+                w.Go(over);
+                int3 v0 = c << 7;
+                for (int y = 115; y >= 12 && !found; y--)
+                    if (w.store.GetVoxel(v0 + new int3(64, y, 64)) != Materials.Air &&
+                        w.store.GetVoxel(v0 + new int3(64, y + 1, 64)) == Materials.Air)
+                    { centre = v0 + new int3(64, y, 64); found = true; }
+                Assert.IsTrue(found, $"no surface site in {c}");
+                reference = w.Content(c);
+            }
+            var op = new EditOp(EditOpKind.Sphere, centre, 10, Materials.Air);
+            using (var w = new World(dirF, load))
+            {
+                w.Go(CAM);
+                Assert.IsFalse(w.store.IsResident(c), $"{c} is {load + 2} chunks out: outside the {load}-chunk window");
+                Assert.IsFalse(w.edits.TrySetVoxel(centre, Materials.Stone), "SetVoxel is refused outside loaded chunks (frozen)");
+                w.ops.Record(op);
+                Assert.AreEqual(0, w.ops.NearVoxelsWritten, "nothing resident there: the op is only logged");
+                w.Go(over);
+                byte[] want = WithOps(reference, c, op);
+                Assert.AreNotEqual(0, Diff(reference, want, out _), "test setup: the op must change the chunk");
+                int bad = Diff(want, w.Content(c), out string first);
+                Assert.AreEqual(0, bad, $"the far op is missing from the loaded chunk in {bad} voxels, first {first}");
+            }
+        }
+        finally { Directory.Delete(dirR, true); Directory.Delete(dirF, true); }
+    }
+

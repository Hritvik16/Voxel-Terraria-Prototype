+        /// Task 170: grows a tables / data buffer to the CPU list's capacity (GrowCap: need + 1/8, not a power of two)
+        /// and, unless the buffer is re-uploaded whole anyway (`full`), copies the old contents on the GPU, so the
+        /// step uploads only the dirty runs. Without the copy kernel, falls back to a whole upload.
+        private GraphicsBuffer GrowGpu(GraphicsBuffer b, int need, int cap, ref bool full)
+        {
+            need = math.max(need, 1);
+            if (b != null && b.count >= need) return b;
+            var n = new GraphicsBuffer(GraphicsBuffer.Target.Structured, math.max(need, cap), 4);
+            if (b != null && !full)
+            {
+                if (_copyK < 0)
+                {
+                    _copyCs = Resources.Load<ComputeShader>("TorchFloodProbe");
+                    _copyK = _copyCs != null ? _copyCs.FindKernel("CSFloodCopy") : -2;
+                }
+                if (_copyK >= 0)
+                {
+                    int groups = math.min((b.count + 255) / 256, 4096);
+                    _copyCs.SetBuffer(_copyK, "_CopySrc", b);
+                    _copyCs.SetBuffer(_copyK, "_CopyDst", n);
+                    _copyCs.SetInt("_CopyCount", b.count);
+                    _copyCs.SetInt("_CopyStride", groups * 256);
+                    _copyCs.Dispatch(_copyK, groups, 1, 1);
+                    GpuGrowCopies++;
+                }
+                else full = true;
+            }
+            else full = true;
+            b?.Release();
+            return n;
+        }
